# Bundler
/.bundle
/vendor/bundle
/vendor/cache

# Ruby / Rails runtime
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
*.log
*.pid
*.pid.lock
.byebug_history
/coverage/
/spec/tmp

# Precompiled assets (generated by rake assets:precompile)
/public/assets
/public/packs
/public/packs-test
/node_modules
/yarn-error.log
/yarn-debug.log*
.yarn-integrity

# Secrets and local env
.env
.env.*
!.env.example
/config/master.key
/config/credentials/*.key
/config/database.yml

# Local / generated (do not commit)
.cursor/
.ruby-version
/db/schema.rb
/db/seeds.rb
/db/seeds_metals.rb
/Gemfile.lock

# Local dumps, archives, and accidental lockfile copies
*.tar
*.tar.gz
*.zip
*.sql
*.sqlite3
/db/*.sqlite3
/db/*.sqlite3-*
# Accidental extra Bundler lock copies
/Gemfile.lock *.lock

# OS / editor
.DS_Store
*.swp
*~
.idea/
*.iml

# Spring
/spring/*.pid
