<% content_for :title, 'Open a house · Strucxil' %>

<section class="auth-card is-wide" aria-labelledby="signup-heading">
  <header class="auth-header">
    <%= image_tag '/favicon.png', alt: 'Strucxil', class: 'brand-logo' %>
    <p>Strucxil</p>
    <h1 id="signup-heading">Open your store</h1>
    <p class="brand-sub">Create an account, then choose a yearly subscription</p>
  </header>

  <div class="auth-body">
    <nav class="auth-tabs" aria-label="Account">
      <%= link_to 'Sign in', new_user_session_path, data: { turbolinks: false } %>
      <%= link_to 'Open a house', new_user_registration_path, class: 'is-on', data: { turbolinks: false } %>
    </nav>

    <% if resource.errors.any? %>
      <div class="error-box"><%= resource.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="auth-row">
        <div class="form-group">
          <%= f.label :shop_name do %>Store name <span class="req">*</span><% end %>
          <%= f.text_field :shop_name, autofocus: true, required: true, placeholder: 'e.g. Meena Jewellers' %>
        </div>
        <div class="form-group">
          <%= f.label :full_name do %>Your name <span class="req">*</span><% end %>
          <%= f.text_field :full_name, required: true, placeholder: 'Owner / manager name' %>
        </div>
      </div>
      <div class="auth-row">
        <div class="form-group">
          <%= f.label :phone do %>Phone <span class="req">*</span><% end %>
          <div class="phone-field">
            <span class="phone-cc" aria-hidden="true">+91</span>
            <%= f.telephone_field :phone, required: true, value: resource.mobile_digits, inputmode: 'numeric', autocomplete: 'tel-national', maxlength: 10, pattern: '[0-9]{10}', placeholder: '10-digit mobile', class: 'js-in-mobile' %>
          </div>
        </div>
        <div class="form-group">
          <%= f.label :email do %>Email <span class="req">*</span><% end %>
          <%= f.email_field :email, required: true, autocomplete: 'email', placeholder: 'store@example.com' %>
        </div>
      </div>
      <div class="auth-row">
        <div class="form-group">
          <%= f.label :password do %>Password <span class="req">*</span><% end %>
          <%= f.password_field :password, required: true, minlength: 6, autocomplete: 'new-password', placeholder: 'At least 6 characters', class: 'js-secret' %>
        </div>
        <div class="form-group">
          <%= f.label :password_confirmation do %>Confirm password <span class="req">*</span><% end %>
          <%= f.password_field :password_confirmation, required: true, minlength: 6, autocomplete: 'new-password', class: 'js-secret' %>
        </div>
      </div>
      <div class="remember-row">
        <input type="checkbox" id="show-password" class="js-show-password">
        <label for="show-password">Show password</label>
      </div>
      <%= f.submit 'Continue to plans', class: 'btn-primary' %>
    <% end %>

    <div class="footer-note">
      Already registered? <%= link_to 'Sign in', new_user_session_path, data: { turbolinks: false } %>
    </div>
  </div>
</section>
