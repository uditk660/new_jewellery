<% content_for :title, 'Sign in · Strucxil' %>

<section class="auth-card" aria-labelledby="signin-heading">
  <header class="auth-header">
    <%= image_tag '/favicon.png', alt: 'Strucxil', class: 'brand-logo' %>
    <p>Strucxil</p>
    <h1 id="signin-heading">Jewellery login</h1>
    <p class="brand-sub">Sign in to your store dashboard</p>
  </header>

  <div class="auth-body">
    <nav class="auth-tabs" aria-label="Account">
      <%= link_to 'Sign in', new_user_session_path, class: 'is-on', data: { turbolinks: false } %>
      <%= link_to 'Open a house', new_user_registration_path, data: { turbolinks: false } %>
    </nav>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, 'Email' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'you@example.com' %>
      </div>
      <div class="form-group">
        <%= f.label :password, 'Password' %>
        <%= f.password_field :password, autocomplete: 'current-password', placeholder: 'Enter your password', class: 'js-secret' %>
      </div>
      <div class="remember-row">
        <input type="checkbox" id="show-password" class="js-show-password">
        <label for="show-password">Show password</label>
      </div>
      <% if devise_mapping.rememberable? %>
        <div class="remember-row">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, 'Remember me' %>
        </div>
      <% end %>
      <%= f.submit 'Sign in', class: 'btn-primary' %>
    <% end %>

    <div class="help-row">
      <a href="#" id="forgot-password-link">Forgot password?</a>
      <div id="forgot-password-tip" class="forgot-tip">Please contact your house administrator to reset your password.</div>
    </div>

    <div class="footer-note">
      New store? <%= link_to 'Create an account', new_user_registration_path, data: { turbolinks: false } %><br>
      <span style="display:inline-block;margin-top:8px;font-size:12px;">
        Staff? <%= link_to 'Employee portal', new_employee_session_path, data: { turbolinks: false } %>
      </span>
    </div>
  </div>
</section>

<script>
  (function(){
    var link = document.getElementById('forgot-password-link');
    var tip = document.getElementById('forgot-password-tip');
    if(!link || !tip) return;
    link.addEventListener('click', function(e){
      e.preventDefault();
      tip.style.display = (tip.style.display === 'block') ? 'none' : 'block';
    });
  })();
</script>
