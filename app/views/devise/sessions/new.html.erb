<main class="auth-viewport">
  <section class="auth-card" role="main" aria-labelledby="signin-heading">
    <header class="auth-header">
      <div class="brand-mark" aria-hidden="true">💎</div>
      <h1 id="signin-heading" class="brand-name">Jewellery Login</h1>
      <p class="brand-sub">Sign in to your store dashboard</p>
    </header>

    <div class="auth-body">
      <% if flash[:alert].present? %>
        <div class="error-box"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice].present? %>
        <div class="flash notice"><%= flash[:notice] %></div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-group">
          <%= f.label :email, 'Email' %>
          <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'you@example.com' %>
        </div>

        <div class="form-group">
          <%= f.label :password, 'Password' %>
          <%= f.password_field :password, autocomplete: 'current-password', placeholder: 'Enter your password' %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="remember-row">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, 'Remember me' %>
          </div>
        <% end %>

        <%= f.submit 'Sign in', class: 'btn-primary' %>
      <% end %>

      <div class="help-row">
        <a href="#" id="forgot-password-link">Forgot password?</a>
        <div id="forgot-password-tip" class="forgot-tip">Please contact your company administrator to reset your password.</div>
      </div>

      <div class="footer-note">
        New store? <%= link_to 'Create an account', new_user_registration_path %><br>
        <span style="display:inline-block;margin-top:8px;font-size:12px;">
          Staff? <%= link_to 'Employee portal', new_employee_session_path %>
        </span>
      </div>
    </div>
  </section>
</main>

<script>
  (function(){
    var link = document.getElementById('forgot-password-link');
    var tip = document.getElementById('forgot-password-tip');
    if(!link || !tip) return;
    link.addEventListener('click', function(e){
      e.preventDefault();
      tip.style.display = (tip.style.display === 'block') ? 'none' : 'block';
    });
  })();
</script>
