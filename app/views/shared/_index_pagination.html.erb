<%
  current_page = [local_assigns.fetch(:page).to_i, 1].max
  per_page = local_assigns.fetch(:per_page).to_i
  total_count = local_assigns.fetch(:total_count).to_i
  page_url = local_assigns.fetch(:url)
  last_page = index_page_count(total_count, per_page)
  note = local_assigns[:note]
%>
<% if total_count > per_page %>
  <nav class="index-pager" aria-label="Pagination">
    <% if current_page > 1 %>
      <%= link_to '« First', page_url.call(1), class: 'atelier-back index-pager-btn' %>
      <%= link_to '← Previous', page_url.call(current_page - 1), class: 'atelier-back index-pager-btn' %>
    <% else %>
      <span class="atelier-back index-pager-btn is-disabled" aria-disabled="true">« First</span>
      <span class="atelier-back index-pager-btn is-disabled" aria-disabled="true">← Previous</span>
    <% end %>

    <span class="index-pager-status">
      Page <%= current_page %> of <%= last_page %>
      <% if note.present? %><span class="index-pager-note"><%= note %></span><% end %>
    </span>

    <% if current_page < last_page %>
      <%= link_to 'Next →', page_url.call(current_page + 1), class: 'atelier-back index-pager-btn' %>
      <%= link_to 'Last »', page_url.call(last_page), class: 'atelier-back index-pager-btn' %>
    <% else %>
      <span class="atelier-back index-pager-btn is-disabled" aria-disabled="true">Next →</span>
      <span class="atelier-back index-pager-btn is-disabled" aria-disabled="true">Last »</span>
    <% end %>
  </nav>
<% end %>
