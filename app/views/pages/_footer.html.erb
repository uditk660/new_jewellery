<footer class="maison-footer">
  <div class="wrap footer-row">
    <div>
      <%= link_to root_path, class: 'maison-brand' do %>
        <%= image_tag '/favicon.png', alt: 'Strucxil', class: 'maison-logo', width: 36, height: 36 %>
        <span class="maison-brand-text">
          <strong>Strucxil</strong>
          <span class="maison-tagline">Gold · hallmark · light</span>
        </span>
      <% end %>
    </div>
    <div class="maison-actions">
      <%= link_to 'Collections', collections_path, class: 'btn-ghost' %>
      <%= link_to 'Write to us', contact_path, class: 'btn-gold' %>
    </div>
  </div>
  <p class="powered">Powered by <strong>Strucxil PVT LTD</strong></p>
</footer>
