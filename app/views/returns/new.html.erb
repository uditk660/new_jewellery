<%= render 'shared/atelier_styles' %>

<%
  form = @return_form
  customers = @customers || []
  items = @items || []
  orders = @orders || []
  order_choices = orders.map { |o|
    label = [o.invoice_number.presence || "Bill ##{o.id}", o.customer&.full_name].compact.join(' · ')
    [label, o.id]
  }
%>

<div class="atelier-page return-desk" id="return-desk" data-items="<%= h((@items_payload || []).to_json) %>">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">After sales</p>
      <h1>Record a return</h1>
      <p class="lead">Name the client and the piece coming back. Choose a cash refund or an exchange — tray stock updates when a catalogue piece is named.</p>
    </div>
    <%= link_to '← Returns', returns_path, class: 'atelier-back' %>
  </header>

  <div class="steps" aria-hidden="true">
    <span class="step"><b>1</b> Client &amp; bill</span>
    <span class="step"><b>2</b> Piece</span>
    <span class="step"><b>3</b> Settlement</span>
  </div>

  <%= form_for :return, url: returns_path, html: { id: 'return-form' } do |f| %>
    <div class="atelier-grid">
      <div class="atelier-form">
        <section class="section">
          <h2>Client &amp; original bill</h2>
          <p class="hint">Link the buyer and, if you have it, the tax invoice this piece left on.</p>
          <div class="row">
            <div class="field">
              <%= f.label :customer_id, 'Client' %>
              <%= f.collection_select :customer_id, customers, :id, :full_name, { include_blank: 'Walk-in', selected: form.customer_id }, { class: 'form-control', id: 'return_customer_id' } %>
            </div>
          </div>
          <div class="row walk-in-fields" id="walk-in-fields" style="margin-top:12px">
            <div class="field">
              <%= f.label :walk_in_name, 'Name' %>
              <%= f.text_field :walk_in_name, class: 'form-control', id: 'return_walk_in_name', placeholder: 'Client name', value: form.walk_in_name %>
            </div>
            <div class="field">
              <%= f.label :walk_in_phone, 'Mobile' %>
              <%= f.telephone_field :walk_in_phone, class: 'form-control', id: 'return_walk_in_phone', placeholder: '10-digit mobile', value: form.walk_in_phone, inputmode: 'numeric', maxlength: 15 %>
            </div>
          </div>
          <div class="row" style="margin-top:12px">
            <div class="field">
              <%= f.label :order_id, 'Original bill' %>
              <%= f.select :order_id, order_choices, { include_blank: 'No linked invoice', selected: form.order_id }, { class: 'form-control', id: 'return_order_id' } %>
            </div>
          </div>
        </section>

        <section class="section">
          <h2>Piece coming back</h2>
          <p class="hint">Choose the catalogue piece so hallmark weight and tray quantity can be restored.</p>
          <div class="row">
            <div class="field">
              <%= f.label :jewelry_item_id, 'Catalogue piece' %>
              <%= f.collection_select :jewelry_item_id, items, :id, :name, { include_blank: 'Select a piece', selected: form.jewelry_item_id }, { class: 'form-control', id: 'return_jewelry_item_id' } %>
            </div>
            <div class="field narrow">
              <%= f.label :quantity, 'Quantity (pcs)' %>
              <%= f.number_field :quantity, min: 1, value: form.quantity.presence || 1, class: 'form-control', id: 'return_quantity' %>
            </div>
          </div>
        </section>

        <section class="section">
          <h2>Settlement</h2>
          <p class="hint">Cash refund returns rupees. Exchange keeps the client on the book for another piece.</p>
          <div class="row">
            <div class="field">
              <%= f.label :action, 'How we settle' %>
              <%= f.select :action, [['Cash refund', 'cash'], ['Exchange for another piece', 'exchange']], { selected: form.action }, { class: 'form-control', id: 'return_action' } %>
            </div>
            <div class="field" id="amount-field">
              <%= f.label :amount, 'Refund amount (₹)' %>
              <%= f.text_field :amount, class: 'form-control', id: 'return_amount', placeholder: '0.00', value: form.amount %>
            </div>
          </div>
          <div class="row" style="margin-top:12px">
            <div class="field">
              <%= f.label :reason, 'Reason' %>
              <%= f.text_area :reason, rows: 3, class: 'form-control', id: 'return_reason', placeholder: 'Size, making, hallmark note or client request' %>
            </div>
          </div>
          <div class="row" style="margin-top:12px">
            <div class="field">
              <%= f.label :notes, 'House notes' %>
              <%= f.text_area :notes, rows: 2, class: 'form-control', id: 'return_notes', placeholder: 'Visible only on the after-sales book' %>
            </div>
          </div>
        </section>

        <div class="actions">
          <%= f.submit 'Record the return', class: 'btn-gold' %>
          <%= link_to 'Cancel', returns_path, class: 'atelier-back' %>
        </div>
      </div>

      <aside class="preview" id="return-preview">
        <p class="preview-kicker">Return ticket</p>
        <div class="gem" aria-hidden="true">💍</div>
        <h2 id="pv-name">Select a piece</h2>
        <span class="sku-chip" id="pv-sku">SKU</span>
        <div class="chips" id="pv-chips"></div>
        <p class="preview-price" id="pv-price">₹0.00</p>
        <p class="preview-line" id="pv-stock">Tray stock will appear here</p>
        <p class="preview-line" id="pv-settle">Cash refund</p>
        <p class="preview-desc" id="pv-note">Choose a catalogue piece to see metal, hallmark and weight.</p>
        <p class="preview-note">Recording this return adds the piece back to the tray when a catalogue item is named.</p>
      </aside>
    </div>
  <% end %>
</div>

<style>
  .return-desk a.btn-gold,
  .return-desk input.btn-gold { text-decoration: none; }
  .return-desk .preview-price { min-height: 2.2rem; }
  .return-desk #amount-field.is-quiet { opacity: 0.45; }
  .return-desk .walk-in-fields.is-off { display: none; }
</style>

<script>
(function(){
  var root = document.getElementById('return-desk');
  if(!root) return;
  var items = [];
  try { items = JSON.parse(root.getAttribute('data-items') || '[]'); } catch(e) { items = []; }
  var byId = {};
  items.forEach(function(it){ byId[String(it.id)] = it; });

  var itemSel = document.getElementById('return_jewelry_item_id');
  var qtyEl = document.getElementById('return_quantity');
  var actionEl = document.getElementById('return_action');
  var amountEl = document.getElementById('return_amount');
  var amountField = document.getElementById('amount-field');
  var customerSel = document.getElementById('return_customer_id');
  var walkIn = document.getElementById('walk-in-fields');
  var walkName = document.getElementById('return_walk_in_name');
  var walkPhone = document.getElementById('return_walk_in_phone');
  var nameEl = document.getElementById('pv-name');
  var skuEl = document.getElementById('pv-sku');
  var chipsEl = document.getElementById('pv-chips');
  var priceEl = document.getElementById('pv-price');
  var stockEl = document.getElementById('pv-stock');
  var settleEl = document.getElementById('pv-settle');
  var noteEl = document.getElementById('pv-note');

  function rupees(n){
    var v = Number(n || 0);
    return '₹' + v.toFixed(2);
  }

  function toggleWalkIn(){
    var booked = !!(customerSel && customerSel.value);
    if(walkIn) walkIn.classList.toggle('is-off', booked);
    if(walkName) walkName.disabled = booked;
    if(walkPhone) walkPhone.disabled = booked;
  }

  function paint(){
    toggleWalkIn();
    var it = byId[String(itemSel && itemSel.value)];
    var qty = Math.max(1, parseInt(qtyEl && qtyEl.value, 10) || 1);
    var action = (actionEl && actionEl.value) || 'cash';
    var cash = action === 'cash';
    if(amountField) amountField.classList.toggle('is-quiet', !cash);
    if(settleEl) settleEl.textContent = cash ? 'Cash refund' : 'Exchange for another piece';

    if(!it){
      if(nameEl) nameEl.textContent = 'Select a piece';
      if(skuEl) skuEl.textContent = 'SKU';
      if(chipsEl) chipsEl.innerHTML = '';
      if(priceEl) priceEl.textContent = rupees(amountEl && amountEl.value);
      if(stockEl) stockEl.textContent = 'Tray stock will appear here';
      if(noteEl) noteEl.textContent = 'Choose a catalogue piece to see metal, hallmark and weight.';
      return;
    }

    if(nameEl) nameEl.textContent = it.name || 'Piece';
    if(skuEl) skuEl.textContent = it.sku || 'SKU';
    if(chipsEl){
      var chips = [];
      if(it.metal) chips.push(it.metal);
      if(it.purity) chips.push(it.purity);
      if(it.weight) chips.push(Number(it.weight).toFixed(2) + ' g');
      chipsEl.innerHTML = chips.map(function(c){ return '<span class="chip">' + c + '</span>'; }).join('');
    }
    var shown = amountEl && amountEl.value ? amountEl.value : (it.price * qty);
    if(priceEl) priceEl.textContent = cash ? rupees(shown) : 'Exchange';
    if(stockEl) stockEl.textContent = 'On tray now: ' + it.stock + ' pcs · returning ' + qty;
    if(noteEl) noteEl.textContent = 'This return puts ' + qty + ' pc' + (qty === 1 ? '' : 's') + ' back on the tray.';
  }

  ['change','input'].forEach(function(ev){
    [itemSel, qtyEl, actionEl, amountEl, customerSel].forEach(function(el){
      if(el) el.addEventListener(ev, paint);
    });
  });
  paint();
})();
</script>
