<%= render 'shared/atelier_styles' %>

<%
  r = @record || {}
  client = @customer
  item = @item
  order = @order
  action = r['action'].to_s
  cash = action != 'exchange'
  when_at = begin
    Time.zone.parse(r['created_at'].to_s)
  rescue StandardError
    nil
  end
  bill_no = order&.invoice_number.presence || (r['order_id'].present? ? "Bill ##{r['order_id']}" : nil)
  walk_name = r['walk_in_name'].to_s.strip.presence
  walk_phone = r['walk_in_phone'].to_s.strip.presence
  guest_label = client&.full_name.presence || walk_name || 'Walk-in'
  guest_phone = client&.phone.presence || walk_phone
  amt = r['amount'].to_s.strip
  amt_num = (cash && amt.present? && amt != 'N/A') ? amt.to_f : 0.0
  ticket_no = "RET-#{r['id'].to_s.upcase}"
  shop = @shop
  house = shop&.shop_name.presence || current_user&.try(:display_name) || 'Jewellery House'
  tagline = shop&.tagline.presence || 'Hallmarked gold · Trust in every gram'
  phone = shop&.phone.presence
  email = shop&.email.presence
  street = [shop&.address_line1, shop&.address_line2].reject(&:blank?).join(', ')
  town = [shop&.city, shop&.pincode].reject(&:blank?).join(' ')
  place = [street, town, shop&.state].reject(&:blank?).join(', ')
  gstin = shop&.gstin.presence
  pan = shop&.pan.presence
  bis = shop&.bis_hallmark_licence.presence
  initials = house.to_s.split(/\s+/).map { |w| w[0] }.compact.first(2).join.upcase
  initials = 'JH' if initials.blank?
%>

<div class="atelier-page return-ticket">
  <div class="return-ticket-screen">
    <header class="atelier-hero">
      <div>
        <p class="eyebrow">After sales</p>
        <h1><%= cash ? 'Cash refund' : 'Exchange' %></h1>
        <p class="lead">
          <% if when_at %><%= when_at.strftime('%d %b %Y, %I:%M %p') %> · <% end %>
          <%= ticket_no %>
        </p>
      </div>
      <div class="ticket-actions">
        <%= link_to '← Returns', returns_path, class: 'atelier-back' %>
        <button type="button" class="btn-gold" onclick="window.print()">Print voucher</button>
      </div>
    </header>

    <div class="atelier-grid">
      <div class="atelier-form">
        <section class="section">
          <h2>Client &amp; bill</h2>
          <dl class="ticket-dl">
            <div>
              <dt>Client</dt>
              <dd>
                <% if client %>
                  <%= link_to client.full_name, customer_path(client), class: 'client-link' %>
                  <span class="sub"><%= client.phone.presence || 'No phone' %></span>
                <% else %>
                  <%= guest_label %>
                  <span class="sub"><%= walk_phone.presence || (walk_name ? 'No mobile' : 'Walk-in') %></span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt>Original bill</dt>
              <dd>
                <% if order %>
                  <%= link_to (bill_no || "Bill ##{order.id}"), order_path(order), class: 'client-link' %>
                <% else %>
                  <%= bill_no || '—' %>
                <% end %>
              </dd>
            </div>
            <div>
              <dt>Settlement</dt>
              <dd><span class="status-pill is-<%= action %>"><%= cash ? 'Cash refund' : 'Exchange' %></span></dd>
            </div>
            <div>
              <dt>Amount</dt>
              <dd class="gold">
                <% if cash && amt_num.positive? %>
                  <%= format_rupees(amt_num) %>
                <% else %>
                  —
                <% end %>
              </dd>
            </div>
          </dl>
        </section>

        <section class="section">
          <h2>Reason</h2>
          <p class="hint" style="margin:0"><%= r['reason'].presence || 'No reason noted.' %></p>
        </section>

        <section class="section">
          <h2>House notes</h2>
          <p class="hint" style="margin:0"><%= r['notes'].presence || 'No staff notes.' %></p>
        </section>
      </div>

      <aside class="preview">
        <p class="preview-kicker">Returned piece</p>
        <div class="gem" aria-hidden="true">💍</div>
        <% if item %>
          <h2><%= item.name %></h2>
          <span class="sku-chip"><%= item.sku %></span>
          <div class="chips">
            <% if item.metal %><span class="chip"><%= item.metal.name %></span><% end %>
            <% if item.purity %><span class="chip"><%= item.purity.name %></span><% end %>
            <% if item.weight_grams %><span class="chip"><%= '%.2f' % item.weight_grams %> g</span><% end %>
          </div>
          <p class="preview-line">Quantity returned: <strong><%= r['quantity'].presence || '—' %></strong></p>
          <p class="preview-line">On tray now: <strong><%= item.quantity %> pcs</strong></p>
          <p class="preview-note"><%= r['stock_updated'] ? 'Tray stock was restored when this return was recorded.' : 'Tray stock was not changed.' %></p>
          <p class="preview-note"><%= link_to 'Open in catalogue', jewelry_item_path(item), class: 'gold-link' %></p>
        <% else %>
          <h2>No piece named</h2>
          <p class="preview-desc">This ticket was recorded without a catalogue piece.</p>
        <% end %>
      </aside>
    </div>
  </div>

  <article class="return-voucher" id="print-area">
    <span class="ornament tl"></span>
    <span class="ornament tr"></span>
    <span class="ornament bl"></span>
    <span class="ornament br"></span>

    <header class="v-head">
      <div>
        <div class="brand-row">
          <div class="mark" aria-hidden="true"><%= initials %></div>
          <div>
            <h1 class="house-name"><%= house %></h1>
            <p class="house-tag"><%= tagline %></p>
          </div>
        </div>
        <p class="house-addr">
          <% if place.present? %><span><%= place %></span><% end %>
          <% contact = [phone, email].compact.join(' · ') %>
          <% papers = [gstin.present? ? "GSTIN #{gstin}" : nil, pan.present? ? "PAN #{pan}" : nil, bis.present? ? "BIS #{bis}" : nil].compact.join(' · ') %>
          <% if contact.present? %><span><%= contact %></span><% end %>
          <% if papers.present? %><span><%= papers %></span><% end %>
        </p>
      </div>
      <div class="v-side">
        <span>Voucher</span>
        <b><%= ticket_no %></b>
        <span><%= when_at ? when_at.strftime('%d %b %Y') : '—' %></span>
      </div>
    </header>

    <div class="kicker"><span><%= cash ? 'Return voucher' : 'Exchange voucher' %></span></div>

    <div class="v-meta">
      <div>
        <span class="meta-kicker">Returned by</span>
        <strong><%= guest_label %></strong>
        <p>
          <% bits = [guest_phone, client&.email.presence].compact %>
          <%= bits.join(' · ').presence %>
        </p>
      </div>
      <div class="v-facts">
        <div><span>Settlement</span><b><%= cash ? 'Cash refund' : 'Exchange' %></b></div>
        <div><span>Original bill</span><b><%= bill_no || '—' %></b></div>
        <div><span>Date</span><b><%= when_at ? when_at.strftime('%d %b %Y, %I:%M %p') : '—' %></b></div>
        <div><span>Qty</span><b><%= r['quantity'].presence || '—' %></b></div>
      </div>
    </div>

    <table class="pieces">
      <thead>
        <tr>
          <th>Piece</th>
          <th>Metal &amp; hallmark</th>
          <th class="num">Weight</th>
          <th class="num">Qty</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <span class="name"><%= item&.name || 'Piece not named' %></span>
            <% if item&.sku.present? %><span class="sub"><%= item.sku %></span><% end %>
          </td>
          <td>
            <%= [item&.metal&.name, item&.purity&.name].compact.join(' · ').presence || '—' %>
          </td>
          <td class="num"><%= item&.weight_grams ? ('%.2f g' % item.weight_grams) : '—' %></td>
          <td class="num"><%= r['quantity'].presence || '—' %></td>
        </tr>
      </tbody>
    </table>

    <div class="hero-amt">
      <span><%= cash ? 'Refund' : 'Exchange' %></span>
      <b><%= cash && amt_num.positive? ? format_rupees(amt_num) : 'No cash' %></b>
    </div>
    <% if cash && amt_num.positive? %>
      <p class="words"><b><%= rupees_in_words(amt_num) %></b></p>
    <% end %>

    <% if r['reason'].present? %>
      <p class="reason"><span>Reason</span><%= r['reason'] %></p>
    <% end %>

    <div class="sign">
      <div>
        <p>Client</p>
        <div class="line">Signature</div>
      </div>
      <div>
        <p>For <%= house %></p>
        <div class="line">Authorised signatory</div>
      </div>
    </div>
    <p class="thanks">With care, from the house.</p>
  </article>
</div>

<style>
  .return-ticket .ticket-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .return-ticket a.btn-gold, .return-ticket button.btn-gold {
    text-decoration: none; display: inline-flex; align-items: center;
    font-family: inherit; width: auto; cursor: pointer;
  }
  .return-ticket .ticket-dl { margin: 0; }
  .return-ticket .ticket-dl > div {
    display: grid; grid-template-columns: 140px 1fr; gap: 10px;
    padding: 10px 0; border-bottom: 1px solid rgba(201,162,39,0.16);
  }
  .return-ticket .ticket-dl dt {
    color: #6b6258; font-size: 12px; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .return-ticket .ticket-dl dd { margin: 0; color: #14110f; }
  .return-ticket .sub { display: block; margin-top: 2px; font-size: 12px; color: #6b6258; }
  .return-ticket .client-link { color: #0b1220; font-weight: 600; text-decoration: none; }
  .return-ticket .gold { color: #c9a227; font-weight: 700; font-variant-numeric: tabular-nums; }
  .return-ticket .status-pill {
    display: inline-block; padding: 3px 10px; border-radius: 999px;
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;
    border: 1px solid rgba(201,162,39,0.35); color: #c9a227; background: rgba(201,162,39,0.12);
  }
  .return-ticket .status-pill.is-exchange { color: #3f5d3a; border-color: rgba(63,93,58,0.35); background: rgba(63,93,58,0.08); }
  .return-ticket .gold-link { color: #e8d5a3; font-weight: 700; text-decoration: none; }
  .return-voucher { display: none; }

  @media print {
    .jewel-nav, .navbar, .flash, .return-ticket-screen { display: none !important; }
    .container { max-width: none !important; margin: 0 !important; padding: 0 !important; }
    body { background: #fff !important; }
    .return-voucher {
      display: block !important; position: relative;
      width: auto; min-height: 0; margin: 0; padding: 8mm 9mm;
      background: #fffaf3 !important; color: #14110f;
      box-shadow: none; overflow: hidden;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }
    .return-voucher .ornament {
      position: absolute; width: 22px; height: 22px;
      border-color: #c9a227; border-style: solid;
    }
    .return-voucher .ornament.tl { top: 10px; left: 10px; border-width: 2px 0 0 2px; }
    .return-voucher .ornament.tr { top: 10px; right: 10px; border-width: 2px 2px 0 0; }
    .return-voucher .ornament.bl { bottom: 10px; left: 10px; border-width: 0 0 2px 2px; }
    .return-voucher .ornament.br { bottom: 10px; right: 10px; border-width: 0 2px 2px 0; }
    .return-voucher .v-head {
      display: grid; grid-template-columns: 1fr auto; gap: 14px;
      align-items: center; padding-bottom: 8px;
      border-bottom: 1px solid rgba(201,162,39,0.35);
    }
    .return-voucher .brand-row { display: flex; align-items: center; gap: 10px; }
    .return-voucher .mark {
      width: 44px; height: 44px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: #0b1220; color: #e8d5a3; border: 1px solid #c9a227;
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 16px; font-weight: 700;
    }
    .return-voucher .house-name {
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 26px; font-weight: 600;
      margin: 0; color: #0b1220; letter-spacing: -0.02em;
    }
    .return-voucher .house-tag {
      margin: 3px 0 0; color: #c9a227; font-size: 9px; letter-spacing: 0.08em;
      text-transform: uppercase; font-weight: 700;
    }
    .return-voucher .house-addr { margin: 4px 0 0; color: #6b6258; font-size: 10px; line-height: 1.35; }
    .return-voucher .house-addr span { display: block; }
    .return-voucher .v-side { text-align: right; }
    .return-voucher .v-side span {
      display: block; font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;
      color: #c9a227; font-weight: 700;
    }
    .return-voucher .v-side b { display: block; font-size: 13px; color: #0b1220; margin: 2px 0; }
    .return-voucher .kicker {
      display: flex; align-items: center; gap: 14px; margin: 12px 0;
    }
    .return-voucher .kicker span {
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 20px;
      letter-spacing: 0.24em; text-transform: uppercase; color: #0b1220; font-weight: 600;
    }
    .return-voucher .kicker::before, .return-voucher .kicker::after {
      content: ""; flex: 1; height: 1px;
      background: linear-gradient(90deg, transparent, #c9a227, transparent);
    }
    .return-voucher .v-meta {
      display: grid; grid-template-columns: 1.2fr 1fr; gap: 18px;
      padding: 8px 0 12px; border-bottom: 1px solid rgba(201,162,39,0.28); margin-bottom: 12px;
    }
    .return-voucher .meta-kicker {
      display: block; margin: 0 0 3px; font-size: 9px; letter-spacing: 0.16em;
      text-transform: uppercase; color: #c9a227; font-weight: 700;
    }
    .return-voucher .v-meta strong {
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 18px; color: #0b1220;
    }
    .return-voucher .v-meta p { margin: 2px 0 0; color: #6b6258; font-size: 11px; }
    .return-voucher .v-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
    .return-voucher .v-facts span {
      display: block; font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;
      color: #c9a227; font-weight: 700;
    }
    .return-voucher .v-facts b { font-size: 13px; color: #0b1220; }
    .return-voucher table.pieces { width: 100%; border-collapse: collapse; }
    .return-voucher table.pieces th {
      text-align: left; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
      color: #0b1220; background: #f7f1e8 !important; padding: 7px 8px; border-bottom: 1.5px solid #c9a227;
    }
    .return-voucher table.pieces td { padding: 8px; border-bottom: 1px solid rgba(201,162,39,0.22); font-size: 12px; }
    .return-voucher table.pieces .name {
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 15px; font-weight: 600; color: #0b1220;
    }
    .return-voucher table.pieces .sub { display: block; margin-top: 2px; color: #6b6258; font-size: 11px; }
    .return-voucher table.pieces .num { text-align: right; font-variant-numeric: tabular-nums; }
    .return-voucher .hero-amt {
      margin: 14px 0 8px; padding: 12px 14px;
      border: 1px solid rgba(201,162,39,0.4); border-radius: 12px; background: #fff !important;
      display: flex; justify-content: space-between; align-items: baseline;
    }
    .return-voucher .hero-amt span {
      font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #c9a227; font-weight: 700;
    }
    .return-voucher .hero-amt b {
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 28px; color: #c9a227; font-weight: 600;
    }
    .return-voucher .words { font-size: 11px; color: #6b6258; margin: 0 0 12px; }
    .return-voucher .words b { color: #0b1220; }
    .return-voucher .reason { font-size: 12px; color: #14110f; margin: 0 0 18px; }
    .return-voucher .reason span {
      display: block; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase;
      color: #c9a227; font-weight: 700; margin-bottom: 4px;
    }
    .return-voucher .sign { display: flex; justify-content: space-between; gap: 24px; margin-top: 28px; }
    .return-voucher .sign div { width: 42%; }
    .return-voucher .sign p {
      margin: 0 0 28px; font-size: 11px; color: #6b6258; letter-spacing: 0.08em; text-transform: uppercase;
    }
    .return-voucher .sign .line { border-top: 1px solid #0b1220; padding-top: 6px; font-size: 11px; color: #0b1220; }
    .return-voucher .thanks {
      text-align: center; margin-top: 14px;
      font-family: "Cormorant Garamond", Georgia, serif; font-style: italic; font-size: 15px; color: #0b1220;
    }
    @page { size: A4 portrait; margin: 8mm; }
  }
</style>
