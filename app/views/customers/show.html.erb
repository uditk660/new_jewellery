<%= render 'shared/atelier_styles' %>

<%
  name = @customer.full_name.presence || 'Client'
  tab = params[:tab].to_s
%>

<div class="atelier-page client-show">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">People</p>
      <h1><%= name %></h1>
      <p class="lead"><%= [@customer.phone.presence, @customer.email.presence].compact.join(' · ').presence || 'No contact noted yet.' %></p>
    </div>
    <div class="piece-hero-actions">
      <%= link_to '← Clients', customers_path, class: 'atelier-back' %>
      <%= link_to 'Amend client', edit_customer_path(@customer), class: 'atelier-back' %>
      <%= link_to 'New bill', new_order_path(customer_id: @customer.id), class: 'btn-gold' %>
      <% unless @customer.orders.exists? %>
        <%= button_to 'Remove from the book', customer_path(@customer), method: :delete, class: 'atelier-back', form: { style: 'margin:0', data: { confirm: 'Remove this client from the book?' } } %>
      <% end %>
    </div>
  </header>

  <div class="atelier-grid">
    <div>
      <section class="atelier-form">
        <div class="section">
          <h2>Client details</h2>
          <p class="hint">Papers and address as they should appear on invoices.</p>
          <dl class="piece-dl">
            <div><dt>Phone</dt><dd><%= @customer.phone.presence || '—' %></dd></div>
            <div><dt>Email</dt><dd><%= @customer.email.presence || '—' %></dd></div>
            <div><dt>Aadhaar / PAN</dt><dd><%= @customer.aadhaar_or_pan.presence || '—' %></dd></div>
            <div><dt>GSTIN</dt><dd><%= @customer.gst_number.presence || '—' %></dd></div>
            <div><dt>Address</dt><dd><%= @customer.address.presence || '—' %></dd></div>
            <div><dt>On the book since</dt><dd><%= @customer.created_at.strftime('%d %b %Y') %></dd></div>
          </dl>
        </div>

        <div class="section">
          <h2>Bills</h2>
          <p class="hint">
            <%= link_to 'All', customer_path(@customer, tab: 'all'), class: (tab.blank? || tab == 'all' ? 'tab is-on' : 'tab') %>
            · <%= link_to 'Paid', customer_path(@customer, tab: 'paid'), class: (tab == 'paid' ? 'tab is-on' : 'tab') %>
            · <%= link_to 'Pending', customer_path(@customer, tab: 'pending'), class: (tab == 'pending' ? 'tab is-on' : 'tab') %>
          </p>
          <% if @orders.any? %>
            <table class="client-bills">
              <thead>
                <tr>
                  <th>Bill</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th class="num">Total</th>
                </tr>
              </thead>
              <tbody>
                <% @orders.each do |o| %>
                  <%
                    total = begin
                      o.total_with_taxes(cgst_rate: o.cgst_rate.to_f, igst_rate: o.igst_rate.to_f)
                    rescue
                      0
                    end
                  %>
                  <tr>
                    <td>
                      <%= link_to "##{o.id}", order_path(o) %>
                      <% if o.invoice_number.present? %>
                        <span class="sub"><%= link_to o.invoice_number, invoice_order_path(o), data: { turbolinks: false } %></span>
                      <% end %>
                    </td>
                    <td><%= (o.try(:sale_date) || o.created_at.to_date).strftime('%d %b %Y') %></td>
                    <td><%= o.status.to_s.titleize %></td>
                    <td class="num"><%= format_rupees(total) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="hint" style="margin:0">No bills for this client yet.</p>
          <% end %>
        </div>
      </section>
    </div>

    <aside class="preview" aria-label="Client card">
      <p class="preview-kicker">Client card</p>
      <div class="gem avatar-lg" aria-hidden="true"><%= @customer.initials %></div>
      <h2><%= name %></h2>
      <span class="sku-chip"><%= @customer.phone.presence || 'No phone' %></span>
      <div class="preview-price"><%= format_rupees(@customer.outstanding) %></div>
      <div class="preview-desc">Outstanding on the book</div>
      <p class="preview-note">
        <% if @customer.orders.exists? %>
          <%= @customer.orders.count %> bill<%= @customer.orders.count == 1 ? '' : 's' %> on file.
        <% else %>
          No bills yet. A new bill can be raised from this card.
        <% end %>
      </p>
    </aside>
  </div>
</div>

<style>
  .client-show .piece-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .client-show a.btn-gold { text-decoration: none; display: inline-flex; align-items: center; }
  .client-show .piece-hero-actions button.atelier-back { cursor: pointer; font-family: inherit; }
  .client-show .piece-dl { margin: 0; }
  .client-show .piece-dl > div {
    display: grid; grid-template-columns: 140px 1fr; gap: 8px;
    padding: 8px 0; border-bottom: 1px solid rgba(201,162,39,0.16);
  }
  .client-show .piece-dl dt {
    color: #6b6258; font-size: 12px; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .client-show .piece-dl dd { margin: 0; color: #14110f; }
  .client-show .tab { color: #6b6258; text-decoration: none; font-weight: 600; }
  .client-show .tab.is-on { color: #0b1220; }
  .client-show .client-bills { width: 100%; border-collapse: collapse; margin-top: 8px; }
  .client-show .client-bills th {
    text-align: left; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #6b6258; padding: 8px 0; border-bottom: 1px solid rgba(201,162,39,0.22);
  }
  .client-show .client-bills td {
    padding: 10px 0; border-bottom: 1px solid rgba(201,162,39,0.12); font-size: 14px;
  }
  .client-show .client-bills a { color: #0b1220; }
  .client-show .sub { display: block; font-size: 12px; color: #6b6258; }
  .client-show .num { text-align: right; color: #c9a227; font-weight: 600; white-space: nowrap; }
  .client-show .avatar-lg {
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; font-weight: 700; letter-spacing: 0.08em; color: #e8d5a3;
  }
  @media (max-width: 880px) {
    .client-show .piece-dl > div { grid-template-columns: 1fr; }
    .client-show .piece-hero-actions { width: 100%; }
  }
</style>
