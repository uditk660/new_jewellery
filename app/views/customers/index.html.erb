<%= render 'shared/atelier_styles' %>

<div class="atelier-page people-book is-list" id="customers-view">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">People</p>
      <h1>Clients</h1>
      <p class="lead">Everyone who buys from the house — name, phone, papers and outstanding on the book.</p>
    </div>
    <div class="people-hero-actions">
      <div class="view-toggle" role="group" aria-label="Layout">
        <button type="button" class="view-btn" data-view="cards" aria-pressed="false">Cards</button>
        <button type="button" class="view-btn is-active" data-view="list" aria-pressed="true">List</button>
      </div>
      <%= link_to 'Register a client', new_customer_path, class: 'btn-gold' %>
    </div>
  </header>

  <div class="cat-toolbar atelier-form">
    <%= form_tag customers_path, method: :get, class: 'people-search' do %>
      <%= text_field_tag :q, @q, class: 'form-control', placeholder: 'Search name, phone, email, Aadhaar, PAN or GST' %>
      <button type="submit" class="atelier-back">Search</button>
      <% if @q.present? %>
        <%= link_to 'Clear', customers_path, class: 'atelier-back' %>
      <% end %>
    <% end %>
    <div class="people-count">
      <span>In the book</span>
      <strong><%= @customers.size %></strong>
    </div>
  </div>

  <% if @customers.any? %>
    <div class="people-cards" data-layout="cards">
      <% @customers.each do |c| %>
        <%= link_to customer_path(c), class: 'people-card' do %>
          <div class="people-card-top">
            <span class="avatar"><%= c.initials %></span>
            <div>
              <h2><%= c.full_name.presence || 'Unnamed client' %></h2>
              <p><%= c.phone.presence || 'No phone' %></p>
            </div>
          </div>
          <p class="meta"><%= c.email.presence || 'No email' %></p>
          <p class="meta"><%= c.gst_number.present? ? "GST #{c.gst_number}" : 'No GST on file' %></p>
          <p class="bal <%= c.outstanding.positive? ? 'due' : '' %>"><%= format_rupees(c.outstanding) %> outstanding</p>
        <% end %>
      <% end %>
    </div>

    <div class="people-list-wrap" data-layout="list">
      <table class="people-list">
        <thead>
          <tr>
            <th>Client</th>
            <th>Phone</th>
            <th>GST</th>
            <th class="num">Outstanding</th>
          </tr>
        </thead>
        <tbody>
          <% @customers.each do |c| %>
            <tr>
              <td>
                <%= link_to customer_path(c), class: 'people-name' do %>
                  <span class="avatar small"><%= c.initials %></span>
                  <span>
                    <strong><%= c.full_name.presence || 'Unnamed client' %></strong>
                    <span class="sub"><%= c.email.presence || 'No email' %></span>
                  </span>
                <% end %>
              </td>
              <td><%= c.phone.presence || '—' %></td>
              <td><%= c.gst_number.presence || '—' %></td>
              <td class="num <%= 'due' if c.outstanding.positive? %>"><%= format_rupees(c.outstanding) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="atelier-form">
      <p class="hint" style="margin:0">
        <% if @q.present? %>
          Nothing matches “<%= @q %>”. Try another name or phone.
        <% else %>
          No clients yet. Register the first buyer to open the book.
        <% end %>
      </p>
      <div class="actions" style="margin-top:16px">
        <% if @q.present? %>
          <%= link_to 'Clear search', customers_path, class: 'atelier-back' %>
        <% else %>
          <%= link_to 'Register a client', new_customer_path, class: 'btn-gold' %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<style>
  .people-book .people-hero-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .people-book a.btn-gold { text-decoration: none; display: inline-flex; align-items: center; }
  .people-book .view-toggle {
    display: inline-flex; padding: 3px; border-radius: 999px;
    border: 1px solid rgba(201,162,39,0.4); background: #fffaf3;
  }
  .people-book .view-btn {
    appearance: none; border: 0; background: transparent; color: #6b6258;
    font: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    padding: 7px 14px; border-radius: 999px; cursor: pointer;
  }
  .people-book .view-btn.is-active {
    background: linear-gradient(90deg, #e8d5a3, #c9a227); color: #0b1220;
  }
  .people-book .cat-toolbar {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    margin-bottom: 18px; flex-wrap: wrap;
  }
  .people-book .people-search { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; flex: 1; }
  .people-book .people-search .form-control { max-width: 420px; }
  .people-book .people-count { text-align: right; color: #6b6258; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
  .people-book .people-count strong { display: block; font-size: 1.2rem; color: #0b1220; letter-spacing: 0; text-transform: none; }
  .people-book .people-cards {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;
  }
  .people-book .people-card {
    display: block; text-decoration: none; color: inherit;
    background: #fffaf3; border: 1px solid rgba(201,162,39,0.28); border-radius: 18px;
    padding: 18px; box-shadow: 0 12px 28px rgba(20,17,15,0.05);
  }
  .people-book .people-card:hover { border-color: #c9a227; }
  .people-book .people-card-top { display: flex; gap: 12px; align-items: center; margin-bottom: 10px; }
  .people-book .avatar {
    width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: #0b1220; color: #e8d5a3; font-weight: 700; font-size: 13px;
    letter-spacing: 0.04em;
  }
  .people-book .avatar.small { width: 36px; height: 36px; border-radius: 10px; font-size: 12px; }
  .people-book .people-card h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.35rem; margin: 0; font-weight: 600; color: #0b1220;
  }
  .people-book .people-card-top p,
  .people-book .meta { margin: 2px 0 0; color: #6b6258; font-size: 13px; }
  .people-book .bal { margin: 12px 0 0; font-weight: 700; color: #c9a227; }
  .people-book .bal.due, .people-book td.due { color: #7f1d1d; }
  .people-book .people-list-wrap {
    background: #fffaf3; border: 1px solid rgba(201,162,39,0.28); border-radius: 18px;
    overflow: hidden; box-shadow: 0 12px 28px rgba(20,17,15,0.05);
  }
  .people-book .people-list { width: 100%; border-collapse: collapse; }
  .people-book .people-list th {
    text-align: left; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #6b6258; font-weight: 700; padding: 14px 16px;
    border-bottom: 1px solid rgba(201,162,39,0.22); background: #f7f1e8;
  }
  .people-book .people-list td {
    padding: 12px 16px; border-bottom: 1px solid rgba(201,162,39,0.12);
    vertical-align: middle; font-size: 14px; color: #14110f;
  }
  .people-book .people-list tbody tr:last-child td { border-bottom: 0; }
  .people-book .people-list tbody tr:hover { background: rgba(232,213,163,0.22); }
  .people-book .people-name {
    display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;
  }
  .people-book .people-name strong {
    display: block; font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.15rem; font-weight: 600; color: #0b1220;
  }
  .people-book .sub { display: block; margin-top: 2px; font-size: 12px; color: #6b6258; }
  .people-book .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: #c9a227; font-weight: 600; }
  .people-book.is-list [data-layout="cards"] { display: none; }
  .people-book.is-list [data-layout="list"] { display: block; }
  .people-book.is-cards [data-layout="list"] { display: none; }
  .people-book.is-cards [data-layout="cards"] { display: grid; }
  @media (max-width: 800px) {
    .people-book .people-hero-actions { width: 100%; }
    .people-book .people-list th:nth-child(3),
    .people-book .people-list td:nth-child(3) { display: none; }
  }
</style>

<script>
  (function(){
    var wrap = document.getElementById('customers-view');
    if(!wrap) return;
    var buttons = wrap.querySelectorAll('.view-btn');
    var key = 'customers-view';
    function apply(view){
      var mode = view === 'cards' ? 'cards' : 'list';
      wrap.classList.remove('is-list', 'is-cards');
      wrap.classList.add(mode === 'cards' ? 'is-cards' : 'is-list');
      buttons.forEach(function(btn){
        var on = btn.getAttribute('data-view') === mode;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      try { localStorage.setItem(key, mode); } catch(e){}
    }
    buttons.forEach(function(btn){
      btn.addEventListener('click', function(){ apply(btn.getAttribute('data-view')); });
    });
    var saved = 'list';
    try { saved = localStorage.getItem(key) || 'list'; } catch(e){}
    apply(saved);
  })();
</script>
