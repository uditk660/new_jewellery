<%= render 'shared/atelier_styles' %>

<%
  today = @today || Time.zone.today
  stock_items = @stock_items || []
  total_stock = @total_stock_value.to_f
  tray_pcs = @stock_piece_count.to_i
  tray_grams = @stock_weight_grams.to_f
%>

<div class="atelier-page rates-board is-list" id="rates-view">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Rates</p>
      <h1>Today’s board</h1>
      <p class="lead">Set ₹ per gram for each hallmark. Tray value below follows these rates the moment they are saved.</p>
    </div>
    <div class="rates-hero-actions">
      <div class="view-toggle" role="group" aria-label="Layout">
        <button type="button" class="view-btn" data-view="cards" aria-pressed="false">Cards</button>
        <button type="button" class="view-btn is-active" data-view="list" aria-pressed="true">List</button>
      </div>
      <%= link_to 'Set a rate', new_rate_path, class: 'btn-gold' %>
    </div>
  </header>

  <p class="hint" style="margin:0 0 16px">Board date: <%= today.strftime('%d %b %Y') %>.</p>

  <div class="stock-summary">
    <div class="stock-chip is-total">
      <span>Stock value</span>
      <strong><%= format_rupees(total_stock) %></strong>
    </div>
    <div class="stock-chip">
      <span>On the tray</span>
      <strong><%= tray_pcs %> <em>pcs</em></strong>
    </div>
    <div class="stock-chip">
      <span>Weight</span>
      <strong><%= '%.2f' % tray_grams %> <em>g</em></strong>
    </div>
    <div class="stock-chip">
      <span>Pieces</span>
      <strong><%= stock_items.size %></strong>
    </div>
  </div>

  <% if @metals.any? %>
    <div class="rate-cards" data-layout="cards">
      <% @metals.each do |metal| %>
        <section class="rate-card">
          <div class="rate-card-top">
            <span class="swatch" style="background:<%= metal.chip_colour %>"></span>
            <div>
              <h2><%= metal.name %></h2>
              <p><%= metal.code.presence || metal.base_unit.presence || 'gram' %></p>
            </div>
            <% if metal.rate_board_locked? %><span class="lock-pill">Inactive</span><% end %>
          </div>
          <% purities = metal.purities.ordered %>
          <% if purities.any? %>
            <ul class="rate-rows">
              <% purities.each do |purity| %>
                <% locked = purity.rate_board_locked? %>
                <li class="rate-row">
                  <div class="hallmark">
                    <strong><%= purity.name %></strong>
                    <span><%= [purity.trimmed_percent && "#{purity.trimmed_percent}%", purity.fineness.presence, purity.available_weight_label].compact.join(' · ') %></span>
                  </div>
                  <% if locked %>
                    <div class="rate-locked">
                      <span class="rupee">₹</span>
                      <strong><%= purity.updated_price.present? ? ('%.2f' % purity.updated_price) : '—' %></strong>
                      <span class="per">/g</span>
                      <span class="lock-pill">Locked</span>
                    </div>
                  <% else %>
                    <%= form_tag rates_path, method: :post, class: 'rate-inline' do %>
                      <%= hidden_field_tag :metal_id, metal.id %>
                      <%= hidden_field_tag :purity_id, purity.id %>
                      <%= hidden_field_tag 'rate[date]', today %>
                      <label class="sr-only" for="price_<%= purity.id %>">₹ / g</label>
                      <span class="rupee">₹</span>
                      <%= number_field_tag :price_per_gram, (purity.updated_price.present? ? ('%.2f' % purity.updated_price) : nil), id: "price_#{purity.id}", step: '0.01', min: 0, class: 'form-control rate-input', placeholder: '0.00' %>
                      <span class="per">/g</span>
                      <%= submit_tag 'Save', class: 'btn-gold' %>
                    <% end %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="hint" style="margin:0">No hallmarks on this metal yet. <%= link_to 'Add them', metal_path(metal), class: 'atelier-back', style: 'margin-left:8px' %></p>
          <% end %>
        </section>
      <% end %>
    </div>

    <div class="rate-list-wrap" data-layout="list">
      <table class="rate-list">
        <thead>
          <tr>
            <th>Metal</th>
            <th>Hallmark</th>
            <th class="col-weight">Weight</th>
            <th class="col-rate">₹ / g</th>
          </tr>
        </thead>
        <tbody>
          <% @metals.each do |metal| %>
            <% metal.purities.ordered.each do |purity| %>
              <% locked = purity.rate_board_locked? %>
              <tr>
                <td>
                  <span class="metal-cell">
                    <span class="swatch small" style="background:<%= metal.chip_colour %>"></span>
                    <%= metal.name %>
                  </span>
                  <% if metal.rate_board_locked? %><span class="sub">Inactive</span><% end %>
                </td>
                <td>
                  <strong><%= purity.name %></strong>
                  <span class="sub"><%= [purity.trimmed_percent && "#{purity.trimmed_percent}%", purity.fineness.presence, (!purity.active? ? 'Inactive' : nil)].compact.join(' · ') %></span>
                </td>
                <td class="col-weight"><%= purity.available_weight_label %></td>
                <td class="col-rate">
                  <% if locked %>
                    <div class="rate-locked">
                      <span class="rupee">₹</span>
                      <strong><%= purity.updated_price.present? ? ('%.2f' % purity.updated_price) : '—' %></strong>
                      <span class="per">/g</span>
                      <span class="lock-pill">Locked</span>
                    </div>
                  <% else %>
                    <%= form_tag rates_path, method: :post, class: 'rate-inline' do %>
                      <%= hidden_field_tag :metal_id, metal.id %>
                      <%= hidden_field_tag :purity_id, purity.id %>
                      <%= hidden_field_tag 'rate[date]', today %>
                      <span class="rupee">₹</span>
                      <%= number_field_tag :price_per_gram, (purity.updated_price.present? ? ('%.2f' % purity.updated_price) : nil), step: '0.01', min: 0, class: 'form-control rate-input', placeholder: '0.00' %>
                      <span class="per">/g</span>
                      <%= submit_tag 'Save', class: 'btn-gold' %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if metal.purities.empty? %>
              <tr>
                <td>
                  <span class="metal-cell">
                    <span class="swatch small" style="background:<%= metal.chip_colour %>"></span>
                    <%= metal.name %>
                  </span>
                </td>
                <td colspan="3" class="hint" style="margin:0">No hallmarks yet</td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="atelier-form">
      <p class="hint" style="margin:0">No metals yet. Add Gold with 18K, 20K and 22K, then set today’s rates here.</p>
      <div class="actions" style="margin-top:16px"><%= link_to 'Add a metal', new_metal_path, class: 'btn-gold' %></div>
    </div>
  <% end %>

  <section class="stock-ledger">
    <div class="stock-ledger-head">
      <div>
        <h2>Stock by piece</h2>
        <p class="hint">Each catalogue piece at the hallmark rate on this board.</p>
      </div>
      <%= link_to 'Open catalogue', jewelry_items_path, class: 'atelier-back' %>
    </div>

    <% if stock_items.any? %>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>Piece</th>
              <th>Metal &amp; hallmark</th>
              <th class="num">Weight</th>
              <th class="num">Tray</th>
              <th class="num">₹ / g</th>
              <th class="num">Stock value</th>
            </tr>
          </thead>
          <tbody>
            <% stock_items.each do |item| %>
              <%
                qty = item.quantity.to_i
                rate = item.effective_price_per_gram
                value = item.stock_amount
              %>
              <tr>
                <td>
                  <%= link_to jewelry_item_path(item), class: 'piece-link' do %>
                    <strong><%= item.name %></strong>
                    <span class="sku"><%= item.sku %></span>
                    <% if item.jewellery_category %>
                      <span class="sub"><%= item.jewellery_category.name %></span>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <span class="metal-cell">
                    <% if item.metal %>
                      <span class="swatch small" style="background:<%= item.metal.chip_colour %>"></span>
                      <%= item.metal.name %>
                    <% else %>
                      —
                    <% end %>
                  </span>
                  <% if item.purity %>
                    <span class="sub"><%= item.purity.name %></span>
                  <% end %>
                </td>
                <td class="num"><%= '%.2f' % item.weight_grams.to_f %> g</td>
                <td class="num">
                  <% if qty > 0 %>
                    <span class="stock in"><%= qty %> pcs</span>
                  <% else %>
                    <span class="stock out">Out of tray</span>
                  <% end %>
                </td>
                <td class="num">
                  <% if rate.present? %>
                    <%= format_rupees(rate) %>
                  <% else %>
                    <span class="muted">No rate</span>
                  <% end %>
                </td>
                <td class="num gold"><%= format_rupees(value) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <th>House total</th>
              <th></th>
              <th class="num"><%= '%.2f' % tray_grams %> g</th>
              <th class="num"><%= tray_pcs %> pcs</th>
              <th></th>
              <th class="num gold"><%= format_rupees(total_stock) %></th>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="atelier-form empty">
        <p class="hint" style="margin:0">No catalogue pieces yet. Register a piece to see tray value at today’s board.</p>
        <div class="actions" style="margin-top:16px"><%= link_to 'Register a piece', new_jewelry_item_path, class: 'btn-gold' %></div>
      </div>
    <% end %>
  </section>
</div>

