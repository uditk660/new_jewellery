<%= render 'shared/atelier_styles' %>

<%
  today = @today || Time.zone.today
%>

<div class="atelier-page rates-board is-cards" id="rates-view">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Rates</p>
      <h1>Today’s board</h1>
      <p class="lead">Set ₹ per gram for each hallmark. Catalogue valuation uses these rates the moment they are saved.</p>
    </div>
    <div class="rates-hero-actions">
      <div class="view-toggle" role="group" aria-label="Layout">
        <button type="button" class="view-btn is-active" data-view="cards" aria-pressed="true">Cards</button>
        <button type="button" class="view-btn" data-view="list" aria-pressed="false">List</button>
      </div>
      <%= link_to 'Set a rate', new_rate_path, class: 'atelier-back' %>
    </div>
  </header>

  <p class="hint" style="margin:0 0 16px">Board date: <%= today.strftime('%d %b %Y') %>.</p>

  <% if @metals.any? %>
    <div class="rate-cards" data-layout="cards">
      <% @metals.each do |metal| %>
        <section class="rate-card">
          <div class="rate-card-top">
            <span class="swatch" style="background:<%= metal.chip_colour %>"></span>
            <div>
              <h2><%= metal.name %></h2>
              <p><%= metal.code.presence || metal.base_unit.presence || 'gram' %></p>
            </div>
          </div>
          <% purities = metal.purities.ordered %>
          <% if purities.any? %>
            <ul class="rate-rows">
              <% purities.each do |purity| %>
                <li class="rate-row">
                  <div class="hallmark">
                    <strong><%= purity.name %></strong>
                    <span><%= [purity.trimmed_percent && "#{purity.trimmed_percent}%", purity.fineness.presence, purity.available_weight_label].compact.join(' · ') %></span>
                  </div>
                  <%= form_tag rates_path, method: :post, class: 'rate-inline' do %>
                    <%= hidden_field_tag :metal_id, metal.id %>
                    <%= hidden_field_tag :purity_id, purity.id %>
                    <%= hidden_field_tag 'rate[date]', today %>
                    <label class="sr-only" for="price_<%= purity.id %>">₹ / g</label>
                    <span class="rupee">₹</span>
                    <%= number_field_tag :price_per_gram, (purity.updated_price.present? ? ('%.2f' % purity.updated_price) : nil), id: "price_#{purity.id}", step: '0.01', min: 0, class: 'form-control', placeholder: '0.00' %>
                    <span class="per">/g</span>
                    <%= submit_tag 'Save', class: 'btn-gold' %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="hint" style="margin:0">No hallmarks on this metal yet. <%= link_to 'Add them', metal_path(metal), class: 'atelier-back', style: 'margin-left:8px' %></p>
          <% end %>
        </section>
      <% end %>
    </div>

    <div class="rate-list-wrap" data-layout="list">
      <table class="rate-list">
        <thead>
          <tr>
            <th>Metal</th>
            <th>Hallmark</th>
            <th>Weight</th>
            <th>₹ / g</th>
          </tr>
        </thead>
        <tbody>
          <% @metals.each do |metal| %>
            <% metal.purities.ordered.each do |purity| %>
              <tr>
                <td>
                  <span class="metal-cell">
                    <span class="swatch small" style="background:<%= metal.chip_colour %>"></span>
                    <%= metal.name %>
                  </span>
                </td>
                <td>
                  <strong><%= purity.name %></strong>
                  <span class="sub"><%= [purity.trimmed_percent && "#{purity.trimmed_percent}%", purity.fineness.presence].compact.join(' · ') %></span>
                </td>
                <td class="num"><%= purity.available_weight_label %></td>
                <td>
                  <%= form_tag rates_path, method: :post, class: 'rate-inline' do %>
                    <%= hidden_field_tag :metal_id, metal.id %>
                    <%= hidden_field_tag :purity_id, purity.id %>
                    <%= hidden_field_tag 'rate[date]', today %>
                    <span class="rupee">₹</span>
                    <%= number_field_tag :price_per_gram, (purity.updated_price.present? ? ('%.2f' % purity.updated_price) : nil), step: '0.01', min: 0, class: 'form-control', placeholder: '0.00' %>
                    <%= submit_tag 'Save', class: 'btn-gold' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if metal.purities.empty? %>
              <tr>
                <td>
                  <span class="metal-cell">
                    <span class="swatch small" style="background:<%= metal.chip_colour %>"></span>
                    <%= metal.name %>
                  </span>
                </td>
                <td colspan="3" class="hint" style="margin:0">No hallmarks yet</td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="atelier-form">
      <p class="hint" style="margin:0">No metals yet. Add Gold with 18K, 20K and 22K, then set today’s rates here.</p>
      <div class="actions" style="margin-top:16px"><%= link_to 'Add a metal', new_metal_path, class: 'btn-gold' %></div>
    </div>
  <% end %>
</div>

<style>
  .rates-board .rates-hero-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .rates-board .view-toggle {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid rgba(201,162,39,0.4);
    background: #fffaf3;
  }
  .rates-board .view-btn {
    appearance: none; border: 0; background: transparent; color: #6b6258;
    font: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    padding: 7px 14px; border-radius: 999px; cursor: pointer;
  }
  .rates-board .view-btn.is-active {
    background: linear-gradient(90deg, #e8d5a3, #c9a227);
    color: #0b1220;
  }
  .rates-board .rate-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 16px;
  }
  .rates-board .rate-card {
    background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.28);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 12px 28px rgba(20,17,15,0.05);
  }
  .rates-board .rate-card-top { display: flex; gap: 12px; align-items: center; margin-bottom: 14px; }
  .rates-board .swatch { width: 36px; height: 36px; border-radius: 10px; border: 1px solid rgba(201,162,39,0.35); flex-shrink: 0; }
  .rates-board .swatch.small { width: 22px; height: 22px; border-radius: 6px; }
  .rates-board .rate-card h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.45rem; margin: 0; font-weight: 600; color: #0b1220;
  }
  .rates-board .rate-card-top p { margin: 2px 0 0; color: #6b6258; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .rates-board .rate-rows { list-style: none; margin: 0; padding: 0; }
  .rates-board .rate-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-top: 1px solid rgba(201,162,39,0.16);
  }
  .rates-board .hallmark strong { display: block; color: #0b1220; }
  .rates-board .hallmark span { color: #6b6258; font-size: 12px; }
  .rates-board .rate-inline {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .rates-board .rate-inline .form-control { width: 120px; }
  .rates-board .rate-inline .btn-gold { padding: 10px 14px; font-size: 13px; }
  .rates-board .rupee { color: #c9a227; font-weight: 700; }
  .rates-board .per { color: #6b6258; font-size: 12px; }
  .rates-board .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); border: 0;
  }
  .rates-board .rate-list-wrap {
    background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.28);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(20,17,15,0.05);
  }
  .rates-board .rate-list { width: 100%; border-collapse: collapse; }
  .rates-board .rate-list th {
    text-align: left; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #6b6258; font-weight: 700; padding: 14px 16px;
    border-bottom: 1px solid rgba(201,162,39,0.22); background: #f7f1e8;
  }
  .rates-board .rate-list td {
    padding: 12px 16px; border-bottom: 1px solid rgba(201,162,39,0.12);
    vertical-align: middle; font-size: 14px; color: #14110f;
  }
  .rates-board .rate-list tbody tr:last-child td { border-bottom: 0; }
  .rates-board .metal-cell { display: inline-flex; align-items: center; gap: 8px; }
  .rates-board .sub { display: block; margin-top: 2px; font-size: 12px; color: #6b6258; }
  .rates-board .num { white-space: nowrap; color: #6b6258; font-variant-numeric: tabular-nums; }
  .rates-board.is-list [data-layout="cards"] { display: none; }
  .rates-board.is-list [data-layout="list"] { display: block; }
  .rates-board.is-cards [data-layout="list"] { display: none; }
  .rates-board.is-cards [data-layout="cards"] { display: grid; }
  @media (max-width: 800px) {
    .rates-board .rates-hero-actions { width: 100%; }
    .rates-board .rate-list th:nth-child(3),
    .rates-board .rate-list td:nth-child(3) { display: none; }
  }
</style>

<script>
  (function(){
    var wrap = document.getElementById('rates-view');
    if(!wrap) return;
    var buttons = wrap.querySelectorAll('.view-btn');
    var key = 'rates-view';
    function apply(view){
      var mode = view === 'list' ? 'list' : 'cards';
      wrap.classList.remove('is-list', 'is-cards');
      wrap.classList.add(mode === 'list' ? 'is-list' : 'is-cards');
      buttons.forEach(function(btn){
        var on = btn.getAttribute('data-view') === mode;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      try { localStorage.setItem(key, mode); } catch(e){}
    }
    buttons.forEach(function(btn){
      btn.addEventListener('click', function(){ apply(btn.getAttribute('data-view')); });
    });
    var saved = 'cards';
    try { saved = localStorage.getItem(key) || 'cards'; } catch(e){}
    apply(saved);
  })();
</script>
