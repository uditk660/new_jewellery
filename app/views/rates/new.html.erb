<%= render 'shared/atelier_styles' %>

<div class="atelier-page rates-board">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Rates</p>
      <h1>Set a rate</h1>
      <p class="lead">Choose the metal and hallmark, then enter today’s rupees per gram. This feeds catalogue valuation.</p>
    </div>
    <%= link_to '← Today’s board', rates_path, class: 'atelier-back' %>
  </header>

  <div class="atelier-form" style="max-width:640px">
    <% if flash[:alert].present? %>
      <div class="errors"><%= flash[:alert] %></div>
    <% end %>
    <% if @rate && @rate.errors.any? %>
      <div class="errors"><%= @rate.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= form_tag rates_path, method: :post do %>
      <section class="section">
        <h2>Hallmark &amp; rate</h2>
        <p class="hint">One rate per hallmark for the day. Saving again today overwrites the earlier figure.</p>
        <div class="row">
          <div class="field">
            <label for="rate_date">Date</label>
            <%= date_field_tag 'rate[date]', (@rate&.date || Time.zone.today), class: 'form-control', id: 'rate_date' %>
          </div>
          <div class="field">
            <label for="metal-select">Metal <span class="req">*</span></label>
            <select id="metal-select" name="metal_id" class="form-control">
              <option value="">Select metal</option>
              <% (@metals || []).each do |m| %>
                <option value="<%= m.id %>" <%= 'selected' if m.id == @selected_metal_id %>><%= m.name %></option>
              <% end %>
            </select>
          </div>
        </div>
        <div class="row" style="margin-top:12px">
          <div class="field">
            <label for="purity-select">Purity / hallmark <span class="req">*</span></label>
            <select id="purity-select" name="purity_id" class="form-control">
              <option value="">Select hallmark</option>
              <% (@purities_for_metal || []).each do |p| %>
                <option value="<%= p.id %>" <%= 'selected' if p.id == @selected_purity_id %>><%= p.hallmark_label %></option>
              <% end %>
            </select>
          </div>
          <div class="field">
            <label for="price_per_gram">Rate ₹ / g <span class="req">*</span></label>
            <%= number_field_tag :price_per_gram, (@prefill_price.present? ? ('%.2f' % @prefill_price) : nil), id: 'price_per_gram', class: 'form-control', step: '0.01', min: 0, placeholder: '0.00' %>
          </div>
        </div>
      </section>
      <div class="actions">
        <%= submit_tag 'Save rate', class: 'btn-gold', id: 'rate-submit' %>
        <%= link_to 'Cancel', rates_path, class: 'atelier-back' %>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function(){
    var metalSelect = document.getElementById('metal-select');
    var puritySelect = document.getElementById('purity-select');
    var priceEl = document.getElementById('price_per_gram');
    var submitEl = document.getElementById('rate-submit');
    var purities = {};
    <% (@metals || []).each do |m| %>
      purities['<%= m.id %>'] = <%= m.purities.ordered.map { |p| { id: p.id, label: p.hallmark_label, price: p.updated_price.to_f } }.to_json.html_safe %>;
    <% end %>
    function rebuild(mid, keep){
      var list = purities[mid] || [];
      var prev = keep || (puritySelect && puritySelect.value);
      puritySelect.innerHTML = '';
      var blank = document.createElement('option');
      blank.value = ''; blank.text = 'Select hallmark';
      puritySelect.appendChild(blank);
      list.forEach(function(item){
        var opt = document.createElement('option');
        opt.value = item.id; opt.text = item.label;
        puritySelect.appendChild(opt);
      });
      if(prev){
        var still = Array.prototype.slice.call(puritySelect.options).some(function(o){ return String(o.value) === String(prev); });
        if(still) puritySelect.value = prev;
      }
    }
    function sync(){
      var ready = metalSelect.value && puritySelect.value && parseFloat(priceEl.value) > 0;
      if(submitEl) submitEl.disabled = !ready;
    }
    if(metalSelect){
      metalSelect.addEventListener('change', function(){
        rebuild(this.value, '');
        var first = (purities[this.value] || [])[0];
        if(first && priceEl && !priceEl.value) priceEl.value = first.price > 0 ? first.price.toFixed(2) : '';
        sync();
      });
    }
    if(puritySelect){
      puritySelect.addEventListener('change', function(){
        var list = purities[metalSelect.value] || [];
        var hit = list.filter(function(p){ return String(p.id) === String(puritySelect.value); })[0];
        if(hit && priceEl) priceEl.value = hit.price > 0 ? hit.price.toFixed(2) : '';
        sync();
      });
    }
    if(priceEl) priceEl.addEventListener('input', sync);
    sync();
  })();
</script>
