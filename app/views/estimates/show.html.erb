<%
  shop = @shop
  est = @estimate
  house = shop&.shop_name.presence || current_user&.display_name || 'Jewellery House'
  tagline = shop&.tagline.presence || 'Hallmarked gold · Trust in every gram'
  owner = shop&.owner_name.presence
  street = [shop&.address_line1, shop&.address_line2].reject(&:blank?).join(', ')
  town = [shop&.city, shop&.pincode].reject(&:blank?).join(' ')
  place = [street, town, shop&.state].reject(&:blank?).join(', ')
  contact = [shop&.phone.presence, shop&.email.presence].compact.join(' · ')
  papers = [shop&.gstin.present? ? "GSTIN #{shop.gstin}" : nil, shop&.bis_hallmark_licence.present? ? "BIS #{shop.bis_hallmark_licence}" : nil].compact.join(' · ')
  city = shop&.city.presence || 'India'
  initials = house.to_s.split(/\s+/).map { |w| w[0] }.compact.first(2).join.upcase
  initials = 'JH' if initials.blank?
  items = est.item_rows
  sets = est.settlement_rows
  has_prev = est.prev_fine_mg.to_i.nonzero? || est.prev_amount_cents.to_i.nonzero? || est.prev_ref.present?
  pct = ->(v) { format('%.2f', v.to_f) }
  printed_at = Time.current.in_time_zone('Asia/Kolkata')
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rough estimate <%= est.estimate_no %> · <%= est.party_name %> · <%= house %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <meta name="turbolinks-visit-control" content="reload">
  <style>
    :root {
      --navy: #0b1220; --ink: #14110f; --gold: #c9a227; --gold-hi: #e8d5a3;
      --ivory: #f7f1e8; --cream: #fffaf3; --muted: #6b6258;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; color: var(--ink);
      font-family: Inter, system-ui, -apple-system, sans-serif;
      background: radial-gradient(900px 420px at 50% -10%, rgba(201,162,39,0.22), transparent 55%),
                  linear-gradient(180deg, #16120e, #0b1220 42%, #14110f);
    }
    .toolbar {
      width: min(210mm, calc(100% - 32px)); margin: 18px auto 0;
      display: flex; justify-content: space-between; align-items: center; gap: 12px;
    }
    .toolbar a, .toolbar button {
      font: inherit; font-size: 13px; font-weight: 700; border-radius: 999px; padding: 10px 16px;
      cursor: pointer; text-decoration: none; display: inline-flex; align-items: center;
    }
    .toolbar a { border: 1px solid rgba(232,213,163,0.4); color: var(--gold-hi); }
    .toolbar .right { display: flex; gap: 8px; }
    .toolbar button { border: 0; background: linear-gradient(90deg, #e8d5a3, #c9a227); color: var(--navy); }
    .notice { width: min(210mm, calc(100% - 32px)); margin: 10px auto 0; color: var(--gold-hi); font-size: 13px; }

    .slip {
      position: relative; width: 210mm; min-height: 148mm; margin: 16px auto 40px;
      background: var(--cream); padding: 8mm 10mm 7mm;
      box-shadow: 0 40px 80px rgba(0,0,0,0.45), 0 0 0 1px rgba(201,162,39,0.35);
      display: flex; flex-direction: column;
    }
    .slip::before, .slip::after { content: ""; position: absolute; pointer-events: none; inset: 5px; border: 1px solid rgba(201,162,39,0.55); }
    .slip::after { inset: 8px; border-color: rgba(11,18,32,0.14); }

    .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; padding-bottom: 5px; border-bottom: 1px solid rgba(201,162,39,0.4); }
    .brand { display: flex; gap: 9px; align-items: center; min-width: 0; }
    .mark {
      width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      background: radial-gradient(circle at 35% 30%, #2a2218, var(--navy)); border: 1px solid var(--gold); color: var(--gold-hi);
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 15px; font-weight: 700; letter-spacing: 0.08em;
    }
    .house { margin: 0; font-family: "Cormorant Garamond", Georgia, serif; font-size: 23px; font-weight: 600; line-height: 1; color: var(--navy); letter-spacing: -0.01em; }
    .tag { margin: 2px 0 0; font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); font-weight: 700; }
    .addr { margin: 3px 0 0; font-size: 9px; color: var(--muted); line-height: 1.35; }
    .addr span { display: block; }
    .doc { text-align: right; flex-shrink: 0; }
    .doc h2 { margin: 0; font-family: "Cormorant Garamond", Georgia, serif; font-size: 17px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--navy); font-weight: 600; }
    .doc dl { margin: 4px 0 0; display: grid; grid-template-columns: auto auto; gap: 1px 10px; font-size: 10px; }
    .doc dt { color: var(--gold); text-transform: uppercase; letter-spacing: 0.12em; font-size: 8px; font-weight: 700; align-self: center; }
    .doc dd { margin: 0; color: var(--navy); font-weight: 600; font-variant-numeric: tabular-nums; }

    .party { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 5px; }
    .k { font-size: 8px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); font-weight: 700; margin-right: 6px; }
    .party strong { font-family: "Cormorant Garamond", Georgia, serif; font-size: 16px; color: var(--navy); font-weight: 600; }
    .party .meta { font-size: 9.5px; color: var(--muted); }

    table.est { width: 100%; border-collapse: collapse; margin-top: 5px; font-size: 10px; font-variant-numeric: lining-nums tabular-nums; font-feature-settings: "lnum" 1, "tnum" 1; }
    table.est th {
      font-size: 7.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--navy); font-weight: 700;
      padding: 4px 6px; background: var(--ivory); border-top: 1px solid rgba(201,162,39,0.55); border-bottom: 1px solid rgba(201,162,39,0.55); text-align: left;
    }
    table.est td { padding: 3px 6px; border-bottom: 1px solid rgba(201,162,39,0.16); color: var(--ink); vertical-align: top; }
    table.est .n { text-align: right; white-space: nowrap; }
    table.est .sl { width: 18px; color: var(--muted); }
    table.est td.desc { font-weight: 600; color: var(--navy); }
    table.est td.desc small { font-weight: 400; color: var(--muted); font-size: 8.5px; margin-left: 4px; }
    table.est tr.sum td { font-weight: 700; color: var(--navy); border-top: 1px solid rgba(11,18,32,0.35); border-bottom: 1px solid rgba(11,18,32,0.35); background: rgba(247,241,232,0.6); }
    table.est tr.head-row td { padding-top: 5px; font-size: 7.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); font-weight: 700; border-bottom: 0; }
    table.est tr.set td.n.neg { color: #6d4a10; }
    table.est tr.close td { border-top: 1.5px solid var(--gold); border-bottom: 1.5px solid var(--gold); padding: 5px 6px; }
    table.est tr.close td.lbl { font-size: 8px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); font-weight: 700; }
    table.est tr.close td.n { font-family: "Cormorant Garamond", Georgia, serif; font-size: 15px; font-weight: 700; color: var(--gold); }
    .state { display: inline-block; margin-left: 6px; padding: 0 6px; border-radius: 999px; font-size: 7.5px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; vertical-align: middle; font-family: Inter, sans-serif; }
    .state.settled { color: #3f5d3a; border: 1px solid rgba(63,93,58,0.4); background: rgba(63,93,58,0.08); }
    .state.due { color: #8a5a12; border: 1px solid rgba(201,162,39,0.5); background: rgba(201,162,39,0.1); }
    .note { margin: 4px 0 0; font-size: 9px; color: var(--muted); }

    .sign { margin-top: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 14px; padding-top: 6px; }
    .sign .line { border-top: 1px solid var(--navy); padding-top: 3px; font-size: 9.5px; color: var(--navy); }
    .sign .line em { display: block; font-style: normal; font-size: 8px; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; }
    .sign .for { text-align: right; }
    .sign .for p { margin: 0 0 18px; font-size: 9px; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
    .stamp { width: 23mm; height: 23mm; transform: rotate(-8deg); opacity: 0.85; }
    .foot { margin-top: 5px; padding-top: 4px; border-top: 1px solid rgba(201,162,39,0.3); display: flex; justify-content: space-between; gap: 10px; font-size: 8px; color: var(--muted); }

    @media print {
      @page { size: A4 portrait; margin: 0; }
      body { background: #fff !important; min-height: 0; }
      .toolbar, .notice { display: none !important; }
      .slip {
        margin: 0; box-shadow: none; width: 210mm; min-height: 148.5mm;
        border-bottom: 1px dashed #b9b0a3;
        print-color-adjust: exact; -webkit-print-color-adjust: exact;
      }
      table.est tr { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <%= link_to '← Estimates', estimates_path %>
    <div class="right">
      <%= link_to 'Edit', edit_estimate_path(est) %>
      <%= link_to 'New estimate', new_estimate_path(customer_id: est.customer_id) %>
      <button type="button" onclick="window.print()">Print estimate</button>
    </div>
  </div>
  <% if flash[:notice].present? %><p class="notice"><%= flash[:notice] %></p><% end %>

  <article class="slip">
    <header class="head">
      <div class="brand">
        <div class="mark" aria-hidden="true"><%= initials %></div>
        <div>
          <h1 class="house"><%= house %></h1>
          <p class="tag"><%= tagline %></p>
          <p class="addr">
            <% if place.present? %><span><%= place %></span><% end %>
            <% line = [contact.presence, papers.presence].compact.join(' · ') %>
            <% if line.present? %><span><%= line %></span><% end %>
          </p>
        </div>
      </div>
      <div class="doc">
        <h2>Rough estimate</h2>
        <dl>
          <dt>Est. No.</dt><dd><%= est.estimate_no %></dd>
          <dt>Date</dt><dd><%= est.estimate_date.strftime('%d/%m/%Y') %></dd>
        </dl>
      </div>
    </header>

    <div class="party">
      <div>
        <span class="k">Estimate for</span>
        <strong><%= est.party_name %></strong>
        <% if est.party_place.present? %><span class="meta"> (<%= est.party_place %>)</span><% end %>
      </div>
      <div class="meta">
        <%= [est.party_phone.present? ? "Ph # #{est.party_phone}" : nil, est.customer&.client_ref].compact.join(' · ') %>
      </div>
    </div>

    <table class="est">
      <thead>
        <tr>
          <th class="sl">#</th>
          <th>Description</th>
          <th class="n">Pc</th>
          <th class="n">Net wt (g)</th>
          <th class="n">Tunch + labour</th>
          <th class="n">Fine (g)</th>
          <th class="n">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% items.each_with_index do |r, i| %>
          <tr>
            <td class="sl"><%= i + 1 %></td>
            <td class="desc"><%= r['description'].presence || 'Piece' %></td>
            <td class="n"><%= r['pcs'] %></td>
            <td class="n"><%= estimate_grams(r['net_mg']) %></td>
            <td class="n"><%= pct.call(r['tunch']) %> + <%= format('%.2f', r['labour'].to_f) %><%= r['labour_on'] == 'g' ? '/g' : '' %></td>
            <td class="n"><%= estimate_grams(r['fine_mg']) %></td>
            <td class="n"><%= estimate_rupees(r['amount_cents']) %></td>
          </tr>
        <% end %>
        <% if items.any? %>
          <tr class="sum">
            <td></td>
            <td>Total</td>
            <td class="n"><%= est.pcs %></td>
            <td class="n"><%= estimate_grams(est.net_mg) %></td>
            <td></td>
            <td class="n"><%= estimate_grams(est.fine_mg) %></td>
            <td class="n"><%= estimate_rupees(est.amount_cents) %></td>
          </tr>
        <% end %>
        <% if has_prev %>
          <tr>
            <td></td>
            <td class="desc" colspan="4">Bal.<% if est.prev_ref.present? %><small>[<%= est.prev_ref %>]</small><% end %></td>
            <td class="n"><%= estimate_grams(est.prev_fine_mg, blank_zero: true) %></td>
            <td class="n"><%= est.prev_amount_cents.to_i.zero? ? '' : estimate_rupees(est.prev_amount_cents) %></td>
          </tr>
          <tr class="sum">
            <td></td>
            <td colspan="4">Net total</td>
            <td class="n"><%= estimate_grams(est.net_total_fine_mg) %></td>
            <td class="n"><%= estimate_rupees(est.net_total_amount_cents) %></td>
          </tr>
        <% end %>
        <% if sets.any? %>
          <tr class="head-row"><td></td><td colspan="6">Settlement</td></tr>
          <% sets.each do |s| %>
            <%
              label = s['description'].presence || Estimate::SETTLEMENT_KINDS[s['kind']]
              detail = case s['kind']
                       when 'bhav' then "@ #{estimate_rupees(Paise.from_rupees(s['rate']))} / 10 g (#{estimate_grams(s['converted_mg'])} × 100.00)"
                       end
            %>
            <tr class="set">
              <td></td>
              <td class="desc"><%= label %><% if detail %><small><%= detail %></small><% end %></td>
              <td></td>
              <td class="n"><%= s['kind'] == 'metal' ? estimate_grams(-s['weight_mg'].to_i) : '' %></td>
              <td class="n"><%= s['kind'] == 'metal' ? pct.call(s['touch']) : '' %></td>
              <td class="n <%= 'neg' if s['fine_mg'].to_i.negative? %>"><%= estimate_grams(s['fine_mg'], blank_zero: true) %></td>
              <td class="n <%= 'neg' if s['amount_cents'].to_i.negative? %>"><%= s['amount_cents'].to_i.zero? ? '' : estimate_rupees(s['amount_cents']) %></td>
            </tr>
          <% end %>
        <% end %>
        <tr class="close">
          <td></td>
          <td class="lbl" colspan="4">
            Closing balance
            <em class="state <%= est.settled? ? 'settled' : 'due' %>"><%= est.settled? ? 'Settled' : 'Open' %></em>
          </td>
          <td class="n"><%= estimate_grams(est.closing_fine_mg, nil_zero: true) %></td>
          <td class="n"><%= estimate_rupees(est.closing_amount_cents, nil_zero: true) %></td>
        </tr>
      </tbody>
    </table>
    <% if est.note.present? %><p class="note">Note: <%= est.note %></p><% end %>

    <section class="sign">
      <div class="line">Client signature<em><%= est.party_name %></em></div>
      <%= render 'shared/house_stamp', house: house, city: city, word: 'ESTIMATE', date: est.estimate_date %>
      <div class="for">
        <p>For <%= house %></p>
        <div class="line"><%= owner || 'Authorised signatory' %><em>Authorised signatory</em></div>
      </div>
    </section>

    <footer class="foot">
      <span>Rough estimate for the client’s reference. Fine in grams of pure metal; not a tax invoice. Prices are subject to the day’s bhav.</span>
      <span><%= printed_at.strftime('%A %d/%m/%Y %I:%M:%S %p') %></span>
    </footer>
  </article>
</body>
</html>
