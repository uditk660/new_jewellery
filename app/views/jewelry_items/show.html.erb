<%= render 'shared/atelier_styles' %>

<%
  per_gram = @item.effective_price_per_gram
  weight = @item.weight_grams.to_f
  qty = @item.valuation_quantity
  unit = @item.unit_amount
  total = @item.catalogue_amount
  in_stock = @item.quantity.to_i > 0
  stocks = @item.metal ? Array(@item.metal.metal_stocks) : []
  rate_source = if @item.purity_price_per_gram.present?
    @item.purity.try(:name)
  elsif per_gram.present?
    'Metal stock'
  end
%>

<div class="atelier-page piece-show <%= 'is-out' unless in_stock %>">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Catalogue piece</p>
      <h1>
        <%= @item.name.presence || 'Untitled piece' %>
        <% unless in_stock %>
          <span class="oos-badge">Out of stock</span>
        <% end %>
      </h1>
      <p class="lead">
        <% if @item.metal || @item.purity %>
          <%= [@item.metal.try(:name), @item.purity.try(:hallmark_label)].compact.join(' · ') %>
        <% else %>
          Hallmark, weight and valuation for this showroom piece.
        <% end %>
      </p>
    </div>
    <div class="piece-hero-actions">
      <%= link_to '← Catalogue', jewelry_items_path(status: (@item.has_attribute?(:archived) && @item.archived? ? 'archived' : (in_stock ? 'available' : 'stock_out'))), class: 'atelier-back' %>
      <% if @item.amendable? %>
        <%= link_to 'Amend piece', edit_jewelry_item_path(@item), class: 'btn-gold' %>
      <% else %>
        <span class="btn-gold is-disabled" aria-disabled="true" title="<%= @item.archived? ? 'Restore this piece to amend it.' : 'Activate the metal to amend this piece.' %>">Amend piece</span>
      <% end %>
      <% if @item.has_attribute?(:archived) %>
        <% if @item.archived? %>
          <%= button_to 'Restore to catalogue', unarchive_jewelry_item_path(@item), method: :post, class: 'atelier-back' %>
        <% else %>
          <%= button_to 'Archive piece', archive_jewelry_item_path(@item), method: :post, class: 'atelier-back', data: { confirm: 'Archive this piece off the live tray?' } %>
        <% end %>
      <% end %>
    </div>
  </header>

  <div class="atelier-grid">
    <div>
      <section class="atelier-form">
        <div class="section">
          <div class="section-head">
            <h2>Metal &amp; hallmark</h2>
            <span class="section-pills">
              <% if @item.archived? %>
                <span class="status-pill is-archived">Archived</span>
              <% end %>
              <% if @item.sale_locked? %>
                <span class="status-pill is-locked">Locked</span>
              <% end %>
            </span>
          </div>
          <p class="hint">The metal and purity that set the rate for this piece.</p>
          <dl class="piece-dl">
            <div><dt>Metal</dt><dd><%= @item.metal.try(:name) || '—' %></dd></div>
            <div><dt>Purity</dt><dd><%= @item.purity.try(:hallmark_label) || '—' %></dd></div>
            <div><dt>Fineness</dt><dd><%= @item.purity.try(:fineness).presence || '—' %></dd></div>
            <div><dt>Standard</dt><dd><%= @item.purity.try(:hallmark_standard).presence || '—' %></dd></div>
            <div><dt>Category</dt><dd><%= @item.jewellery_category.try(:display_name) || '—' %></dd></div>
          </dl>
        </div>

        <div class="section">
          <h2>Piece details</h2>
          <dl class="piece-dl">
            <div><dt>SKU</dt><dd><%= @item.sku.presence || '—' %></dd></div>
            <div>
              <dt>Quantity</dt>
              <dd>
                <% if in_stock %>
                  <%= @item.quantity %> pcs
                <% else %>
                  <span class="oos-badge oos-inline">Out of stock</span>
                <% end %>
              </dd>
            </div>
          </dl>
          <% if @item.description.present? %>
            <p class="hint" style="margin-top:12px; white-space:pre-line"><%= @item.description %></p>
          <% else %>
            <p class="hint" style="margin-top:12px">No description noted for this piece.</p>
          <% end %>
        </div>

        <div class="section">
          <h2>Weight &amp; valuation</h2>
          <p class="hint">Price is purity rate × weight × quantity.</p>
          <dl class="piece-dl">
            <div><dt>Weight</dt><dd><%= '%.2f' % weight %> g</dd></div>
            <div>
              <dt>Hallmark stock</dt>
              <dd>
                <% if @item.purity %>
                  <%= '%.2f' % @item.consumed_grams.to_f %> g taken · <%= @item.purity.available_weight_label %> remain
                <% else %>
                  —
                <% end %>
              </dd>
            </div>
            <div>
              <dt>Rate</dt>
              <dd>
                <% if per_gram.present? %>
                  <%= format_rupees(per_gram) %>/g
                  <span class="muted-inline"><%= rate_source %></span>
                <% else %>
                  No rate set
                <% end %>
              </dd>
            </div>
            <div><dt>Per piece</dt><dd class="price-dd"><%= format_rupees(unit) %></dd></div>
            <div><dt>Catalogue</dt><dd class="price-dd"><%= format_rupees(total) %></dd></div>
          </dl>
          <% if per_gram.present? %>
            <p class="formula">
              <%= format_rupees(per_gram) %>/g × <%= '%.2f' % weight %> g × <%= qty %> pcs = <%= format_rupees(total) %>
            </p>
          <% end %>
        </div>

        <% if stocks.any? %>
          <div class="section">
            <h2>Showroom metal stock</h2>
            <p class="hint">Available <%= @item.metal.name.downcase %> across stores — not this piece’s own count.</p>
            <ul class="stock-list">
              <% stocks.each do |stock| %>
                <li>
                  <%= link_to metal_stock_path(stock) do %>
                    <span><%= stock.store.try(:name) || 'Store' %></span>
                    <strong><%= stock.available_grams.to_i %> g</strong>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </section>
    </div>

    <aside class="preview <%= 'is-out' unless in_stock %>" aria-label="Showroom card">
      <% unless in_stock %>
        <div class="oos-banner" role="status">Out of stock</div>
      <% end %>
      <p class="preview-kicker">Showroom card</p>
      <div class="gem" aria-hidden="true">💍</div>
      <h2><%= @item.name.presence || 'Catalogue piece' %></h2>
      <span class="sku-chip">SKU <%= @item.sku.presence || '—' %></span>
      <div class="chips">
        <span class="chip">Metal <strong><%= @item.metal.try(:name) || '—' %></strong></span>
        <span class="chip">Purity <strong><%= @item.purity.try(:name) || '—' %></strong></span>
        <span class="chip">Category <strong><%= @item.jewellery_category.try(:name) || '—' %></strong></span>
        <span class="chip">Wt <strong><%= '%.2f' % weight %> g</strong></span>
      </div>
      <div class="preview-price"><%= format_rupees(total) %></div>
      <div class="preview-desc">
        <% if in_stock && qty > 1 && unit.positive? %>
          <%= format_rupees(unit) %> each · <%= qty %> pcs
        <% elsif in_stock %>
          <%= @item.quantity %> in the tray
        <% else %>
          This piece is not on the tray.
        <% end %>
      </div>
      <p class="preview-note"><%= in_stock ? 'Ready for the counter.' : 'Restore quantity when it returns to the showroom.' %></p>
    </aside>
  </div>
</div>

<style>
  .piece-show .piece-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .piece-show .piece-hero-actions form { margin: 0; }
  .piece-show .piece-hero-actions button.atelier-back { cursor: pointer; font-family: inherit; }
  .piece-show .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 4px;
  }
  .piece-show .section-head h2 { margin: 0; }
  .piece-show .status-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    flex-shrink: 0;
  }
  .piece-show .section-pills {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    margin-left: auto;
  }
  .piece-show .status-pill.is-archived {
    background: #6b6258;
    color: #f7f1e8;
    border: 1px solid rgba(107,98,88,0.5);
  }
  .piece-show .status-pill.is-locked {
    background: #5c1c16;
    color: #f3e0a8;
    border: 1px solid #c9a227;
  }
  .piece-show a.btn-gold { text-decoration: none; display: inline-flex; align-items: center; }
  .piece-show .btn-gold.is-disabled {
    display: inline-flex;
    align-items: center;
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }
  .piece-show h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .piece-show .oos-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    background: #5c1c16;
    color: #f3e0a8;
    border: 1px solid #c9a227;
    box-shadow: 0 0 0 3px rgba(201,162,39,0.22), 0 8px 18px rgba(92,28,22,0.28);
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    vertical-align: middle;
    animation: oos-glow 1.8s ease-in-out infinite;
  }
  .piece-show .oos-badge::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8d5a3;
    box-shadow: 0 0 0 3px rgba(232,213,163,0.28);
  }
  .piece-show .oos-inline {
    font-size: 11px;
  }
  .piece-show .preview.is-out {
    border-color: #c9a227;
    box-shadow: 0 24px 50px rgba(92, 28, 22, 0.28);
  }
  .piece-show .oos-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: -6px -6px 16px;
    padding: 10px 14px;
    border-radius: 12px;
    background: linear-gradient(90deg, #6b241c, #3a1410);
    color: #e8d5a3;
    border: 1px solid #c9a227;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    animation: oos-glow 1.8s ease-in-out infinite;
  }
  .piece-show .oos-banner::before,
  .piece-show .oos-banner::after {
    content: '';
    width: 18px;
    height: 1px;
    background: #c9a227;
  }
  @keyframes oos-glow {
    0%, 100% { box-shadow: 0 0 0 3px rgba(201,162,39,0.16), 0 8px 18px rgba(92,28,22,0.22); }
    50% { box-shadow: 0 0 0 6px rgba(201,162,39,0.32), 0 10px 22px rgba(92,28,22,0.34); }
  }
  @media (prefers-reduced-motion: reduce) {
    .piece-show .oos-badge,
    .piece-show .oos-banner { animation: none; }
  }
  .piece-show .piece-dl { margin: 0; }
  .piece-show .piece-dl > div {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(201,162,39,0.16);
  }
  .piece-show .piece-dl dt {
    color: #6b6258;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .piece-show .piece-dl dd { margin: 0; color: #14110f; }
  .piece-show .price-dd { color: #c9a227; font-weight: 700; }
  .piece-show .muted-inline { color: #6b6258; font-weight: 500; font-size: 12px; margin-left: 6px; }
  .piece-show .formula {
    margin: 12px 0 0;
    padding: 10px 12px;
    background: #fff;
    border: 1px solid rgba(201,162,39,0.22);
    border-radius: 10px;
    color: #6b6258;
    font-size: 13px;
  }
  .piece-show .stock-list { list-style: none; margin: 0; padding: 0; }
  .piece-show .stock-list li {
    padding: 0;
    border-bottom: 1px solid rgba(201,162,39,0.16);
    font-size: 14px;
  }
  .piece-show .stock-list a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    text-decoration: none;
    color: inherit;
  }
  .piece-show .stock-list a:hover strong { color: #c9a227; }
  @media (max-width: 880px) {
    .piece-show .piece-dl > div { grid-template-columns: 1fr; }
    .piece-show .piece-hero-actions { width: 100%; }
  }
</style>
