<%= render 'shared/atelier_styles' %>

<%
  purity = @item.purity
  per_gram = @item.effective_price_per_gram.to_f
  allocated_grams = (@item.weight_grams_in_database.to_f * @item.quantity_in_database.to_i)
  remaining_on_hallmark = purity ? purity.available_grams.to_f : 0
  usable_grams = remaining_on_hallmark + allocated_grams
%>

<div class="atelier-page piece-edit">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Catalogue piece</p>
      <h1>Amend this piece</h1>
      <p class="lead">You may change the piece name, description, weight and tray count. Metal, hallmark, category and SKU stay as registered.</p>
    </div>
    <div class="piece-hero-actions">
      <%= link_to '← Piece', jewelry_item_path(@item), class: 'atelier-back' %>
      <%= link_to 'Catalogue', jewelry_items_path, class: 'atelier-back' %>
    </div>
  </header>

  <div class="steps" aria-hidden="true">
    <span class="step"><b>1</b> House details</span>
    <span class="step"><b>2</b> Name &amp; notes</span>
    <span class="step"><b>3</b> Weight &amp; tray</span>
  </div>

  <div class="atelier-grid">
    <div class="atelier-form">
      <%= form_for @item, url: jewelry_item_path(@item), method: :put do |f| %>
        <% if @item.errors.any? %>
          <div class="errors"><%= @item.errors.full_messages.to_sentence %></div>
        <% end %>

        <section class="section">
          <h2>House details</h2>
          <p class="hint">These were set when the piece was registered and cannot be amended here.</p>
          <dl class="piece-dl">
            <div><dt>Metal</dt><dd><%= @item.metal.try(:name) || '—' %></dd></div>
            <div><dt>Purity</dt><dd><%= purity.try(:hallmark_label) || '—' %></dd></div>
            <div><dt>Category</dt><dd><%= @item.jewellery_category.try(:display_name) || '—' %></dd></div>
            <div><dt>SKU</dt><dd><%= @item.sku.presence || '—' %></dd></div>
          </dl>
        </section>

        <section class="section">
          <h2>Piece details</h2>
          <p class="hint">Name how it should appear on invoices and the showroom catalogue.</p>
          <div class="row">
            <div class="field">
              <%= f.label :name do %>Piece name <span class="req">*</span><% end %>
              <%= f.text_field :name, class: 'form-control', placeholder: 'e.g. 22K temple necklace' %>
            </div>
          </div>
          <div class="row" style="margin-top:12px">
            <div class="field">
              <%= f.label :description, 'Description' %>
              <%= f.text_area :description, rows: 4, class: 'form-control', placeholder: 'Setting, stones, occasion or making notes' %>
            </div>
          </div>
        </section>

        <section class="section">
          <h2>Weight &amp; tray</h2>
          <p class="hint">Changing weight or quantity adjusts this hallmark’s remaining house stock. Price is calculated and cannot be typed.</p>
          <div class="row">
            <div class="field">
              <%= f.label :weight_grams do %>Weight (g) <span class="req">*</span><% end %>
              <%= f.number_field :weight_grams, step: 0.01, min: 0.01, class: 'form-control', placeholder: ('%.2f' % usable_grams) %>
              <p class="hint" id="weight-available-hint" style="margin:8px 0 0">
                Available now: <%= '%.2f' % usable_grams %> g. You may enter up to this weight.
              </p>
            </div>
            <div class="field narrow">
              <%= f.label :quantity do %>Quantity (pcs) <span class="req">*</span><% end %>
              <%= f.number_field :quantity, step: 1, min: 0, class: 'form-control' %>
            </div>
          </div>
          <div class="row" style="margin-top:12px">
            <div class="field">
              <%= f.label :price_cents, 'Catalogue price (₹)' %>
              <%= text_field_tag 'price_rupees', (@item.catalogue_amount.positive? ? ('%.2f' % @item.catalogue_amount) : ''), class: 'form-control', id: 'price_rupees', placeholder: 'Calculated', readonly: true, tabindex: -1 %>
              <p class="hint" id="price-formula" style="margin:8px 0 0">
                <% if per_gram.positive? %>
                  <%= format_rupees(per_gram) %>/g × <%= '%.2f' % @item.weight_grams.to_f %> g × <%= @item.valuation_quantity %> pcs
                <% else %>
                  No rate on this hallmark. Set today’s rate first.
                <% end %>
              </p>
            </div>
          </div>
        </section>

        <div class="actions">
          <%= f.submit 'Save piece', class: 'btn-gold', id: 'catalogue-submit' %>
          <%= link_to 'Cancel', jewelry_item_path(@item), class: 'atelier-back' %>
        </div>
      <% end %>
    </div>

    <aside class="preview" aria-live="polite">
      <p class="preview-kicker">Showroom preview</p>
      <div class="gem" aria-hidden="true">💍</div>
      <h2 id="preview-title"><%= @item.name.presence || 'Catalogue piece' %></h2>
      <span class="sku-chip">SKU <span id="preview-sku"><%= @item.sku.presence || '—' %></span></span>
      <div class="chips">
        <span class="chip">Metal <strong><%= @item.metal.try(:name) || '—' %></strong></span>
        <span class="chip">Purity <strong><%= purity.try(:name) || '—' %></strong></span>
        <span class="chip">Category <strong><%= @item.jewellery_category.try(:name) || '—' %></strong></span>
        <span class="chip">Wt <strong id="preview-weight"><%= sprintf('%.2f', @item.weight_grams.to_f) %> g</strong></span>
      </div>
      <div id="preview-price" class="preview-price"><%= format_rupees(@item.catalogue_amount) %></div>
      <div id="preview-desc" class="preview-desc"><%= @item.description.presence || 'Description will appear here as you type.' %></div>
      <p class="preview-note">Metal, hallmark and SKU remain as registered. Saving updates name, notes, weight and tray count.</p>
    </aside>
  </div>
</div>

<style>
  .piece-edit .piece-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .piece-edit .piece-dl { margin: 0; }
  .piece-edit .piece-dl > div {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(201,162,39,0.16);
  }
  .piece-edit .piece-dl dt {
    color: #6b6258;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .piece-edit .piece-dl dd { margin: 0; color: #14110f; }
  @media (max-width: 880px) {
    .piece-edit .piece-hero-actions { width: 100%; }
    .piece-edit .piece-dl > div { grid-template-columns: 1fr; }
  }
</style>

<script>
  window.addReadyListener = function(fn){
    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', fn);
    } else { fn(); }
    if(typeof Turbolinks !== 'undefined') document.addEventListener('turbolinks:load', fn);
    if(typeof Turbo !== 'undefined') document.addEventListener('turbo:load', fn);
  };

  (function(){
    const PURITY = <%= {
      id: purity.try(:id),
      name: purity.try(:hallmark_label) || purity.try(:name) || 'this hallmark',
      per_gram_price: per_gram,
      usable_grams: usable_grams
    }.to_json.html_safe %>;

    addReadyListener(function(){
      const form = document.querySelector('.atelier-page form');
      const nameEl = document.querySelector('input[name="jewelry_item[name]"]');
      const descEl = document.querySelector('textarea[name="jewelry_item[description]"]');
      const qtyEl = document.querySelector('input[name="jewelry_item[quantity]"]');
      const weightEl = document.querySelector('input[name="jewelry_item[weight_grams]"]');
      const priceRupeesEl = document.getElementById('price_rupees');
      const submitEl = document.getElementById('catalogue-submit');
      if(!form) return;

      function rupee(n){
        const v = parseFloat(n);
        if(isNaN(v)) return '₹0.00';
        return '\u20B9' + v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
      function stockQuantity(){
        const q = parseFloat((qtyEl && qtyEl.value) || '');
        if(isNaN(q) || q < 0) return 0;
        return q;
      }
      function priceQuantity(){
        const q = stockQuantity();
        return q < 1 ? 1 : q;
      }
      function remaining(){
        return parseFloat(PURITY.usable_grams || 0);
      }
      function updatePreview(){
        const previewTitle = document.getElementById('preview-title');
        const previewWeight = document.getElementById('preview-weight');
        const previewDesc = document.getElementById('preview-desc');
        if(previewTitle && nameEl) previewTitle.textContent = nameEl.value || 'Catalogue piece';
        if(previewDesc && descEl) previewDesc.innerHTML = (descEl.value || 'Description will appear here as you type.').replace(/\n/g,'<br>');
        if(previewWeight && weightEl) previewWeight.textContent = (parseFloat(weightEl.value || 0)).toFixed(2) + ' g';
      }
      function updateWeightHint(){
        const weightHint = document.getElementById('weight-available-hint');
        if(!weightHint) return;
        const avail = remaining();
        const weight = parseFloat((weightEl && weightEl.value) || 0);
        const needed = (isNaN(weight) ? 0 : weight) * stockQuantity();
        if(avail <= 0){
          weightHint.textContent = 'No grams currently available on ' + PURITY.name + '.';
          weightHint.style.color = '#7f1d1d';
        } else if(needed > avail + 0.0001){
          weightHint.textContent = 'Available now: ' + avail.toFixed(2) + ' g. Enter a weight up to this amount.';
          weightHint.style.color = '#7f1d1d';
        } else {
          weightHint.textContent = 'Available now: ' + avail.toFixed(2) + ' g. You may enter up to this weight.';
          weightHint.style.color = '';
        }
      }
      function requiredFilled(){
        const nameOk = !!(nameEl && nameEl.value.trim());
        const weight = parseFloat(weightEl && weightEl.value);
        const weightOk = !isNaN(weight) && weight > 0;
        const qty = parseInt(qtyEl && qtyEl.value, 10);
        const qtyOk = !isNaN(qty) && qty >= 0;
        if(!(nameOk && weightOk && qtyOk)) return false;
        const needed = weight * (qty < 1 ? 0 : qty);
        return needed <= remaining() + 0.0001;
      }
      function syncSubmit(){
        if(submitEl) submitEl.disabled = !requiredFilled();
      }
      function compute(){
        updatePreview();
        updateWeightHint();
        syncSubmit();
        const perGram = parseFloat(PURITY.per_gram_price || 0);
        const weight = parseFloat((weightEl && weightEl.value) || 0);
        const qty = priceQuantity();
        const wt = isNaN(weight) ? 0 : weight;
        const total = perGram * wt * qty;
        if(priceRupeesEl) priceRupeesEl.value = total.toFixed(2);
        const previewPrice = document.getElementById('preview-price');
        if(previewPrice) previewPrice.textContent = rupee(total);
        const formula = document.getElementById('price-formula');
        if(formula){
          if(!(perGram > 0)){
            formula.textContent = 'No rate on this hallmark. Set today’s rate first.';
          } else {
            formula.textContent = rupee(perGram) + '/g × ' + wt.toFixed(2) + ' g × ' + qty + ' pcs = ' + rupee(total);
          }
        }
      }

      [nameEl, descEl, weightEl, qtyEl].forEach(function(el){
        if(!el) return;
        el.addEventListener('input', compute);
        el.addEventListener('change', compute);
      });
      form.addEventListener('submit', function(e){
        if(!requiredFilled()) e.preventDefault();
      });
      compute();
    });
  })();
</script>
