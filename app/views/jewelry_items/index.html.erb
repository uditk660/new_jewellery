<%= render 'shared/atelier_styles' %>

<%
  items = @items || []
  line_price = lambda do |item|
    item.respond_to?(:stock_amount) ? item.stock_amount.to_f : 0.0
  end
  tray_value = items.sum { |it| line_price.call(it) }
  q = params[:q].to_s
  status = @status.presence || 'all'
  counts = @status_counts || {}
  tab_path = lambda do |key|
    jewelry_items_path(request.query_parameters.merge(status: key, page: 1))
  end
  sort_for = lambda do |key, label|
    next_dir = (params[:sort] == key && params[:direction] != 'asc') ? 'asc' : 'desc'
    active = params[:sort] == key
    arrow = active ? (params[:direction] == 'asc' ? ' ↑' : ' ↓') : ''
    link_to "#{label}#{arrow}", jewelry_items_path(request.query_parameters.merge(sort: key, direction: next_dir, page: 1)), class: (active ? 'sort-link is-active' : 'sort-link')
  end
  empty_copy = case status
               when 'stock_out'
                 { eyebrow: 'Stock out', title: 'None out of stock', hint: 'Every live piece still has quantity on the tray.' }
               when 'archived'
                 { eyebrow: 'Archive', title: 'No archived pieces', hint: 'Archive a piece from its page to keep it off the live tray.' }
               when 'locked'
                 { eyebrow: 'Locked', title: 'No locked pieces', hint: 'Pieces appear here when their metal or hallmark is inactive.' }
               when 'available'
                 { eyebrow: 'Empty tray', title: 'No pieces available', hint: 'Register a piece — metal, hallmark and weight — to open the showroom tray.' }
               else
                 { eyebrow: 'Catalogue', title: 'No live pieces', hint: 'Register a piece — metal, hallmark and weight — to open the showroom.' }
               end
%>

<div class="atelier-page catalogue-index">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Showroom</p>
      <h1>Catalogue</h1>
      <p class="lead">Every piece on the tray — metal, hallmark, weight and valuation at a glance.</p>
    </div>
    <%= link_to 'Register a piece', new_jewelry_item_path, class: 'btn-gold' %>
  </header>

  <nav class="cat-tabs" aria-label="Catalogue">
    <%= link_to tab_path.call('all'), class: (status == 'all' ? 'is-active' : nil) do %>
      All <em><%= counts['all'].to_i %></em>
    <% end %>
    <%= link_to tab_path.call('available'), class: (status == 'available' ? 'is-active' : nil) do %>
      Available <em><%= counts['available'].to_i %></em>
    <% end %>
    <%= link_to tab_path.call('stock_out'), class: (status == 'stock_out' ? 'is-active' : nil) do %>
      Stock Out <em><%= counts['stock_out'].to_i %></em>
    <% end %>
    <%= link_to tab_path.call('archived'), class: (status == 'archived' ? 'is-active' : nil) do %>
      Archived <em><%= counts['archived'].to_i %></em>
    <% end %>
    <%= link_to tab_path.call('locked'), class: (status == 'locked' ? 'is-active' : nil) do %>
      Locked <em><%= counts['locked'].to_i %></em>
    <% end %>
  </nav>

  <div class="cat-toolbar">
    <%= form_tag jewelry_items_path, method: :get, class: 'cat-search' do %>
      <%= hidden_field_tag :status, status %>
      <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
      <%= hidden_field_tag :direction, params[:direction] if params[:direction].present? %>
      <%= text_field_tag :q, q, class: 'form-control', placeholder: 'Search name, SKU, metal, purity or category' %>
      <button type="submit" class="atelier-back">Search</button>
      <% if q.present? %>
        <%= link_to 'Clear', jewelry_items_path(status: status), class: 'atelier-back' %>
      <% end %>
    <% end %>
    <div class="cat-stats">
      <div>
        <span>Pieces</span>
        <strong><%= @total_count || items.size %></strong>
      </div>
      <div>
        <span>Tray value</span>
        <strong class="gold"><%= format_rupees(tray_value) %></strong>
      </div>
    </div>
  </div>

  <% if items.any? %>
    <div class="cat-table-wrap">
      <table class="cat-table">
        <thead>
          <tr>
            <th>Piece</th>
            <th class="col-status">Status</th>
            <th>Metal &amp; hallmark</th>
            <th class="col-weight"><%= sort_for.call('weight', 'Weight/Each') %></th>
            <th class="col-price"><%= sort_for.call('price', 'Price') %></th>
            <th class="col-tray"><%= sort_for.call('available', 'Tray') %></th>
          </tr>
        </thead>
        <tbody>
          <% items.each do |item| %>
            <% qty = item.quantity.to_i %>
            <% price = line_price.call(item) %>
            <tr>
              <td>
                <%= link_to jewelry_item_path(item), class: 'piece-link' do %>
                  <span class="gem-dot" aria-hidden="true">💍</span>
                  <span>
                    <strong><%= item.name %></strong>
                    <span class="sku"><%= item.sku %></span>
                    <% if item.jewellery_category %>
                      <span class="sub"><%= item.jewellery_category.name %></span>
                    <% end %>
                  </span>
                <% end %>
              </td>
              <td class="col-status">
                <% if item.sale_locked? %>
                  <span class="status-pill is-locked">Locked</span>
                <% else %>
                  <span class="status-pill is-active">Active</span>
                <% end %>
              </td>
              <td>
                <div class="marks">
                  <% if item.metal %><span class="mark"><%= item.metal.name %></span><% end %>
                  <% if item.purity %><span class="mark gold-mark"><%= item.purity.name %></span><% end %>
                  <% if item.metal.blank? && item.purity.blank? %>—<% end %>
                </div>
              </td>
              <td class="col-weight">
                <span class="wt"><span class="wt-val"><%= '%.2f' % item.weight_grams.to_f %></span><span class="wt-unit">g</span></span>
              </td>
              <td class="col-price price">
                <%= format_rupees(price) %>
                <% if item.effective_price_per_gram.present? %>
                  <span class="rate-line"><%= format_rupees(item.effective_price_per_gram) %>/g</span>
                <% end %>
              </td>
              <td class="col-tray">
                <% if qty > 0 %>
                  <span class="stock in"><%= qty %> pcs</span>
                <% else %>
                  <span class="stock out">Out of tray</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @page && @per_page && (@total_count.to_i > @per_page) %>
      <div class="cat-pager">
        <% if @page > 1 %>
          <%= link_to '← Previous', jewelry_items_path(request.query_parameters.merge(page: @page - 1)), class: 'atelier-back' %>
        <% end %>
        <span>Page <%= @page %></span>
        <% if (@page * @per_page) < @total_count.to_i %>
          <%= link_to 'Next →', jewelry_items_path(request.query_parameters.merge(page: @page + 1)), class: 'atelier-back' %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="atelier-form empty">
      <p class="eyebrow"><%= empty_copy[:eyebrow] %></p>
      <h2><%= q.present? ? 'No matches' : empty_copy[:title] %></h2>
      <p class="hint">
        <% if q.present? %>
          Nothing matches “<%= q %>” in this list. Try another name, SKU or metal.
        <% else %>
          <%= empty_copy[:hint] %>
        <% end %>
      </p>
      <div class="actions" style="margin-top:16px">
        <% if q.present? %>
          <%= link_to 'Clear search', jewelry_items_path(status: status), class: 'atelier-back' %>
        <% elsif status == 'available' || status == 'all' %>
          <%= link_to 'Register a piece', new_jewelry_item_path, class: 'btn-gold' %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<style>
  .catalogue-index .atelier-hero {
    background: transparent;
    color: #14110f;
  }
  .catalogue-index .eyebrow { color: #c9a227; }
  .catalogue-index h1 { color: #0b1220; }
  .catalogue-index .lead { color: #6b6258; }
  .catalogue-index .cat-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: -6px 0 16px;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid rgba(201,162,39,0.4);
    background: #fff;
  }
  .catalogue-index .cat-tabs a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    color: #6b6258;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .catalogue-index .cat-tabs a em {
    font-style: normal;
    min-width: 1.4em;
    padding: 1px 7px;
    border-radius: 999px;
    background: #f7f1e8;
    color: #0b1220;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .catalogue-index .cat-tabs a.is-active {
    background: linear-gradient(90deg, #e8d5a3, #c9a227);
    color: #0b1220;
  }
  .catalogue-index .cat-tabs a.is-active em {
    background: rgba(11,18,32,0.12);
  }
  .catalogue-index a.btn-gold,
  .catalogue-index a.btn-gold:visited,
  .catalogue-index a.btn-gold:hover {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    background: linear-gradient(90deg, #e8d5a3, #c9a227);
    color: #0b1220;
    -webkit-text-fill-color: #0b1220;
  }
  .catalogue-index .cat-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    margin-bottom: 18px;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid rgba(201, 162, 39, 0.28);
    border-radius: 18px;
    box-shadow: 0 12px 28px rgba(20, 17, 15, 0.05);
  }
  .catalogue-index .cat-search { display: flex; gap: 8px; align-items: center; flex: 1; min-width: 0; }
  .catalogue-index .cat-search .form-control { max-width: 420px; }
  .catalogue-index button.atelier-back { cursor: pointer; font-family: inherit; }
  .catalogue-index .cat-stats { display: flex; gap: 22px; flex-shrink: 0; }
  .catalogue-index .cat-stats span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6258;
    font-weight: 700;
  }
  .catalogue-index .cat-stats strong {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.45rem;
    font-weight: 600;
    color: #0b1220;
  }
  .catalogue-index .cat-stats strong.gold { color: #c9a227; }
  .catalogue-index .cat-table-wrap {
    background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.28);
    border-radius: 18px;
    overflow: auto;
    box-shadow: 0 18px 40px rgba(20,17,15,0.06);
  }
  .catalogue-index .cat-table { width: 100%; min-width: 920px; border-collapse: collapse; table-layout: fixed; }
  .catalogue-index .cat-table th {
    text-align: left;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6258;
    font-weight: 700;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(201,162,39,0.22);
    background: #f7f1e8;
  }
  .catalogue-index .cat-table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(201,162,39,0.12);
    vertical-align: middle;
    font-size: 14px;
    color: #14110f;
  }
  .catalogue-index .cat-table th:nth-child(1),
  .catalogue-index .cat-table td:nth-child(1) { width: 32%; }
  .catalogue-index .cat-table th:nth-child(3),
  .catalogue-index .cat-table td:nth-child(3) { width: 22%; }
  .catalogue-index .cat-table th.col-weight,
  .catalogue-index .cat-table td.col-weight {
    width: 118px;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .catalogue-index .cat-table th.col-price,
  .catalogue-index .cat-table td.col-price {
    width: 128px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .catalogue-index .cat-table th.col-tray,
  .catalogue-index .cat-table td.col-tray {
    width: 110px;
    text-align: right;
  }
  .catalogue-index .cat-table th.col-status,
  .catalogue-index .cat-table td.col-status {
    width: 86px;
    text-align: left;
    white-space: nowrap;
  }
  .catalogue-index .wt {
    display: inline-flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 6px;
    min-width: 88px;
  }
  .catalogue-index .wt-val {
    display: inline-block;
    min-width: 6.5ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }
  .catalogue-index .wt-unit {
    display: inline-block;
    min-width: 1em;
    text-align: left;
    color: #6b6258;
    font-size: 12px;
    font-weight: 600;
  }
  .catalogue-index .cat-table tbody tr:last-child td { border-bottom: 0; }
  .catalogue-index .cat-table tbody tr { transition: background 140ms ease; }
  .catalogue-index .cat-table tbody tr:hover { background: rgba(232,213,163,0.22); }
  .catalogue-index .sort-link { color: #6b6258; text-decoration: none; }
  .catalogue-index .col-weight .sort-link,
  .catalogue-index .col-price .sort-link,
  .catalogue-index .col-tray .sort-link { display: block; text-align: right; }
  .catalogue-index .sort-link.is-active { color: #0b1220; }
  .catalogue-index .piece-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .catalogue-index .gem-dot {
    width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(160deg, #2a2218, #12151c);
    border: 1px solid rgba(201,162,39,0.28);
    font-size: 18px;
  }
  .catalogue-index .piece-link strong {
    display: block;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #0b1220;
  }
  .catalogue-index .status-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .catalogue-index .status-pill.is-active {
    background: #3f5d3a;
    color: #eef6e8;
    border: 1px solid rgba(63,93,58,0.55);
  }
  .catalogue-index .status-pill.is-locked {
    background: #5c1c16;
    color: #f3e0a8;
    border: 1px solid #c9a227;
  }
  .catalogue-index .sku {
    display: inline-block;
    margin-top: 2px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #6b6258;
    text-transform: uppercase;
  }
  .catalogue-index .sub { display: block; margin-top: 2px; font-size: 12px; color: #6b6258; }
  .catalogue-index .marks { display: flex; flex-wrap: wrap; gap: 6px; }
  .catalogue-index .mark {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(201,162,39,0.28);
    background: #fff;
    font-size: 12px;
    font-weight: 600;
  }
  .catalogue-index .gold-mark { background: linear-gradient(90deg, #e8d5a3, #c9a227); color: #0b1220; border-color: transparent; }
  .catalogue-index .price {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #c9a227;
    white-space: nowrap;
  }
  .catalogue-index .rate-line {
    display: block;
    margin-top: 2px;
    font-family: Inter, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #6b6258;
  }
  .catalogue-index .stock {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .catalogue-index .stock.in { background: #0b1220; color: #e8d5a3; }
  .catalogue-index .stock.out { background: #f3eee6; color: #6b6258; }
  .catalogue-index .cat-pager {
    display: flex; align-items: center; gap: 12px; margin-top: 16px; color: #6b6258; font-size: 13px;
  }
  .catalogue-index .empty h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.6rem; margin: 0 0 8px; font-weight: 600;
  }
  @media (max-width: 900px) {
    .catalogue-index .cat-toolbar { flex-direction: column; align-items: stretch; }
    .catalogue-index .cat-search { flex-wrap: wrap; }
    .catalogue-index .cat-search .form-control { max-width: none; }
    .catalogue-index .cat-table th.col-weight,
    .catalogue-index .cat-table td.col-weight { display: none; }
  }
</style>
