<%= render 'shared/atelier_styles' %>

<div class="atelier-page">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Catalogue</p>
      <h1>Register a new piece</h1>
      <p class="lead">Choose metal and hallmark first. Weight and quantity set the live valuation for this jewellery item.</p>
    </div>
    <%= link_to '← Catalogue', jewelry_items_path, class: 'atelier-back' %>
  </header>

  <div class="steps" aria-hidden="true">
    <span class="step"><b>1</b> Metal, purity &amp; category</span>
    <span class="step"><b>2</b> Piece details</span>
    <span class="step"><b>3</b> Weight &amp; valuation</span>
  </div>

  <div class="atelier-grid">
    <div class="atelier-form">
      <%= form_for @item, url: jewelry_items_path do |f| %>
        <% if @item.errors.any? %>
          <div class="errors"><%= @item.errors.full_messages.to_sentence %></div>
        <% end %>

        <section class="section">
          <h2>Metal &amp; hallmark</h2>
          <p class="hint">Purity and category lists belong to the metal you pick. Gold can offer 18K, 20K and 22K.</p>
          <div class="row">
            <div class="field">
              <%= f.label :metal_id, 'Metal' %>
              <%= f.collection_select :metal_id, (@metals || []), :id, :name, { include_blank: 'Select metal' }, { class: 'form-control' } %>
            </div>
            <div class="field">
              <%= f.label :purity_id, 'Purity / hallmark' %>
              <%= f.collection_select :purity_id, (@purities || []), :id, :hallmark_label, { include_blank: 'Select purity' }, { class: 'form-control' } %>
            </div>
            <div class="field">
              <%= f.label :jewellery_category_id, 'Category' %>
              <%= f.collection_select :jewellery_category_id, (@categories || []), :id, :display_name, { include_blank: 'Select category' }, { class: 'form-control' } %>
            </div>
          </div>
        </section>

        <section class="section">
          <h2>Piece details</h2>
          <p class="hint">Name how it should appear on invoices and the showroom catalogue.</p>
          <div class="row">
            <div class="field">
              <%= f.label :name, 'Piece name' %>
              <%= f.text_field :name, class: 'form-control', placeholder: 'e.g. 22K temple necklace' %>
            </div>
          </div>
          <div class="row" style="margin-top:12px">
            <div class="field">
              <%= f.label :description, 'Description' %>
              <%= f.text_area :description, rows: 4, class: 'form-control', placeholder: 'Setting, stones, occasion or making notes' %>
            </div>
          </div>
          <div class="row" style="margin-top:12px">
            <div class="field">
              <%= f.label :sku, 'SKU' %>
              <%= f.text_field :sku, class: 'form-control', readonly: true %>
            </div>
            <div class="field narrow">
              <%= f.label :quantity, 'Quantity (pcs)' %>
              <%= f.number_field :quantity, step: 1, min: 0, class: 'form-control' %>
            </div>
          </div>
        </section>

        <section class="section">
          <h2>Weight &amp; valuation</h2>
          <p class="hint">Price is calculated as purity rate × weight × quantity. It cannot be typed by hand.</p>
          <div class="row">
            <div class="field narrow">
              <%= f.label :weight_grams, 'Weight (g)' %>
              <%= f.number_field :weight_grams, step: 0.01, class: 'form-control', placeholder: '0.00' %>
            </div>
            <div class="field">
              <%= f.label :price_cents, 'Catalogue price (₹)' %>
              <%= text_field_tag 'price_rupees', (@item.price.present? ? ('%.2f' % @item.price) : ''), class: 'form-control', id: 'price_rupees', placeholder: 'Calculated', readonly: true %>
              <%= f.hidden_field :price_cents, id: 'price_cents_hidden' %>
            </div>
          </div>
        </section>

        <div class="actions">
          <%= f.submit 'Add to catalogue', class: 'btn-gold' %>
        </div>
      <% end %>
    </div>

    <aside class="preview" aria-live="polite">
      <p class="preview-kicker">Showroom preview</p>
      <div class="gem" aria-hidden="true">💍</div>
      <h2 id="preview-title"><%= @item.name.presence || 'New piece' %></h2>
      <span class="sku-chip">SKU <span id="preview-sku"><%= @item.sku.presence || '—' %></span></span>
      <div class="chips">
        <span class="chip">Metal <strong id="preview-metal">—</strong></span>
        <span class="chip">Purity <strong id="preview-purity">—</strong></span>
        <span class="chip">Category <strong id="preview-category">—</strong></span>
        <span class="chip">Wt <strong id="preview-weight"><%= sprintf('%.2f', @item.weight_grams.to_f) %> g</strong></span>
      </div>
      <div id="preview-price" class="preview-price"><%= @item.price.present? ? "₹#{'%.2f' % @item.price}" : '₹ —' %></div>
      <div id="preview-desc" class="preview-desc"><%= @item.description.presence || 'Description will appear here as you type.' %></div>
      <p class="preview-note">This card is how the piece reads to staff before it is saved to the catalogue.</p>
    </aside>
  </div>
</div>

<script>
  window.addReadyListener = function(fn){
    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', fn);
    } else { fn(); }
    if(typeof Turbolinks !== 'undefined') document.addEventListener('turbolinks:load', fn);
    if(typeof Turbo !== 'undefined') document.addEventListener('turbo:load', fn);
  };

  (function(){
      addReadyListener(function(){
        const form = document.querySelector('.atelier-page form');
        if(!form) return;
        const metalEl = document.querySelector('select[name="jewelry_item[metal_id]"]');
        const purityEl = document.querySelector('select[name="jewelry_item[purity_id]"]');
        const categoryEl = document.querySelector('select[name="jewelry_item[jewellery_category_id]"]');
        const skuEl = document.querySelector('input[name="jewelry_item[sku]"]');
        if(!metalEl || !purityEl) return;

        function rndAlnum(n){
          const _ALNUM = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
          let out=''; for(let i=0;i<n;i++) out += _ALNUM.charAt(Math.floor(Math.random()*_ALNUM.length)); return out;
        }
        function generateSkuIfEmpty(){
          if(!skuEl) return;
          if(skuEl.value && skuEl.value.trim().length) return;
          skuEl.value = rndAlnum(5);
          const previewSku = document.getElementById('preview-sku'); if(previewSku) previewSku.textContent = skuEl.value;
        }
        function selectedLabel(select){
          if(!select || !select.selectedOptions || !select.selectedOptions[0]) return '—';
          const t = select.selectedOptions[0].text;
          return (select.value && t) ? t : '—';
        }
        function syncChips(){
          const metalChip = document.getElementById('preview-metal');
          const purityChip = document.getElementById('preview-purity');
          const categoryChip = document.getElementById('preview-category');
          if(metalChip) metalChip.textContent = selectedLabel(metalEl);
          if(purityChip) purityChip.textContent = selectedLabel(purityEl);
          if(categoryChip) categoryChip.textContent = selectedLabel(categoryEl);
        }

        function setFieldsDisabled(disabled){
          const selector = 'input.form-control, textarea.form-control, select.form-control';
          const els = form.querySelectorAll(selector);
          els.forEach(function(el){
            if(el === metalEl) { el.disabled = false; return; }
            if(el === purityEl || el === categoryEl) { el.disabled = !metalEl.value; return; }
            el.disabled = disabled;
          });
          const submit = form.querySelector('input[type="submit"], button[type="submit"]');
          if(submit) submit.disabled = disabled || !metalEl.value || !purityEl.value;
        }

        purityEl.disabled = !metalEl.value;
        if(categoryEl) categoryEl.disabled = !metalEl.value;
        setFieldsDisabled(true);
        syncChips();

        metalEl.addEventListener('change', function(){
          purityEl.disabled = !metalEl.value;
          if(categoryEl) categoryEl.disabled = !metalEl.value;
          setFieldsDisabled(!(metalEl.value && purityEl.value));
          syncChips();
        });

        purityEl.addEventListener('change', function(){
          setFieldsDisabled(!(metalEl.value && purityEl.value));
          if(metalEl.value && purityEl.value){ generateSkuIfEmpty(); }
          syncChips();
        });
        if(categoryEl) categoryEl.addEventListener('change', syncChips);

        form.addEventListener('submit', function(e){
          if(!metalEl.value || !purityEl.value){
            e.preventDefault();
            alert('Please select both metal and purity before adding this piece.');
          }
        });
      });

    const nameEl = document.querySelector('input[name="jewelry_item[name]"]');
    const descEl = document.querySelector('textarea[name="jewelry_item[description]"]');
    const priceRupeesEl = document.getElementById('price_rupees');
    const priceHiddenEl = document.getElementById('price_cents_hidden');
    const weightEl = document.querySelector('input[name="jewelry_item[weight_grams]"]');
    const skuEl = document.querySelector('input[name="jewelry_item[sku]"]');

    const previewTitle = document.getElementById('preview-title');
    const previewSku = document.getElementById('preview-sku');
    const previewPrice = document.getElementById('preview-price');
    const previewWeight = document.getElementById('preview-weight');
    const previewDesc = document.getElementById('preview-desc');

    function updatePreview(){
      if(nameEl) previewTitle.textContent = nameEl.value || 'New piece';
      if(descEl) previewDesc.innerHTML = (descEl.value || 'Description will appear here as you type.').replace(/\n/g,'<br>');
      let rupeesText = '₹ —';
      if(priceHiddenEl && priceHiddenEl.value){
        rupeesText = '\u20B9' + (parseInt(priceHiddenEl.value)/100).toFixed(2);
      } else if(priceRupeesEl && priceRupeesEl.value){
        const v = parseFloat(priceRupeesEl.value);
        if(!isNaN(v)) rupeesText = '\u20B9' + v.toFixed(2);
      }
      previewPrice.textContent = rupeesText;
      if(weightEl) previewWeight.textContent = (parseFloat(weightEl.value || 0)).toFixed(2) + ' g';
      if(skuEl && skuEl.value.trim().length) previewSku.textContent = skuEl.value;
    }

    function maybeGenerateSku(){
      if(!skuEl) return;
      if(skuEl.value && skuEl.value.trim().length) { previewSku.textContent = skuEl.value; return; }
      const _ALNUM = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let out='';
      for(let i=0;i<5;i++) out += _ALNUM.charAt(Math.floor(Math.random()*_ALNUM.length));
      skuEl.value = out;
      previewSku.textContent = skuEl.value || '—';
    }

    [nameEl, descEl, priceRupeesEl, weightEl, skuEl].forEach(el=>{ if(!el) return; el.addEventListener('input', function(){ updatePreview(); }); });
    if(nameEl) nameEl.addEventListener('input', function(){ maybeGenerateSku(); });

    if(priceRupeesEl && priceRupeesEl.value && priceHiddenEl) priceHiddenEl.value = Math.round(parseFloat(priceRupeesEl.value) * 100);
    maybeGenerateSku();
    updatePreview();
  })();
</script>

<script>
  (function(){
    const PURITIES = <%= (@purities || []).map do |p|
      per_gram = if p.respond_to?(:updated_price) && p.updated_price.present?
        p.updated_price.to_f
      else
        ms = p.metal&.metal_stocks&.order(created_at: :desc)&.first
        (ms && ms.price_cents_per_gram.present?) ? (ms.price_cents_per_gram.to_f / 100.0) : 0.0
      end
      { id: p.id, per_gram_price: per_gram, name: p.hallmark_label, metal_id: p.metal_id }
    end.to_json.html_safe %>;
    const CATEGORIES = <%= (@categories || []).map { |c| { id: c.id, name: c.display_name, metal_id: c.metal_id } }.to_json.html_safe %>;
    function findPurity(id){ return PURITIES.find(x=>String(x.id) === String(id)); }

    addReadyListener(function(){
      const metalEl = document.querySelector('select[name="jewelry_item[metal_id]"]');
      const purityEl = document.querySelector('select[name="jewelry_item[purity_id]"]');
      const weightEl = document.querySelector('input[name="jewelry_item[weight_grams]"]');
      const qtyEl = document.querySelector('input[name="jewelry_item[quantity]"]');
      const priceRupeesEl = document.getElementById('price_rupees');
      const priceHiddenEl = document.getElementById('price_cents_hidden');

      function computeAndSetPrice(){
        if(!priceRupeesEl || !priceHiddenEl) return;
        const purity = purityEl ? findPurity(purityEl.value) : null;
        const perGram = purity && (purity.per_gram_price || purity.per_gram_price === 0) ? parseFloat(purity.per_gram_price) : 0;
        const weight = parseFloat((weightEl && weightEl.value) || 0);
        const qty = parseFloat((qtyEl && qtyEl.value) || 1);
        const total = perGram * (isNaN(weight) ? 0 : weight) * (isNaN(qty) ? 1 : qty);
        priceRupeesEl.value = isNaN(total) ? '' : total.toFixed(2);
        if(priceRupeesEl.value) priceHiddenEl.value = Math.round(parseFloat(priceRupeesEl.value) * 100);
        const previewPrice = document.getElementById('preview-price');
        if(previewPrice) previewPrice.textContent = priceRupeesEl.value ? '\u20B9' + parseFloat(priceRupeesEl.value).toFixed(2) : '₹ —';
      }

      function populatePurityOptions(selectedMetalId){
        if(!purityEl) return;
        const prev = purityEl.value;
        purityEl.innerHTML = '';
        const blank = document.createElement('option');
        blank.value = '';
        blank.text = 'Select purity';
        purityEl.appendChild(blank);
        const list = PURITIES.filter(function(p){
          return !selectedMetalId || String(p.metal_id) === String(selectedMetalId);
        });
        list.forEach(function(p){
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.text = p.name;
          purityEl.appendChild(opt);
        });
        if(prev){
          const still = Array.prototype.slice.call(purityEl.options).some(o=>String(o.value)===String(prev));
          if(still) purityEl.value = prev; else purityEl.value = '';
        }
      }

      function populateCategoryOptions(selectedMetalId){
        const categoryEl = document.querySelector('select[name="jewelry_item[jewellery_category_id]"]');
        if(!categoryEl) return;
        const prev = categoryEl.value;
        categoryEl.innerHTML = '';
        const blank = document.createElement('option');
        blank.value = '';
        blank.text = 'Select category';
        categoryEl.appendChild(blank);
        const list = CATEGORIES.filter(function(c){
          return !selectedMetalId || String(c.metal_id) === String(selectedMetalId);
        });
        list.forEach(function(c){
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.text = c.name;
          categoryEl.appendChild(opt);
        });
        if(prev){
          const still = Array.prototype.slice.call(categoryEl.options).some(o=>String(o.value)===String(prev));
          if(still) categoryEl.value = prev; else categoryEl.value = '';
        }
      }

      [purityEl, weightEl, qtyEl].forEach(el=>{ if(!el) return; el.addEventListener('input', computeAndSetPrice); el.addEventListener('change', computeAndSetPrice); });
      if(metalEl){
        metalEl.addEventListener('change', function(){
          populatePurityOptions(metalEl.value);
          populateCategoryOptions(metalEl.value);
          setTimeout(computeAndSetPrice, 50);
        });
      }

      populatePurityOptions(metalEl ? metalEl.value : null);
      populateCategoryOptions(metalEl ? metalEl.value : null);
      computeAndSetPrice();
    });
  })();
</script>
