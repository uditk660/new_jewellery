<%= render 'shared/atelier_styles' %>

<%
  book = @book
  house = @house_name.to_s
  metals = @metals || []
  window = book.window
  tab_path = lambda do |key|
    profit_losses_path(request.query_parameters.merge(window: key).except('from', 'to'))
  end
  result = book.house_result
  loss = result.negative?
  mix = book.mix
  series = book.series
  series_max = book.series_max
  metals_mix = book.by_metal
  bills = book.bills
%>

<div class="atelier-page house-result">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Books</p>
      <h1>House result</h1>
      <p class="lead">What the counter wrote in this window — metal recovered at the board, making kept by <%= house %>, GST held for government.</p>
    </div>
    <div class="stock-hero-actions">
      <%= link_to 'Sales log', sales_log_reports_path, class: 'atelier-back' %>
      <%= link_to 'Ledgers', ledgers_path, class: 'atelier-back' %>
      <%= link_to 'Compose a window', new_profit_loss_path(window: window, from: book.from, to: book.to, metal_id: book.metal_id), class: 'btn-gold' %>
    </div>
  </header>

  <nav class="cat-tabs" aria-label="Window">
    <%= link_to 'Today', tab_path.call('today'), class: (window == 'today' ? 'is-active' : nil) %>
    <%= link_to 'Yesterday', tab_path.call('yesterday'), class: (window == 'yesterday' ? 'is-active' : nil) %>
    <%= link_to 'Week', tab_path.call('week'), class: (window == 'week' ? 'is-active' : nil) %>
    <%= link_to 'Month', tab_path.call('month'), class: (window == 'month' ? 'is-active' : nil) %>
    <%= link_to 'Year', tab_path.call('year'), class: (window == 'year' ? 'is-active' : nil) %>
    <% dates_path = window == 'custom' ? profit_losses_path(window: 'custom', from: book.from, to: book.to, metal_id: book.metal_id) : new_profit_loss_path(window: 'custom', from: book.from, to: book.to, metal_id: book.metal_id) %>
    <%= link_to 'Dates', dates_path, class: (window == 'custom' ? 'is-active' : nil) %>
  </nav>

  <div class="cat-toolbar atelier-form">
    <%= form_tag profit_losses_path, method: :get, class: 'stock-search' do %>
      <%= hidden_field_tag :window, window %>
      <% if window == 'custom' %>
        <%= date_field_tag :from, book.from, class: 'form-control' %>
        <%= date_field_tag :to, book.to, class: 'form-control' %>
      <% end %>
      <%= select_tag :metal_id, options_from_collection_for_select(metals, :id, :name, book.metal_id), include_blank: 'All metals', class: 'form-control' %>
      <button type="submit" class="atelier-back">Read</button>
      <% if book.metal_id.present? || window == 'custom' %>
        <%= link_to 'Clear', profit_losses_path(window: window == 'custom' ? 'month' : window), class: 'atelier-back' %>
      <% end %>
    <% end %>
    <div class="stock-stats">
      <div>
        <span>Bills</span>
        <strong><%= book.bill_count %></strong>
      </div>
      <div>
        <span>Pieces</span>
        <strong><%= book.pieces %></strong>
      </div>
      <div>
        <span>Net weight</span>
        <strong><%= '%.2f' % book.grams %> <em>g</em></strong>
      </div>
    </div>
  </div>

  <div class="pl-hero-strip">
    <div class="pl-hero-copy">
      <p class="pl-kicker"><%= book.label %><% if book.metal_filter %> · <%= book.metal_filter.name %><% end %></p>
      <p class="pl-figure <%= loss ? 'is-loss' : 'is-gain' %>"><%= format_rupees(result) %></p>
      <p class="pl-caption">
        <% if book.bill_count.zero? %>
          No invoices in this window. Raise a bill at the desk, or compose another span of dates.
        <% elsif loss %>
          Making and extras did not cover discounts and cash refunds. Metal on the bills is still a recovery, not a loss of stock value at board.
        <% else %>
          Kept by the house after making, extras and charges — discounts and cash refunds already taken off. Metal at the board sits above this figure as recovery.
        <% end %>
      </p>
    </div>
    <% if series.any? && series_max.positive? %>
      <div class="pl-spark" aria-hidden="true">
        <% series.each do |point| %>
          <% height = series_max.positive? ? [(point[:value] / series_max * 100).round, point[:value].positive? ? 6 : 2].max : 2 %>
          <div class="pl-spark-col" title="<%= point[:hint] %>: <%= format_rupees(point[:value]) %>">
            <span style="height: <%= height %>%"></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="atelier-grid">
    <div>
      <section class="atelier-form pl-statement">
        <div class="section">
          <h2>How the figure is read</h2>
          <p class="hint">A jewellery bill is mostly metal at today’s board. That rupee comes back to replace the grams that left the tray. What remains — making, stones, extras, less courtesy and cash refunds — is the house result.</p>
          <ol class="pl-lines">
            <% book.statement_lines.each do |line| %>
              <li class="pl-line is-<%= line[:kind] %>">
                <div class="pl-line-copy">
                  <strong><%= line[:label] %></strong>
                  <span><%= line[:note] %></span>
                </div>
                <b><%= format_rupees(line[:amount]) %></b>
              </li>
            <% end %>
          </ol>
        </div>
      </section>

      <% if mix.any? { |part| part[:amount].positive? } %>
        <section class="atelier-form" style="margin-top:18px">
          <div class="section">
            <h2>Composition of the bill</h2>
            <p class="hint">Share of metal, making, extras and charges before GST. A high metal share is usual; the house lives in the gold band.</p>
            <div class="pl-mix" role="img" aria-label="Bill composition">
              <% mix.each do |part| %>
                <% next unless part[:share].positive? %>
                <span class="is-<%= part[:tone] %>" style="width: <%= part[:share] %>%" title="<%= part[:label] %>: <%= format_rupees(part[:amount]) %>"></span>
              <% end %>
            </div>
            <ul class="pl-legend">
              <% mix.each do |part| %>
                <li>
                  <i class="is-<%= part[:tone] %>"></i>
                  <%= part[:label] %>
                  <em><%= format_rupees(part[:amount]) %></em>
                  <span><%= '%.0f' % part[:share] %>%</span>
                </li>
              <% end %>
              <li>
                <i class="is-gst"></i>
                GST
                <em><%= format_rupees(book.gst) %></em>
                <span>pass-through</span>
              </li>
            </ul>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="preview">
      <div class="card-head">
        <p class="preview-kicker">This window</p>
        <span class="client-ref"><%= book.label %></span>
      </div>
      <p class="preview-line" style="margin-top:0"><%= house %></p>
      <div class="preview-price <%= loss ? 'is-loss' : nil %>"><%= format_rupees(result) %></div>
      <p class="preview-line"><%= '%.1f' % book.margin_percent %>% of taxable · house share</p>
      <div class="chips">
        <span class="chip"><%= book.paid_bills %> settled</span>
        <span class="chip"><%= book.open_bills %> still open</span>
      </div>
      <p class="preview-desc">Receipts taken at the desk in this window: <b style="color:#e8d5a3"><%= format_rupees(book.receipts) %></b>. Still on those bills: <b style="color:#e8d5a3"><%= format_rupees(book.outstanding) %></b>. Cash on a different day does not move this result — the bill date does.</p>
      <p class="preview-note">GST is shown so the book is complete. It is not profit. Metal is shown so you can see recovery. Neither belongs in the gold figure above.</p>
    </aside>
  </div>

  <% if metals_mix.any? %>
    <h2 class="pl-block-title">By metal</h2>
    <p class="hint pl-block-hint">Grams that left on bills, and the making each metal contributed to the house.</p>
    <div class="pl-metals">
      <% metals_mix.each do |row| %>
        <%
          metal_params = request.query_parameters.merge('window' => window)
          metal_params = metal_params.except('from', 'to') unless window == 'custom'
          selected = book.metal_id.to_s == row[:id].to_s
          if selected || !row[:id].to_i.positive?
            metal_params = metal_params.except('metal_id')
          else
            metal_params['metal_id'] = row[:id]
          end
        %>
        <%= link_to profit_losses_path(metal_params), class: "pl-metal #{'is-on' if selected}" do %>
          <span class="swatch" style="background:<%= row[:colour] %>"></span>
          <div>
            <strong><%= row[:name] %></strong>
            <span><%= '%.2f' % row[:grams] %> g · <%= row[:pcs] %> <%= row[:pcs] == 1 ? 'pc' : 'pcs' %></span>
          </div>
          <b><%= format_rupees(row[:house]) %></b>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if bills.any? %>
    <h2 class="pl-block-title">Bills in the window</h2>
    <p class="hint pl-block-hint">Each invoice’s house share is making, extras and charges after that bill’s discount.</p>
    <div class="stock-table-wrap">
      <table class="stock-table">
        <thead>
          <tr>
            <%= render 'shared/index_serial_th' %>
            <th>Bill</th>
            <th>Client</th>
            <th class="num">Net</th>
            <th class="num">Metal</th>
            <th class="num">Making</th>
            <th class="num">Bill</th>
            <th class="num">House</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% bills.each_with_index do |row, idx| %>
            <% order = row[:order] %>
            <tr>
              <%= render 'shared/index_serial_td', position: idx %>
              <td>
                <strong><%= row[:invoice] %></strong>
                <span class="sku"><%= row[:date].strftime('%d %b %Y') %> · <%= row[:status] == 'paid' ? 'Settled' : 'Open' %></span>
              </td>
              <td>
                <% if row[:client] %>
                  <%= link_to row[:client].full_name.presence || 'Client', customer_path(row[:client]), class: 'piece-link' %>
                <% else %>
                  Walk-in
                <% end %>
              </td>
              <td class="num"><%= '%.2f' % row[:grams] %> g</td>
              <td class="num"><%= format_rupees(row[:metal]) %></td>
              <td class="num"><%= format_rupees(row[:making]) %></td>
              <td class="num"><%= format_rupees(row[:total]) %></td>
              <td class="num gold"><%= format_rupees(row[:house]) %></td>
              <td><%= link_to 'Bill', order_path(order), class: 'atelier-back' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="atelier-form" style="margin-top:18px">
      <p class="hint" style="margin:0">No bills to set on this page yet. <%= link_to 'Raise a bill', new_order_path %> or <%= link_to 'open the counter', pos_path %>.</p>
    </div>
  <% end %>
</div>

<style>
  .container:has(.house-result) { max-width: 1240px; }
  .house-result a.btn-gold { text-decoration: none; display: inline-flex; align-items: center; }
  .house-result .stock-hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .house-result .cat-tabs {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px;
    margin: -6px 0 16px; padding: 3px; border-radius: 999px;
    border: 1px solid rgba(201,162,39,0.4); background: #fff;
  }
  .house-result .cat-tabs a {
    display: inline-flex; padding: 7px 14px; border-radius: 999px;
    color: #6b6258; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
  }
  .house-result .cat-tabs a.is-active {
    background: linear-gradient(90deg, #e8d5a3, #c9a227); color: #0b1220;
  }
  .house-result .cat-toolbar {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    margin-bottom: 18px; flex-wrap: wrap;
  }
  .house-result .stock-search { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; flex: 1; }
  .house-result .stock-search .form-control { width: auto; min-width: 140px; }
  .house-result .stock-stats { display: flex; gap: 18px; flex-wrap: wrap; }
  .house-result .stock-stats span { display: block; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #6b6258; font-weight: 700; }
  .house-result .stock-stats strong { color: #0b1220; font-variant-numeric: tabular-nums; }
  .house-result .stock-stats em { font-style: normal; font-size: 12px; color: #6b6258; font-weight: 600; }
  .house-result .pl-hero-strip {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(220px, 0.9fr); gap: 22px;
    align-items: end; margin-bottom: 22px; padding: 22px 24px;
    background: linear-gradient(180deg, #fffaf3, #f7f1e8);
    border: 1px solid rgba(201,162,39,0.28); border-radius: 18px;
  }
  .house-result .pl-kicker {
    margin: 0; color: #c9a227; font-size: 12px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .house-result .pl-figure {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 3rem; font-weight: 600; letter-spacing: -0.03em; margin: 4px 0 8px;
    font-variant-numeric: tabular-nums;
  }
  .house-result .pl-figure.is-gain { color: #c9a227; }
  .house-result .pl-figure.is-loss { color: #7f1d1d; }
  .house-result .pl-caption { margin: 0; color: #6b6258; max-width: 62ch; line-height: 1.55; }
  .house-result .pl-spark {
    display: flex; align-items: flex-end; gap: 3px; height: 88px; padding-bottom: 4px;
  }
  .house-result .pl-spark-col { flex: 1; min-width: 4px; height: 100%; display: flex; align-items: flex-end; }
  .house-result .pl-spark-col span {
    display: block; width: 100%; border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, #e8d5a3, #c9a227); min-height: 2px;
  }
  .house-result .pl-lines { list-style: none; margin: 0; padding: 0; }
  .house-result .pl-line {
    display: flex; justify-content: space-between; gap: 16px; align-items: flex-start;
    padding: 12px 0; border-bottom: 1px dashed rgba(201,162,39,0.28);
  }
  .house-result .pl-line:last-child { border-bottom: 0; }
  .house-result .pl-line-copy strong { display: block; color: #0b1220; }
  .house-result .pl-line-copy span { display: block; margin-top: 3px; font-size: 12px; color: #6b6258; line-height: 1.45; }
  .house-result .pl-line b { font-variant-numeric: tabular-nums; white-space: nowrap; color: #0b1220; }
  .house-result .pl-line.is-minus b { color: #7f1d1d; }
  .house-result .pl-line.is-pass b { color: #6b6258; }
  .house-result .pl-line.is-subtotal {
    background: #f7f1e8; margin: 0 -12px; padding: 12px;
    border-radius: 10px; border-bottom: 0;
  }
  .house-result .pl-line.is-result {
    margin-top: 8px; padding: 14px 12px; margin-left: -12px; margin-right: -12px;
    border: 1px solid rgba(201,162,39,0.4); border-radius: 12px;
    background: linear-gradient(90deg, rgba(232,213,163,0.35), rgba(201,162,39,0.12));
  }
  .house-result .pl-line.is-result b {
    font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.45rem; color: #c9a227;
  }
  .house-result .preview .preview-price.is-loss { color: #f5d0d0; }
  .house-result .pl-mix {
    display: flex; height: 16px; border-radius: 999px; overflow: hidden;
    background: #f7f1e8; border: 1px solid rgba(201,162,39,0.22);
  }
  .house-result .pl-mix span { display: block; height: 100%; }
  .house-result .pl-mix .is-metal, .house-result .pl-legend i.is-metal { background: #0b1220; }
  .house-result .pl-mix .is-making, .house-result .pl-legend i.is-making { background: #c9a227; }
  .house-result .pl-mix .is-extra, .house-result .pl-legend i.is-extra { background: #e8d5a3; }
  .house-result .pl-mix .is-charges, .house-result .pl-legend i.is-charges { background: #8a8072; }
  .house-result .pl-legend { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  .house-result .pl-legend li { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #14110f; }
  .house-result .pl-legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
  .house-result .pl-legend i.is-gst { background: #d6cbb8; }
  .house-result .pl-legend em { margin-left: auto; font-style: normal; font-variant-numeric: tabular-nums; font-weight: 700; }
  .house-result .pl-legend span { color: #6b6258; font-size: 11px; min-width: 4.5em; text-align: right; }
  .house-result .pl-block-title {
    font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.4rem; font-weight: 600;
    margin: 28px 0 0; color: #0b1220;
  }
  .house-result .pl-block-hint { margin: 4px 0 14px; color: #6b6258; }
  .house-result .pl-metals { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-bottom: 8px; }
  .house-result .pl-metal {
    display: flex; align-items: center; gap: 12px; padding: 14px 16px;
    background: #fffaf3; border: 1px solid rgba(201,162,39,0.28); border-radius: 14px;
    text-decoration: none; color: inherit;
  }
  .house-result .pl-metal.is-on, .house-result .pl-metal:hover {
    border-color: #c9a227; background: #fff;
  }
  .house-result .pl-metal .swatch { width: 12px; height: 36px; border-radius: 999px; flex-shrink: 0; }
  .house-result .pl-metal strong { display: block; color: #0b1220; }
  .house-result .pl-metal span { display: block; font-size: 12px; color: #6b6258; margin-top: 2px; }
  .house-result .pl-metal b { margin-left: auto; color: #c9a227; font-variant-numeric: tabular-nums; }
  .house-result .stock-table-wrap {
    background: #fff; border: 1px solid rgba(201,162,39,0.22); border-radius: 14px; overflow: auto;
  }
  .house-result .stock-table { width: 100%; border-collapse: collapse; }
  .house-result .stock-table th {
    text-align: left; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #6b6258; padding: 10px 12px; border-bottom: 1px solid rgba(201,162,39,0.22); background: #f7f1e8;
  }
  .house-result .stock-table td { padding: 10px 12px; border-bottom: 1px solid rgba(201,162,39,0.12); vertical-align: top; }
  .house-result .stock-table tr:last-child td { border-bottom: 0; }
  .house-result .num { text-align: right; font-variant-numeric: tabular-nums; }
  .house-result .gold { color: #c9a227; font-weight: 700; }
  .house-result td > strong { display: block; color: #0b1220; }
  .house-result .sku { display: block; color: #6b6258; font-size: 12px; margin-top: 2px; }
  .house-result .piece-link { color: #0b1220; text-decoration: none; font-weight: 600; }
  .house-result td .atelier-back { padding: 5px 10px; font-size: 12px; }
  @media (max-width: 880px) {
    .house-result .pl-hero-strip { grid-template-columns: 1fr; }
    .house-result .pl-spark { height: 64px; }
    .house-result .pl-legend { grid-template-columns: 1fr; }
    .house-result .stock-table th:nth-child(5),
    .house-result .stock-table td:nth-child(5),
    .house-result .stock-table th:nth-child(6),
    .house-result .stock-table td:nth-child(6) { display: none; }
  }
</style>
