<div class="nested-row" data-nested="category">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy, class: 'destroy-flag', value: 'false' %>
  <div class="row">
    <div class="field">
      <%= f.label :name, 'Category' %>
      <%= f.text_field :name, class: 'form-control nested-name', placeholder: 'e.g. Ring, Necklace, Bangle' %>
    </div>
    <div class="field">
      <%= f.label :description, 'Description' %>
      <%= f.text_field :description, class: 'form-control', placeholder: 'Temple, daily wear, bridal…' %>
    </div>
  </div>
  <div class="row" style="margin-top:10px">
    <div class="field narrow">
      <%= f.label :hsn_code, 'HSN' %>
      <%= f.text_field :hsn_code, class: 'form-control', placeholder: '7113' %>
    </div>
    <div class="field narrow">
      <%= f.label :gender, 'For' %>
      <%= f.select :gender, JewelleryCategory::GENDERS, { include_blank: '—' }, class: 'form-control' %>
    </div>
    <div class="field narrow">
      <%= f.label :default_making_charge_percent, 'Making %' %>
      <%= f.number_field :default_making_charge_percent, class: 'form-control', step: '0.01', min: 0, placeholder: '0' %>
    </div>
    <div class="field narrow">
      <%= f.label :position, 'Order' %>
      <%= f.number_field :position, class: 'form-control', min: 0, step: 1 %>
    </div>
    <div class="field narrow nested-flags">
      <label><%= f.check_box :active %> Active</label>
      <button type="button" class="remove-nested" data-remove>Remove</button>
    </div>
  </div>
</div>
