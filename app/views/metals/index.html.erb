<%= render 'shared/atelier_styles' %>

<div class="atelier-page metal-master is-list" id="metals-view">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">House masters</p>
      <h1>Metals, hallmarks &amp; categories</h1>
      <p class="lead">Each metal holds its own purities — Gold may be 18K, 20K and 22K — and the piece types you sell in that metal.</p>
    </div>
    <div class="metal-hero-actions">
      <div class="view-toggle" role="group" aria-label="Layout">
        <button type="button" class="view-btn is-active" data-view="cards" aria-pressed="true">Cards</button>
        <button type="button" class="view-btn" data-view="list" aria-pressed="false">List</button>
      </div>
      <%= link_to 'New metal', new_metal_path, class: 'atelier-back' %>
    </div>
  </header>

  <% if params[:q].present? %>
    <p class="hint" style="margin-bottom:16px">Showing matches for “<%= params[:q] %>”.</p>
  <% end %>

  <% if @metals.any? %>
    <div class="metal-cards" data-layout="cards">
      <% @metals.each_with_index do |metal, idx| %>
        <%= link_to metal_path(metal), class: 'metal-card' do %>
          <span class="index-serial-badge"><%= index_serial(idx) %></span>
          <div class="metal-card-top">
            <span class="swatch" style="background:<%= metal.chip_colour %>"></span>
            <div>
              <h2><%= metal.name %></h2>
              <p><%= metal.code.presence || metal.base_unit.presence || 'gram' %><% if metal.bis_mandatory? %> · BIS<% end %></p>
            </div>
            <% unless metal.active? %><span class="off">Inactive</span><% end %>
          </div>
          <div class="chips chips-dense">
            <% labels = metal_hallmark_chip_labels(metal) %>
            <% if labels.any? %>
              <% labels.each do |label| %>
                <span class="chip"><%= label %></span>
              <% end %>
            <% else %>
              <span class="chip muted-chip">No hallmarks yet</span>
            <% end %>
          </div>
          <p class="cats">
            <% line = metal_categories_line(metal) %>
            <%= line.present? ? line : 'No categories yet' %>
          </p>
        <% end %>
      <% end %>
    </div>

    <div class="metal-list-wrap" data-layout="list">
      <table class="metal-list">
        <thead>
          <tr>
            <%= render 'shared/index_serial_th' %>
            <th>Metal</th>
            <th>Hallmarks &amp; weight</th>
            <th>Categories</th>
            <th class="col-status">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @metals.each_with_index do |metal, idx| %>
            <tr>
              <%= render 'shared/index_serial_td', position: idx %>
              <td>
                <%= link_to metal_path(metal), class: 'metal-name' do %>
                  <span class="swatch" style="background:<%= metal.chip_colour %>"></span>
                  <span>
                    <strong><%= metal.name %></strong>
                    <span class="meta"><%= (metal.base_unit.presence || 'gram').upcase %></span>
                  </span>
                <% end %>
              </td>
              <td>
                <div class="chips chips-dense">
                  <% labels = metal_hallmark_chip_labels(metal) %>
                  <% if labels.any? %>
                    <% labels.each do |label| %>
                      <span class="chip"><%= label %></span>
                    <% end %>
                  <% else %>
                    <span class="chip muted-chip">No hallmarks yet</span>
                  <% end %>
                </div>
              </td>
              <td class="cats-cell">
                <% line = metal_categories_line(metal) %>
                <% if line.present? %>
                  <%= line %>
                <% else %>
                  <span class="muted">No categories yet</span>
                <% end %>
              </td>
              <td class="col-status">
                <% if metal.active? %>
                  <span class="stock in">Active</span>
                <% else %>
                  <span class="off">Inactive</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'shared/index_pagination',
               page: @page,
               per_page: @per_page,
               total_count: @total_count,
               note: "#{@total_count} metals",
               url: ->(n) { metals_path(request.query_parameters.merge(page: n)) } %>
  <% else %>
    <div class="atelier-form">
      <p class="hint" style="margin:0">No metals yet. Add Gold with 18K, 20K and 22K to start the catalogue.</p>
      <div class="actions" style="margin-top:16px"><%= link_to 'Add the first metal', new_metal_path, class: 'btn-gold' %></div>
    </div>
  <% end %>
</div>

<style>
  .metal-master .metal-hero-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .metal-master .view-toggle {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid rgba(201,162,39,0.4);
    background: #fffaf3;
  }
  .metal-master .view-btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: #6b6258;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 7px 14px;
    border-radius: 999px;
    cursor: pointer;
  }
  .metal-master .view-btn.is-active {
    background: linear-gradient(90deg, #e8d5a3, #c9a227);
    color: #0b1220;
  }
  .metal-master .metal-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .metal-master .metal-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.28);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 12px 28px rgba(20,17,15,0.05);
  }
  .metal-master .metal-card:hover { border-color: #c9a227; }
  .metal-master .metal-card-top { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
  .metal-master .swatch { width: 36px; height: 36px; border-radius: 10px; border: 1px solid rgba(201,162,39,0.35); flex-shrink: 0; }
  .metal-master .metal-card h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.45rem; margin: 0; font-weight: 600; color: #0b1220;
  }
  .metal-master .metal-card p { margin: 2px 0 0; color: #6b6258; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .metal-master .off {
    margin-left: auto; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #9a9186; border: 1px solid #e6dcc8; border-radius: 999px; padding: 3px 8px;
    display: inline-block;
  }
  .metal-master .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .metal-master .chips-dense {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 10px;
    max-width: 520px;
  }
  .metal-master .chip {
    background: #fff; border: 1px solid rgba(201,162,39,0.28); border-radius: 999px;
    padding: 4px 10px; font-size: 12px; font-weight: 600; color: #14110f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .metal-master .muted-chip { color: #9a9186; font-weight: 500; }
  .metal-master .cats { margin: 12px 0 0; color: #6b6258; font-size: 13px; }
  .metal-master .metal-list-wrap {
    background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.28);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(20,17,15,0.05);
  }
  .metal-master .metal-list { width: 100%; border-collapse: collapse; }
  .metal-master .metal-list th {
    text-align: left;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6258;
    font-weight: 700;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(201,162,39,0.22);
    background: #f7f1e8;
  }
  .metal-master .metal-list td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(201,162,39,0.12);
    vertical-align: top;
    font-size: 14px;
    color: #14110f;
  }
  .metal-master .metal-list td.col-status { vertical-align: middle; }
  .metal-master .metal-list tbody tr:last-child td { border-bottom: 0; }
  .metal-master .metal-list tbody tr:hover { background: rgba(232,213,163,0.22); }
  .metal-master .metal-name {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .metal-master .metal-name strong {
    display: block;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #0b1220;
  }
  .metal-master .metal-name .meta {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #6b6258;
    text-transform: uppercase;
  }
  .metal-master .cats-cell { color: #6b6258; font-size: 13px; line-height: 1.55; max-width: 280px; }
  .metal-master .muted { color: #9a9186; }
  .metal-master .stock {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: #0b1220;
    color: #e8d5a3;
  }
  .metal-master .col-status { width: 110px; white-space: nowrap; }
  .metal-master.is-list [data-layout="cards"] { display: none; }
  .metal-master.is-list [data-layout="list"] { display: block; }
  .metal-master.is-cards [data-layout="list"] { display: none; }
  .metal-master.is-cards [data-layout="cards"] { display: grid; }
  @media (max-width: 800px) {
    .metal-master .metal-hero-actions { width: 100%; }
    .metal-master .metal-list th:nth-child(4),
    .metal-master .metal-list td:nth-child(4) { display: none; }
  }
</style>

<script>
  (function(){
    var wrap = document.getElementById('metals-view');
    if(!wrap) return;
    var buttons = wrap.querySelectorAll('.view-btn');
    var key = 'metals-view';
    function apply(view){
      var mode = view === 'list' ? 'list' : 'cards';
      wrap.classList.remove('is-list', 'is-cards');
      wrap.classList.add(mode === 'list' ? 'is-list' : 'is-cards');
      buttons.forEach(function(btn){
        var on = btn.getAttribute('data-view') === mode;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      try { localStorage.setItem(key, mode); } catch(e){}
    }
    buttons.forEach(function(btn){
      btn.addEventListener('click', function(){ apply(btn.getAttribute('data-view')); });
    });
    var saved = 'list';
    try { saved = localStorage.getItem(key) || 'list'; } catch(e){}
    apply(saved);
  })();
</script>
