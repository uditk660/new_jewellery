<%= render 'shared/atelier_styles' %>

<div class="atelier-page metal-master">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">House masters</p>
      <h1>Metals, hallmarks &amp; categories</h1>
      <p class="lead">Each metal holds its own purities — Gold may be 18K, 20K and 22K — and the piece types you sell in that metal.</p>
    </div>
    <%= link_to 'New metal', new_metal_path, class: 'atelier-back' %>
  </header>

  <% if params[:q].present? %>
    <p class="hint" style="margin-bottom:16px">Showing matches for “<%= params[:q] %>”.</p>
  <% end %>

  <% if @metals.any? %>
    <div class="metal-cards">
      <% @metals.each do |metal| %>
        <%= link_to metal_path(metal), class: 'metal-card' do %>
          <div class="metal-card-top">
            <span class="swatch" style="background:<%= metal.chip_colour %>"></span>
            <div>
              <h2><%= metal.name %></h2>
              <p><%= metal.code.presence || metal.base_unit.presence || 'gram' %><% if metal.bis_mandatory? %> · BIS<% end %></p>
            </div>
            <% unless metal.active? %><span class="off">Inactive</span><% end %>
          </div>
          <div class="chips">
            <% if metal.purity_names.any? %>
              <% metal.purities.ordered.each do |p| %>
                <span class="chip"><%= p.name %></span>
              <% end %>
            <% else %>
              <span class="chip muted-chip">No hallmarks yet</span>
            <% end %>
          </div>
          <p class="cats">
            <% if metal.category_names.any? %>
              <%= metal.category_names.join(' · ') %>
            <% else %>
              No categories yet
            <% end %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="atelier-form">
      <p class="hint" style="margin:0">No metals yet. Add Gold with 18K, 20K and 22K to start the catalogue.</p>
      <div class="actions" style="margin-top:16px"><%= link_to 'Add the first metal', new_metal_path, class: 'btn-gold' %></div>
    </div>
  <% end %>
</div>

<style>
  .metal-master .metal-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .metal-master .metal-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.28);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 12px 28px rgba(20,17,15,0.05);
  }
  .metal-master .metal-card:hover { border-color: #c9a227; }
  .metal-master .metal-card-top { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
  .metal-master .swatch { width: 36px; height: 36px; border-radius: 10px; border: 1px solid rgba(201,162,39,0.35); flex-shrink: 0; }
  .metal-master .metal-card h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.45rem; margin: 0; font-weight: 600; color: #0b1220;
  }
  .metal-master .metal-card p { margin: 2px 0 0; color: #6b6258; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .metal-master .off {
    margin-left: auto; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #9a9186; border: 1px solid #e6dcc8; border-radius: 999px; padding: 3px 8px;
  }
  .metal-master .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .metal-master .chip {
    background: #fff; border: 1px solid rgba(201,162,39,0.28); border-radius: 999px;
    padding: 4px 10px; font-size: 12px; font-weight: 600; color: #14110f;
  }
  .metal-master .muted-chip { color: #9a9186; font-weight: 500; }
  .metal-master .cats { margin: 12px 0 0; color: #6b6258; font-size: 13px; }
</style>
