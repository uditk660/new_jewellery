<%# Kept for any leftover render; the stock card now posts movements inline. %>
<%= form_tag stock_movements_path, method: :post do %>
  <%= hidden_field_tag :inventory_item_id, @inventory_item.id %>
  <div class="field">
    <label for="change_grams">Grams</label>
    <%= number_field_tag :change_grams, 0, class: 'form-control', id: 'change_grams' %>
  </div>
  <div class="field">
    <label for="movement_type">Kind</label>
    <%= select_tag :movement_type, options_for_select([['Receive (in)', 'in'], ['Issue (out)', 'out'], ['Adjustment', 'adjustment']]), class: 'form-control', id: 'movement_type' %>
  </div>
  <div class="field">
    <label for="note">Note</label>
    <%= text_field_tag :note, nil, class: 'form-control', id: 'note' %>
  </div>
  <%= submit_tag 'Post movement', class: 'btn-gold' %>
<% end %>
