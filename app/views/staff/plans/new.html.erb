<div class="top">
  <div>
    <h1>Add a plan</h1>
    <div class="sub">Price is annual. New store signups can request it immediately.</div>
  </div>
</div>

<div class="card" style="max-width:560px">
  <%= form_for @plan, url: staff_plans_path do |f| %>
    <% if @plan.errors.any? %>
      <div class="flash alert"><%= @plan.errors.full_messages.to_sentence %></div>
    <% end %>
    <label>Name</label>
    <%= f.text_field :name, placeholder: 'Professional' %>
    <label>Tagline</label>
    <%= f.text_field :tagline, placeholder: 'For growing showrooms' %>
    <label>Description</label>
    <%= f.text_area :description %>
    <label>Yearly price (₹)</label>
    <%= number_field_tag :price_rupees, (@plan.price_cents.to_i / 100), min: 0, step: 1 %>
    <label>Features (one per line)</label>
    <%= f.text_area :features, placeholder: "Unlimited invoices\nInventory & rates\nPriority support" %>
    <label>Display order</label>
    <%= f.number_field :position, value: @plan.position || 0 %>
    <label style="display:flex;gap:8px;align-items:center;color:#e5eef8">
      <%= f.check_box :active, { checked: true }, '1', '0' %> Visible on signup
    </label>
    <label style="display:flex;gap:8px;align-items:center;color:#e5eef8">
      <%= f.check_box :featured, {}, '1', '0' %> Highlight as featured
    </label>
    <%= f.submit 'Save plan', class: 'btn btn-gold' %>
  <% end %>
</div>
