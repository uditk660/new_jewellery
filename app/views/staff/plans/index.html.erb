<header class="ep-hero">
  <div>
    <p class="ep-eyebrow">Catalogue</p>
    <h1>Years for sale</h1>
    <p class="ep-lead">These plans appear when a jeweller asks for a subscription. Price is always for twelve months.</p>
  </div>
  <div class="ep-actions">
    <%= link_to 'Add a plan', new_staff_plan_path, class: 'btn btn-gold' %>
  </div>
</header>

<% if @plans.empty? %>
  <div class="ep-card">
    <div class="ep-empty">
      <h2>No plans on the board</h2>
      <p class="ep-hint">Add a yearly plan before houses can request a licence.</p>
    </div>
  </div>
<% else %>
  <div class="ep-plan-grid">
    <% @plans.each_with_index do |plan, idx| %>
      <article class="ep-plan <%= 'is-featured' if plan.featured? %>" style="position:relative">
        <span class="index-serial-badge"><%= index_serial(idx) %></span>
        <p class="ep-eyebrow" style="margin:0 0 4px"><%= plan.featured? ? 'Most chosen' : (plan.active? ? 'On the board' : 'Hidden') %></p>
        <h2 style="margin:0;font-family:'Cormorant Garamond',Georgia,serif;font-size:1.45rem;font-weight:600"><%= plan.name %></h2>
        <p class="ep-hint" style="margin:4px 0 0"><%= plan.tagline.presence || 'Yearly licence' %></p>
        <div class="price"><%= format_rupees(plan.price_cents, cents: true) %> <span style="font-size:13px;color:#6b6258;font-family:Inter,system-ui,sans-serif">/ year</span></div>
        <p class="ep-hint"><%= plan.active? ? 'Visible at signup' : 'Hidden from signup' %></p>
        <% if plan.feature_list.any? %>
          <ul>
            <% plan.feature_list.first(6).each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>
