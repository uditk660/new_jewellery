<header class="ep-hero">
  <div>
    <p class="ep-eyebrow">Houses</p>
    <h1>Grant a year</h1>
    <p class="ep-lead">Cuts an active twelve-month licence immediately. Use this when staff sell or assign a plan — no queue, no wait.</p>
  </div>
  <div class="ep-actions">
    <%= link_to '← Years on the book', staff_subscriptions_path, class: 'btn btn-ghost' %>
  </div>
</header>

<div class="ep-card ep-narrow">
  <%= form_for @subscription, url: staff_subscriptions_path do |f| %>
    <% if @subscription.errors.any? %>
      <div class="ep-flash alert"><%= @subscription.errors.full_messages.to_sentence %></div>
    <% end %>
    <label>House account</label>
    <%= f.select :user_id, @users.map { |u| ["#{u.display_name}  ·  #{u.email}", u.id] }, prompt: 'Select a store login' %>
    <label>Plan</label>
    <%= f.select :plan_id, @plans.map { |p| ["#{p.name} — #{format_rupees(p.price_cents, cents: true)} / year", p.id] }, prompt: 'Select a year' %>
    <label>Internal note</label>
    <%= f.text_area :decision_note, name: 'subscription[decision_note]', placeholder: 'Sold at the desk, complimentary grant…' %>
    <%= f.submit 'Activate one year', class: 'btn btn-gold' %>
  <% end %>
</div>
