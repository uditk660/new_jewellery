<div class="top">
  <div>
    <h1>Subscriptions</h1>
    <div class="sub">Cancel or suspend live stores. Grant a plan directly when needed.</div>
  </div>
  <%= link_to 'Add subscription', new_staff_subscription_path, class: 'btn btn-gold' %>
</div>

<div class="filters" style="margin-bottom:12px">
  <%= link_to 'All', staff_subscriptions_path, class: (params[:status].blank? ? 'on' : nil) %>
  <% %w[pending active suspended cancelled rejected].each do |st| %>
    <%= link_to st.titleize, staff_subscriptions_path(status: st), class: (params[:status] == st ? 'on' : nil) %>
  <% end %>
</div>

<div class="card">
  <table>
    <thead>
      <tr>
        <th>Store</th>
        <th>Plan</th>
        <th>Status</th>
        <th>Term</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @subscriptions.each do |sub| %>
        <tr>
          <td><strong><%= sub.user.display_name %></strong><div class="sub"><%= sub.user.email %></div></td>
          <td><%= sub.plan.name %></td>
          <td><span class="pill st-<%= sub.effective_status %>"><%= sub.effective_status %></span></td>
          <td>
            <% if sub.starts_at && sub.ends_at %>
              <%= sub.starts_at.to_date %> → <%= sub.ends_at.to_date %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= link_to 'Manage', staff_subscription_path(sub) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
