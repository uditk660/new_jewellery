<% sub = @subscription %>

<header class="ep-hero">
  <div>
    <p class="ep-eyebrow">Licence</p>
    <h1><%= sub.user.display_name %></h1>
    <p class="ep-lead"><%= sub.user.email %> · <%= sub.plan.name %> · <%= format_rupees(sub.plan.price_cents, cents: true) %> / year</p>
  </div>
  <div class="ep-actions">
    <span class="pill st-<%= sub.effective_status %>"><%= sub.effective_status %></span>
    <%= link_to '← Years', staff_subscriptions_path, class: 'btn btn-ghost' %>
  </div>
</header>

<div class="ep-split">
  <div class="ep-card">
    <h2>The house</h2>
    <ul class="ep-facts">
      <li><span>Showroom</span><b><%= sub.user.shop_name.presence || '—' %></b></li>
      <li><span>Owner</span><b><%= [sub.user.full_name.presence || '—', sub.user.phone.presence || '—'].join(' · ') %></b></li>
      <li><span>Source</span><b><%= sub.source.to_s.humanize %></b></li>
      <li><span>Opens</span><b><%= sub.starts_at ? "#{ist_stamp(sub.starts_at)} IST" : '—' %></b></li>
      <li><span>Closes</span><b><%= sub.ends_at ? "#{ist_stamp(sub.ends_at)} IST" : '—' %></b></li>
      <li><span>Last reviewed</span><b><%= sub.reviewed_by&.name || '—' %></b></li>
    </ul>
    <% if sub.decision_note.present? %>
      <p class="ep-hint"><strong>Note.</strong> <%= sub.decision_note %></p>
    <% end %>
  </div>

  <div class="ep-card">
    <h2>Staff action</h2>
    <p class="ep-hint">Suspend locks the store dashboard. Cancel ends the year. Both are written to the trail.</p>
    <% if sub.live? %>
      <%= form_tag suspend_staff_subscription_path(sub), method: :post do %>
        <label>Why suspend</label>
        <%= text_area_tag :decision_note, nil, placeholder: 'Temporarily lock the house desk' %>
        <%= submit_tag 'Suspend this year', class: 'btn btn-warn', style: 'width:100%;margin-bottom:16px' %>
      <% end %>
      <%= form_tag cancel_staff_subscription_path(sub), method: :post do %>
        <label>Why cancel</label>
        <%= text_area_tag :decision_note, nil, placeholder: 'End the licence' %>
        <%= submit_tag 'Cancel the year', class: 'btn btn-danger', style: 'width:100%' %>
      <% end %>
    <% elsif sub.status == 'suspended' %>
      <%= form_tag reactivate_staff_subscription_path(sub), method: :post do %>
        <label>Restore note</label>
        <%= text_area_tag :decision_note, nil, placeholder: 'Return the house to the desk' %>
        <%= submit_tag 'Restore access', class: 'btn btn-gold', style: 'width:100%;margin-bottom:16px' %>
      <% end %>
      <%= form_tag cancel_staff_subscription_path(sub), method: :post do %>
        <label>Or close it</label>
        <%= text_area_tag :decision_note, nil, placeholder: 'Cancel instead' %>
        <%= submit_tag 'Cancel the year', class: 'btn btn-danger', style: 'width:100%' %>
      <% end %>
    <% elsif sub.pending? %>
      <p class="ep-hint">This house is still in the queue.</p>
      <%= link_to 'Open the request', staff_subscription_request_path(sub), class: 'btn btn-gold' %>
    <% else %>
      <p class="ep-hint">This year is closed. Grant a fresh plan if the house should return.</p>
      <%= link_to 'Grant a year', new_staff_subscription_path, class: 'btn btn-gold' %>
    <% end %>
  </div>
</div>

<div class="ep-card">
  <h2>Trail</h2>
  <p class="ep-hint">Actions taken on this licence only.</p>
  <% if @logs.empty? %>
    <p class="ep-hint">No lines yet.</p>
  <% else %>
    <div class="ep-table-wrap">
      <table class="ep-table">
        <thead>
          <tr><th>When</th><th>Employee</th><th>Action</th><th>Notes</th></tr>
        </thead>
        <tbody>
          <% @logs.each do |log| %>
            <tr>
              <td><%= ist_stamp(log.created_at) %></td>
              <td><%= log.employee&.name || '—' %></td>
              <td><%= log.action.humanize %></td>
              <td><%= log.notes.presence || '—' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
