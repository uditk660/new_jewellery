<% sub = @subscription %>

<header class="ep-hero">
  <div>
    <p class="ep-eyebrow">Waiting</p>
    <h1><%= sub.user.display_name %></h1>
    <p class="ep-lead"><%= sub.user.email %> · asked for <%= sub.plan.name %>. Approving starts twelve months from this moment.</p>
  </div>
  <div class="ep-actions">
    <%= link_to '← Queue', staff_subscription_requests_path, class: 'btn btn-ghost' %>
  </div>
</header>

<div class="ep-split">
  <div class="ep-card">
    <p style="margin:0 0 14px"><span class="pill st-<%= sub.effective_status %>"><%= sub.effective_status %></span></p>
    <ul class="ep-facts">
      <li><span>House</span><b><%= sub.user.shop_name.presence || sub.user.display_name %></b></li>
      <li><span>Owner</span><b><%= [sub.user.full_name.presence || '—', sub.user.phone.presence || 'No phone'].join(' · ') %></b></li>
      <li><span>Plan</span><b><%= sub.plan.name %> · <%= format_rupees(sub.plan.price_cents, cents: true) %> / year</b></li>
      <li><span>Asked</span><b><%= ist_stamp(sub.requested_at || sub.created_at) %> IST</b></li>
      <li><span>Signed</span><b><%= ist_stamp(sub.user.created_at) %> IST</b></li>
      <li><span>From IP</span><b><%= sub.user.sign_up_ip.presence || '—' %></b></li>
    </ul>
    <p class="ep-hint">The house stays locked on a pending screen until you approve. A rejection needs a reason the owner will see.</p>
  </div>

  <div class="ep-card">
    <h2>Decide</h2>
    <p class="ep-hint">Both actions are written to the activity trail.</p>
    <%= form_tag approve_staff_subscription_request_path(sub), method: :post do %>
      <label>Internal note</label>
      <%= text_area_tag :decision_note, nil, placeholder: 'For the audit book — optional' %>
      <%= submit_tag 'Approve one year', class: 'btn btn-gold', style: 'width:100%;margin-bottom:18px' %>
    <% end %>
    <%= form_tag reject_staff_subscription_request_path(sub), method: :post do %>
      <label>Reason shown to the house</label>
      <%= text_area_tag :decision_note, nil, placeholder: 'Required — the owner reads this' %>
      <%= submit_tag 'Decline this year', class: 'btn btn-danger', style: 'width:100%' %>
    <% end %>
  </div>
</div>
