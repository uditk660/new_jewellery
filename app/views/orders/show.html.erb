<%= render 'shared/atelier_styles' %>

<%
  bill = @order.bill_breakdown
  lines = @order.line_items.to_a
  subtotal = bill[:subtotal]
  discount = bill[:discount]
  charges = bill[:charges]
  taxable = bill[:taxable]
  cgst_rate = bill[:cgst_rate]
  sgst_rate = bill[:sgst_rate]
  cgst = bill[:cgst]
  sgst = bill[:sgst]
  total = bill[:total]
  paid = bill[:paid]
  remaining = bill[:remaining]
  pending = @order.status == 'pending'
  client = @order.customer
  bill_no = @order.invoice_number.presence || "##{@order.id}"
  gross_total = @order.total_gross_grams
  net_total = @order.total_net_grams
%>

<div class="atelier-page bill-show" id="bill-show"
     data-subtotal-cents="<%= bill[:subtotal_cents] %>"
     data-paid-cents="<%= bill[:paid_cents] %>"
     data-discount="<%= '%.2f' % discount %>"
     data-charges="<%= '%.2f' % charges %>"
     data-cgst-rate="<%= '%.2f' % cgst_rate %>"
     data-sgst-rate="<%= '%.2f' % sgst_rate %>">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Sales</p>
      <h1>Bill <%= bill_no %></h1>
      <p class="lead">
        <span class="status-pill is-<%= @order.status %>"><%= @order.status.to_s.titleize %></span>
        <% if @order.sale_date.present? %>
          · <%= @order.sale_date.strftime('%d %b %Y') %>
        <% end %>
        <% if client %>
          · <%= link_to client.full_name, customer_path(client), class: 'client-link' %>
        <% end %>
      </p>
    </div>
    <div class="bill-hero-actions">
      <%= link_to '← Bills', orders_path, class: 'atelier-back' %>
      <% if @order.invoice_number.present? %>
        <%= link_to 'Invoice', invoice_order_path(@order), class: 'atelier-back', data: { turbolinks: false } %>
      <% end %>
      <% if pending %>
        <button type="submit" form="payment-form" class="btn-gold" id="record-payment-hero" disabled>Record payment</button>
      <% end %>
    </div>
  </header>

  <div class="steps" aria-hidden="true">
    <span class="step"><b>1</b> Pieces</span>
    <span class="step"><b>2</b> Client</span>
    <span class="step"><b>3</b> <%= pending ? 'Settlement' : 'Settled' %></span>
  </div>

  <% if @order.errors.any? %>
    <div class="errors"><%= @order.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="atelier-grid">
    <div>
      <section class="atelier-form">
        <div class="section">
          <h2>Pieces on this bill</h2>
          <p class="hint">Metal is the stored ₹ per gram × net weight × qty from when the bill was raised. Making and extras sit on that metal value — today’s board does not rewrite this invoice.</p>
          <% if lines.any? %>
            <% lines.each do |li| %>
              <%
                item = li.jewelry_item
                name = item&.name || 'Piece'
                add_total = li.additional_charge.to_f * li.quantity.to_i
                rpg = li.rate_per_gram_used
                metal = li.metal_amount
                making = li.making_charge.to_f
                mk_pct = li.making_percent
                meta = [
                  item&.metal&.name,
                  item&.purity&.name,
                  item&.jewellery_category&.try(:display_name).presence || item&.jewellery_category&.name,
                  li.huid.presence || item&.sku
                ].compact
              %>
              <article class="piece-card">
                <div class="piece-head">
                  <div>
                    <strong><%= name %></strong>
                    <p class="piece-meta">
                      <%= meta.join(' · ') %>
                      <% if li.hsn.present? %> · HSN <%= li.hsn %><% end %>
                    </p>
                  </div>
                  <div class="piece-line"><%= format_rupees(li.line_amount) %></div>
                </div>
                <div class="piece-stats">
                  <div><span>Qty</span><strong><%= li.quantity %></strong></div>
                  <div><span>Gross</span><strong><%= '%.2f' % li.gross_weight.to_f %> g</strong></div>
                  <div><span>Net</span><strong><%= '%.2f' % li.net_weight.to_f %> g</strong></div>
                  <div><span>₹ / g</span><strong><%= format_rupees(rpg) %></strong></div>
                </div>
                <p class="piece-formula">
                  <%= format_rupees(rpg) %>/g × <%= '%.2f' % li.net_weight.to_f %> g × <%= li.quantity %>
                  = <%= format_rupees(metal) %> metal
                  · <%= '%.1f' % mk_pct %>% making <%= format_rupees(making) %>
                  <% if add_total.positive? %>
                    · extra <%= format_rupees(add_total) %>
                  <% end %>
                </p>
              </article>
            <% end %>
            <div class="weight-row">
              <span>House weights</span>
              <strong>Gross <%= '%.2f' % gross_total %> g · Net <%= '%.2f' % net_total %> g</strong>
            </div>
          <% else %>
            <p class="hint" style="margin:0">No pieces on this bill.</p>
          <% end %>
        </div>
      </section>

      <section class="atelier-form" style="margin-top:16px">
        <div class="section">
          <h2>Client</h2>
          <p class="hint">As they should appear on the invoice.</p>
          <% if client %>
            <div class="client-chip">
              <span class="avatar"><%= client.initials %></span>
              <div>
                <strong><%= client.full_name %></strong>
                <span><%= [client.phone.presence, client.gst_number.present? ? "GST #{client.gst_number}" : nil].compact.join(' · ') %></span>
              </div>
              <%= link_to 'Client card', customer_path(client), class: 'atelier-back' %>
              <%= link_to 'Khata', ledger_path(client), class: 'atelier-back' %>
            </div>
            <dl class="piece-dl">
              <div><dt>Phone</dt><dd><%= client.phone.presence || '—' %></dd></div>
              <div><dt>Email</dt><dd><%= client.email.presence || '—' %></dd></div>
              <div><dt>GSTIN</dt><dd><%= client.gst_number.presence || '—' %></dd></div>
              <div><dt>Address</dt><dd><%= client.address.presence || '—' %></dd></div>
            </dl>
          <% else %>
            <p class="hint" style="margin:0">Walk-in — no client on the book.</p>
          <% end %>
        </div>
      </section>

      <% if @order.payments.any? %>
        <section class="atelier-form" style="margin-top:16px">
          <div class="section">
            <h2>Payments</h2>
            <p class="hint">Receipts already taken against this bill.</p>
            <table class="bill-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Via</th>
                  <th>Receipt</th>
                  <th class="num">Amount</th>
                </tr>
              </thead>
              <tbody>
                <% @order.payments.sort_by(&:created_at).each do |pmnt| %>
                  <tr>
                    <td><%= pmnt.created_at.strftime('%d %b %Y, %I:%M %p') %></td>
                    <td><%= pmnt.payment_method.presence || '—' %></td>
                    <td>
                      <% if pmnt.receipt_number.present? %>
                        <%= link_to pmnt.receipt_number, invoice_payment_path(pmnt), data: { turbolinks: false } %>
                      <% else %>
                        <%= pmnt.note.presence || '—' %>
                      <% end %>
                    </td>
                    <td class="num gold"><%= format_rupees(pmnt.amount_cents.to_f / 100.0) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% if pending %>
        <section class="atelier-form" id="charge-form" style="margin-top:16px">
          <div class="section">
            <h2>Record payment</h2>
            <p class="hint">CGST and SGST are worked on the subtotal. Discount and extra charges then apply to the total after tax. Payment cannot exceed remaining due. A full settlement opens the invoice.</p>
            <%= form_tag record_payment_order_path(@order), method: :post, id: 'payment-form' do %>
              <div class="row">
                <div class="field">
                  <label for="cgst_rate">CGST (%)</label>
                  <%= number_field_tag :cgst_rate, ('%.2f' % cgst_rate), step: 0.01, min: 0, max: 20, class: 'form-control', id: 'cgst_rate' %>
                </div>
                <div class="field">
                  <label for="sgst_rate">SGST (%)</label>
                  <%= number_field_tag :sgst_rate, ('%.2f' % sgst_rate), step: 0.01, min: 0, max: 20, class: 'form-control', id: 'sgst_rate' %>
                </div>
              </div>
              <div class="row" style="margin-top:12px">
                <div class="field">
                  <label for="discount_input">Discount on total (₹)</label>
                  <%= number_field_tag :discount, ('%.2f' % discount), step: 0.01, min: 0, max: ('%.2f' % bill[:after_tax]), class: 'form-control', id: 'discount_input' %>
                </div>
                <div class="field">
                  <label for="charges_input">Extra charges (₹)</label>
                  <%= number_field_tag :charges, ('%.2f' % charges), step: 0.01, min: 0, class: 'form-control', id: 'charges_input' %>
                </div>
              </div>
              <div class="row" style="margin-top:12px">
                <div class="field">
                  <label for="payment_method_input">Paid via <span class="req">*</span></label>
                  <select name="payment_method" id="payment_method_input" class="form-control" required>
                    <option value="">Select method</option>
                    <% %w[Cash Card Online PhonePe Paytm GPay Gold Silver Others].each do |m| %>
                      <option value="<%= m %>" <%= 'selected' if @order.payment_method.to_s == m %>><%= m %></option>
                    <% end %>
                  </select>
                </div>
              </div>
              <div class="row" style="margin-top:12px">
                <div class="field">
                  <label for="remaining_due_display">Remaining due (₹)</label>
                  <input type="text" id="remaining_due_display" class="form-control due-locked" value="<%= remaining.to_i %>" readonly tabindex="-1" aria-readonly="true">
                  <p class="hint" id="due-hint" style="margin:8px 0 0">Locked. Rounded off to the rupee.</p>
                </div>
                <div class="field">
                  <label for="payment_amount_input">Pay now (₹) <span class="req">*</span></label>
                  <%= number_field_tag :payment_amount, params[:payment_amount].presence, step: 1, min: 1, max: remaining.to_i, inputmode: 'numeric', placeholder: "Up to #{remaining.to_i}", class: 'form-control', id: 'payment_amount_input', required: true %>
                  <p class="hint" id="pay-hint" style="margin:8px 0 0">Whole rupees, up to the remaining due.</p>
                </div>
              </div>
              <div class="actions" style="margin-top:16px">
                <%= submit_tag 'Record payment', class: 'btn-gold', id: 'record-payment-btn', disabled: true %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="preview" aria-live="polite">
      <p class="preview-kicker">Bill card</p>
      <div class="gem avatar-lg" aria-hidden="true"><%= client ? client.initials : '₹' %></div>
      <h2><%= client ? client.full_name : 'Walk-in' %></h2>
      <span class="sku-chip"><%= bill_no %></span>
      <div class="preview-lines">
        <% lines.each do |li| %>
          <div class="preview-line-row">
            <span><%= li.jewelry_item&.name || 'Piece' %> × <%= li.quantity %></span>
            <strong><%= format_rupees(li.line_amount) %></strong>
          </div>
        <% end %>
      </div>
      <div class="preview-sum">
        <div><span>Subtotal</span><strong id="sum-subtotal"><%= format_rupees(subtotal) %></strong></div>
        <% if bill[:discount_after_tax] %>
          <div><span>CGST <em id="sum-cgst-rate"><%= '%.2f' % cgst_rate %>%</em></span><strong id="sum-cgst"><%= format_rupees(cgst) %></strong></div>
          <div><span>SGST <em id="sum-sgst-rate"><%= '%.2f' % sgst_rate %>%</em></span><strong id="sum-sgst"><%= format_rupees(sgst) %></strong></div>
          <div><span>Total after tax</span><strong id="sum-after-tax"><%= format_rupees(bill[:after_tax]) %></strong></div>
          <div><span>Discount</span><strong id="sum-discount">−<%= format_rupees(discount) %></strong></div>
          <div><span>Extra charges</span><strong id="sum-charges">+<%= format_rupees(charges) %></strong></div>
        <% else %>
          <div><span>Discount</span><strong id="sum-discount"><%= format_rupees(discount) %></strong></div>
          <div><span>Charges</span><strong id="sum-charges"><%= format_rupees(charges) %></strong></div>
          <div><span>Taxable</span><strong id="sum-taxable"><%= format_rupees(taxable) %></strong></div>
          <div><span>CGST <em id="sum-cgst-rate"><%= '%.2f' % cgst_rate %>%</em></span><strong id="sum-cgst"><%= format_rupees(cgst) %></strong></div>
          <div><span>SGST <em id="sum-sgst-rate"><%= '%.2f' % sgst_rate %>%</em></span><strong id="sum-sgst"><%= format_rupees(sgst) %></strong></div>
        <% end %>
        <div><span>Bill total</span><strong id="sum-exact"><%= format_rupees(total) %></strong></div>
        <div><span>Round off</span><strong id="sum-roundoff"><%= bill[:round_off_cents].negative? ? '−' : '+' %><%= format_rupees(bill[:round_off_cents].abs / 100.0) %></strong></div>
        <div><span>Paid</span><strong id="sum-paid"><%= format_rupees(paid) %></strong></div>
        <div><span>Remaining</span><strong id="sum-remaining"><%= format_rupees(remaining) %></strong></div>
      </div>
      <div class="preview-price" id="sum-total"><%= format_rupees(bill[:payable]) %></div>
      <div class="preview-desc">Amount payable</div>
      <p class="preview-note" id="preview-note">
        <% if pending %>
          CGST and SGST on the subtotal, then discount off and extra charges on the total after tax.
        <% else %>
          This bill is <%= @order.status %>. <%= paid.positive? ? 'Payments are on file.' : '' %>
        <% end %>
      </p>
    </aside>
  </div>

  <div id="bill-popup" class="bill-popup" hidden>
    <div class="bill-popup-card" role="alertdialog" aria-modal="true">
      <p class="eyebrow">Bill</p>
      <p id="bill-popup-msg"></p>
      <button type="button" class="btn-gold" id="bill-popup-ok">OK</button>
    </div>
  </div>
</div>

<style>
  .container:has(.bill-show) { max-width: 1240px; }
  .bill-show .lead { max-width: 72ch; }
  .bill-show .bill-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .bill-show a.btn-gold,
  .bill-show .bill-hero-actions button.btn-gold {
    text-decoration: none; display: inline-flex; align-items: center;
    font-family: inherit; width: auto;
  }
  .bill-show .client-link { color: #c9a227; text-decoration: none; font-weight: 600; }
  .bill-show .status-pill {
    display: inline-block; padding: 3px 10px; border-radius: 999px;
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;
    border: 1px solid rgba(201,162,39,0.35); color: #c9a227;
  }
  .bill-show .status-pill.is-paid { color: #3f5d3a; border-color: rgba(63,93,58,0.35); background: rgba(63,93,58,0.08); }
  .bill-show .status-pill.is-pending { background: rgba(201,162,39,0.12); }
  .bill-show .avatar-lg {
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; font-weight: 700; letter-spacing: 0.08em; color: #e8d5a3;
  }
  .bill-show .piece-card {
    border: 1px solid rgba(201,162,39,0.22); border-radius: 14px; padding: 14px;
    background: #fff; margin-bottom: 12px;
  }
  .bill-show .piece-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
  .bill-show .piece-head strong {
    font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.2rem; font-weight: 600;
  }
  .bill-show .piece-meta { margin: 4px 0 0; color: #6b6258; font-size: 12px; }
  .bill-show .piece-line {
    color: #c9a227; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .bill-show .piece-stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 12px;
  }
  .bill-show .piece-stats div {
    background: #f7f1e8; border: 1px solid rgba(201,162,39,0.18); border-radius: 10px; padding: 8px 10px;
  }
  .bill-show .piece-stats span {
    display: block; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #6b6258; font-weight: 700;
  }
  .bill-show .piece-stats strong { font-size: 13px; font-variant-numeric: tabular-nums; }
  .bill-show .piece-formula {
    margin: 10px 0 0; font-size: 12px; color: #6b6258; line-height: 1.5;
  }
  .bill-show .weight-row {
    display: flex; justify-content: space-between; gap: 10px; padding-top: 4px;
    font-size: 13px; color: #6b6258;
  }
  .bill-show .weight-row strong { color: #0b1220; }
  .bill-show .client-chip {
    margin-bottom: 12px; display: flex; align-items: center; gap: 12px;
    background: #f7f1e8; border: 1px solid rgba(201,162,39,0.28); border-radius: 14px; padding: 10px 12px;
  }
  .bill-show .avatar {
    width: 40px; height: 40px; border-radius: 12px; font-size: 13px;
    display: inline-flex; align-items: center; justify-content: center;
    background: #0b1220; color: #e8d5a3; font-weight: 700; letter-spacing: 0.06em;
  }
  .bill-show .client-chip strong { display: block; font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.15rem; }
  .bill-show .client-chip span { color: #6b6258; font-size: 13px; }
  .bill-show .client-chip .atelier-back { margin-left: auto; }
  .bill-show .piece-dl { margin: 0; }
  .bill-show .piece-dl > div {
    display: grid; grid-template-columns: 120px 1fr; gap: 8px;
    padding: 8px 0; border-bottom: 1px solid rgba(201,162,39,0.16);
  }
  .bill-show .piece-dl dt {
    color: #6b6258; font-size: 12px; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .bill-show .piece-dl dd { margin: 0; color: #14110f; }
  .bill-show .bill-table { width: 100%; border-collapse: collapse; }
  .bill-show .bill-table th {
    text-align: left; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #6b6258; padding: 8px 8px 8px 0; border-bottom: 1px solid rgba(201,162,39,0.22);
  }
  .bill-show .bill-table td {
    padding: 10px 8px 10px 0; border-bottom: 1px solid rgba(201,162,39,0.12);
    font-size: 13px; vertical-align: top;
  }
  .bill-show .bill-table a { color: #0b1220; }
  .bill-show .bill-table .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .bill-show .bill-table .gold { color: #c9a227; font-weight: 700; }
  .bill-show .preview-lines { margin: 14px 0 8px; }
  .bill-show .preview-line-row {
    display: flex; justify-content: space-between; gap: 10px;
    font-size: 13px; color: #d6cbb8; padding: 6px 0;
    border-bottom: 1px solid rgba(232,213,163,0.12);
  }
  .bill-show .preview-line-row strong { color: #e8d5a3; font-weight: 600; white-space: nowrap; }
  .bill-show .preview-sum { margin-top: 10px; }
  .bill-show .preview-sum div {
    display: flex; justify-content: space-between; font-size: 13px; color: #b7aa98; padding: 4px 0;
  }
  .bill-show .preview-sum strong { color: #f7f1e8; font-variant-numeric: tabular-nums; }
  .bill-show .preview-sum em { font-style: normal; color: #8a8072; font-size: 11px; margin-left: 6px; }
  .bill-show input[type=number]::-webkit-outer-spin-button,
  .bill-show input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .bill-show input[type=number] { -moz-appearance: textfield; }
  .bill-show .bill-popup {
    position: fixed; inset: 0; z-index: 80;
    display: flex; align-items: center; justify-content: center;
    background: rgba(11,18,32,0.45); padding: 20px;
  }
  .bill-show .bill-popup[hidden] { display: none; }
  .bill-show .bill-popup-card {
    width: min(420px, 100%); background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.35); border-radius: 18px;
    padding: 22px 22px 18px; box-shadow: 0 24px 50px rgba(11,18,32,0.28);
  }
  .bill-show .bill-popup-card p#bill-popup-msg { margin: 0 0 16px; color: #14110f; }
  .bill-show .bill-popup-card .btn-gold { width: 100%; }
  .bill-show .atelier-form input.form-control.due-locked,
  .bill-show .atelier-form input.form-control.due-locked:focus {
    background: #f1e7d6;
    color: #0b1220;
    font-family: Inter, system-ui, sans-serif;
    font-variant-numeric: lining-nums tabular-nums;
    font-size: 18px;
    font-weight: 700;
    border-style: dashed;
    border-color: rgba(201, 162, 39, 0.55);
    cursor: not-allowed;
    box-shadow: none;
  }
  .bill-show .is-invalid { border-color: #9b3b2f !important; }
  .bill-show .hint.is-error { color: #9b3b2f; }
  @media (max-width: 880px) {
    .bill-show .bill-hero-actions { width: 100%; }
    .bill-show .piece-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bill-show .piece-dl > div { grid-template-columns: 1fr; }
    .bill-show .client-chip { flex-wrap: wrap; }
  }
</style>

<script>
  (function(){
    var root = document.getElementById('bill-show');
    if(!root) return;
    var subtotalP = parseInt(root.getAttribute('data-subtotal-cents') || '0', 10) || 0;
    var paidP = parseInt(root.getAttribute('data-paid-cents') || '0', 10) || 0;
    var subtotal = subtotalP / 100;
    var paid = paidP / 100;
    var fallback = {
      discount: parseFloat(root.getAttribute('data-discount') || '0') || 0,
      charges: parseFloat(root.getAttribute('data-charges') || '0') || 0,
      cgstRate: parseFloat(root.getAttribute('data-cgst-rate') || '0') || 0,
      sgstRate: parseFloat(root.getAttribute('data-sgst-rate') || '0') || 0
    };
    var form = document.getElementById('payment-form');
    var discEl = document.getElementById('discount_input');
    var chgEl = document.getElementById('charges_input');
    var cgstEl = document.getElementById('cgst_rate');
    var sgstEl = document.getElementById('sgst_rate');
    var amtEl = document.getElementById('payment_amount_input');
    var pmEl = document.getElementById('payment_method_input');
    var btn = document.getElementById('record-payment-btn');
    var heroBtn = document.getElementById('record-payment-hero');
    var hint = document.getElementById('pay-hint');
    var popup = document.getElementById('bill-popup');
    var popupMsg = document.getElementById('bill-popup-msg');
    var popupOk = document.getElementById('bill-popup-ok');

    function money(v){ return '\u20B9' + (isFinite(v) ? Number(v) : 0).toFixed(2); }
    function num(el){ return parseFloat((el && el.value) || 0) || 0; }
    function paise(v){ v = Number(v); return isFinite(v) ? Math.round(Number((v * 100).toPrecision(15))) : 0; }
    function share(p, rateP){ return Math.round(p * rateP / 10000); }
    function roundRupee(p){ return Math.round(p / 100) * 100; }
    function rupees(p){ return '\u20B9' + Math.round(p / 100); }
    function payRaw(){ return amtEl ? String(amtEl.value || '').trim() : ''; }
    function set(id, v){ var el = document.getElementById(id); if(el) el.textContent = money(v); }
    function setText(id, v){ var el = document.getElementById(id); if(el) el.textContent = v; }

    function totals(){
      var discountP = paise(Math.max(0, discEl ? num(discEl) : fallback.discount));
      var chargesP = paise(Math.max(0, chgEl ? num(chgEl) : fallback.charges));
      var taxableP = subtotalP;
      var cgstRate = Math.max(0, cgstEl ? num(cgstEl) : fallback.cgstRate);
      var sgstRate = Math.max(0, sgstEl ? num(sgstEl) : fallback.sgstRate);
      var cgstP = share(taxableP, paise(cgstRate));
      var sgstP = share(taxableP, paise(sgstRate));
      var afterTaxP = taxableP + cgstP + sgstP;
      var overDiscount = discountP > afterTaxP;
      if(overDiscount) discountP = afterTaxP;
      var totalP = afterTaxP - discountP + chargesP;
      var payableP = roundRupee(totalP);
      var remainingP = Math.max(0, roundRupee(totalP - paidP));
      return {
        discount: discountP / 100, charges: chargesP / 100, taxable: taxableP / 100,
        cgstRate: cgstRate, sgstRate: sgstRate, cgst: cgstP / 100, sgst: sgstP / 100,
        afterTaxP: afterTaxP,
        total: totalP / 100, payableP: payableP, roundOffP: payableP - totalP,
        remaining: remainingP / 100, remainingP: remainingP,
        belowPaid: payableP < paidP,
        rateTooHigh: cgstRate > 20 || sgstRate > 20,
        overDiscount: overDiscount
      };
    }

    function paint(){
      var t = totals();
      set('sum-subtotal', subtotal);
      setText('sum-discount', '\u2212' + money(t.discount));
      setText('sum-charges', '+' + money(t.charges));
      set('sum-after-tax', t.afterTaxP / 100);
      set('sum-cgst', t.cgst);
      set('sum-sgst', t.sgst);
      setText('sum-cgst-rate', t.cgstRate.toFixed(2) + '%');
      setText('sum-sgst-rate', t.sgstRate.toFixed(2) + '%');
      set('sum-paid', paid);
      set('sum-remaining', t.remaining);
      set('sum-exact', t.total);
      setText('sum-roundoff', (t.roundOffP < 0 ? '\u2212' : '+') + money(Math.abs(t.roundOffP) / 100));
      set('sum-total', t.payableP / 100);
      var dueEl = document.getElementById('remaining_due_display');
      if(dueEl) dueEl.value = String(t.remainingP / 100);
      if(amtEl){
        amtEl.max = String(t.remainingP / 100);
        amtEl.placeholder = 'Up to ' + (t.remainingP / 100);
      }
      var dueHint = document.getElementById('due-hint');
      if(dueHint){
        dueHint.textContent = t.overDiscount
          ? 'Discount cannot exceed the total after tax of ' + money(t.afterTaxP / 100) + '.'
          : t.belowPaid
          ? 'These terms bring the bill below the ' + money(paid) + ' already received.'
          : 'Locked. Bill ' + money(t.total) + ' rounded off to ' + rupees(t.payableP) + (paidP ? ', less ' + money(paid) + ' paid.' : '.');
      }
      if(discEl) discEl.classList.toggle('is-invalid', !!t.overDiscount || t.belowPaid);
      syncBtn();
    }

    // Returns an error message for the Pay now box, or '' when it is acceptable.
    function payProblem(t){
      var raw = payRaw();
      if(!raw) return 'Enter the amount the client is paying now.';
      if(!/^\d+$/.test(raw)) return 'Pay in whole rupees, e.g. 500.';
      var p = parseInt(raw, 10) * 100;
      if(p <= 0) return 'Payment amount must be greater than 0.';
      if(p > t.remainingP) return 'Cannot exceed the remaining due of ' + rupees(t.remainingP) + '.';
      return '';
    }

    function syncBtn(){
      var t = totals();
      var methodOk = pmEl ? !!pmEl.value : true;
      var problem = payProblem(t);
      var typed = payRaw() !== '';
      if(hint){
        var left = typed && !problem ? t.remainingP - parseInt(payRaw(), 10) * 100 : null;
        hint.textContent = typed && problem ? problem
          : left !== null ? (left === 0 ? 'This settles the bill.' : 'Leaves ' + rupees(left) + ' due.')
          : 'Whole rupees, up to the remaining due.';
        hint.classList.toggle('is-error', typed && !!problem);
      }
      if(amtEl) amtEl.classList.toggle('is-invalid', typed && !!problem);
      var off = !methodOk || !!problem || t.overDiscount || t.belowPaid || t.rateTooHigh;
      if(btn) btn.disabled = off;
      if(heroBtn) heroBtn.disabled = off;
    }

    function showPopup(msg){
      if(!popup || !popupMsg){ window.alert(msg); return; }
      popupMsg.textContent = msg;
      popup.hidden = false;
    }
    function hidePopup(){ if(popup) popup.hidden = true; }

    [discEl, chgEl, cgstEl, sgstEl].forEach(function(el){
      if(!el) return;
      el.addEventListener('input', paint);
    });
    if(amtEl) amtEl.addEventListener('input', syncBtn);
    if(pmEl) pmEl.addEventListener('change', syncBtn);
    if(popupOk) popupOk.addEventListener('click', hidePopup);
    if(popup) popup.addEventListener('click', function(e){ if(e.target === popup) hidePopup(); });

    if(form){
      form.addEventListener('submit', function(e){
        var t = totals();
        if(t.overDiscount){
          e.preventDefault();
          showPopup('Discount cannot exceed the total after tax (' + money(t.afterTaxP / 100) + ').');
          return;
        }
        if(t.rateTooHigh){
          e.preventDefault();
          showPopup('CGST and SGST cannot exceed 20% each.');
          return;
        }
        if(t.belowPaid){
          e.preventDefault();
          showPopup('These terms bring the bill below the ' + money(paid) + ' already received.');
          return;
        }
        if(!pmEl || !pmEl.value){
          e.preventDefault();
          showPopup('Choose how this payment was taken.');
          return;
        }
        var problem = payProblem(t);
        if(problem){
          e.preventDefault();
          showPopup(problem);
        }
      });
    }

    if(form) paint();
  })();
</script>
