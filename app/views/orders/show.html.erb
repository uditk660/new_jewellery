    font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.2rem; font-weight: 600;
  }
  .bill-show .piece-meta { margin: 4px 0 0; color: #6b6258; font-size: 12px; }
  .bill-show .piece-line {
    color: #c9a227; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .bill-show .piece-stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 12px;
  }
  .bill-show .piece-stats div {
    background: #f7f1e8; border: 1px solid rgba(201,162,39,0.18); border-radius: 10px; padding: 8px 10px;
