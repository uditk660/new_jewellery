  @media (max-width: 880px) {
    .bill-show .bill-hero-actions { width: 100%; }
    .bill-show .piece-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bill-show .piece-dl > div { grid-template-columns: 1fr; }
    .bill-show .client-chip { flex-wrap: wrap; }
  }
</style>

<script>
  (function(){
    var root = document.getElementById('bill-show');
    if(!root) return;
    var subtotal = parseFloat(root.getAttribute('data-subtotal') || '0') || 0;
    var paid = parseFloat(root.getAttribute('data-paid') || '0') || 0;
    var fallback = {
      discount: parseFloat(root.getAttribute('data-discount') || '0') || 0,
      charges: parseFloat(root.getAttribute('data-charges') || '0') || 0,
      cgstRate: parseFloat(root.getAttribute('data-cgst-rate') || '0') || 0,
      igstRate: parseFloat(root.getAttribute('data-igst-rate') || '0') || 0
    };
    var form = document.getElementById('payment-form');
    var discEl = document.getElementById('discount_input');
    var chgEl = document.getElementById('charges_input');
    var cgstEl = document.getElementById('cgst_rate');
    var igstEl = document.getElementById('igst_rate');
    var amtEl = document.getElementById('payment_amount_input');
    var pmEl = document.getElementById('payment_method_input');
    var btn = document.getElementById('record-payment-btn');
    var heroBtn = document.getElementById('record-payment-hero');
    var hint = document.getElementById('pay-hint');
    var popup = document.getElementById('bill-popup');
    var popupMsg = document.getElementById('bill-popup-msg');
    var popupOk = document.getElementById('bill-popup-ok');

    function money(v){ return '\u20B9' + (isFinite(v) ? Number(v) : 0).toFixed(2); }
    function num(el){ return parseFloat((el && el.value) || 0) || 0; }
    function set(id, v){ var el = document.getElementById(id); if(el) el.textContent = money(v); }
    function setText(id, v){ var el = document.getElementById(id); if(el) el.textContent = v; }

    function totals(){
      var discount = Math.max(0, discEl ? num(discEl) : fallback.discount);
      var charges = Math.max(0, chgEl ? num(chgEl) : fallback.charges);
      var overDiscount = discount > subtotal;
      if(overDiscount) discount = subtotal;
      var taxable = subtotal - discount + charges;
      var cgstRate = Math.max(0, cgstEl ? num(cgstEl) : fallback.cgstRate);
      var igstRate = Math.max(0, igstEl ? num(igstEl) : fallback.igstRate);
      var cgst = taxable * (cgstRate / 100);
      var igst = taxable * (igstRate / 100);
      var total = taxable + cgst + igst;
      var remaining = Math.max(0, total - paid);
      return {
        discount: discount, charges: charges, taxable: taxable,
        cgstRate: cgstRate, igstRate: igstRate, cgst: cgst, igst: igst,
        total: total, remaining: remaining, overDiscount: discEl && num(discEl) > subtotal
      };
    }

    function paint(){
      var t = totals();
      set('sum-subtotal', subtotal);
      set('sum-discount', discEl ? num(discEl) : t.discount);
      set('sum-charges', t.charges);
      set('sum-taxable', t.taxable);
      set('sum-cgst', t.cgst);
      set('sum-igst', t.igst);
      setText('sum-cgst-rate', t.cgstRate.toFixed(2) + '%');
      setText('sum-igst-rate', t.igstRate.toFixed(2) + '%');
      set('sum-paid', paid);
      set('sum-remaining', t.remaining);
      set('sum-total', t.total);
      if(amtEl && document.activeElement !== amtEl){
        var current = num(amtEl);
        if(current <= 0 || current > t.remaining) amtEl.value = t.remaining.toFixed(2);
      }
      if(hint) hint.textContent = 'Remaining due ' + money(t.remaining) + '.';
      syncBtn();
    }

    function syncBtn(){
      var t = totals();
      var amt = amtEl ? num(amtEl) : 0;
      var methodOk = pmEl ? !!pmEl.value : true;
      var off = !methodOk || amt <= 0 || amt > t.remaining + 0.001 || !!t.overDiscount;
      if(btn) btn.disabled = off;
      if(heroBtn) heroBtn.disabled = off;
    }

    function showPopup(msg){
      if(!popup || !popupMsg){ window.alert(msg); return; }
      popupMsg.textContent = msg;
      popup.hidden = false;
    }
    function hidePopup(){ if(popup) popup.hidden = true; }

    [discEl, chgEl, cgstEl, igstEl].forEach(function(el){
      if(!el) return;
      el.addEventListener('input', paint);
    });
    if(amtEl) amtEl.addEventListener('input', syncBtn);
    if(pmEl) pmEl.addEventListener('change', syncBtn);
    if(popupOk) popupOk.addEventListener('click', hidePopup);
    if(popup) popup.addEventListener('click', function(e){ if(e.target === popup) hidePopup(); });

    if(form){
      form.addEventListener('submit', function(e){
        var t = totals();
        if(discEl && num(discEl) > subtotal){
          e.preventDefault();
          showPopup('Discount cannot exceed the bill subtotal (' + money(subtotal) + ').');
          return;
        }
        if(!pmEl || !pmEl.value){
          e.preventDefault();
          showPopup('Choose how this payment was taken.');
          return;
        }
        var amt = amtEl ? num(amtEl) : 0;
        if(amt <= 0){
          e.preventDefault();
          showPopup('Payment amount must be greater than 0.');
          return;
        }
        if(amt > t.remaining + 0.001){
          e.preventDefault();
          showPopup('Payment cannot exceed remaining due (' + money(t.remaining) + ').');
        }
      });
    }

    paint();
  })();
</script>
