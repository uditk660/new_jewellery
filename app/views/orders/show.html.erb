    position: fixed; inset: 0; z-index: 80;
    display: flex; align-items: center; justify-content: center;
    background: rgba(11,18,32,0.45); padding: 20px;
  }
  .bill-show .bill-popup[hidden] { display: none; }
  .bill-show .bill-popup-card {
    width: min(420px, 100%); background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.35); border-radius: 18px;
    padding: 22px 22px 18px; box-shadow: 0 24px 50px rgba(11,18,32,0.28);
  }
  .bill-show .bill-popup-card p#bill-popup-msg { margin: 0 0 16px; color: #14110f; }
