<%= render 'shared/atelier_styles' %>

<%
  @order ||= Order.new(status: 'pending', cgst_rate: Order::DEFAULT_CGST_RATE, igst_rate: Order::DEFAULT_IGST_RATE)
  @draft_customer ||= Customer.new
  @customer_mode ||= 'existing'
  @items ||= []
  @customers ||= []
  selected = @customers.find { |c| c.id.to_s == @selected_customer_id.to_s }
%>

<div class="atelier-page sale-desk">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Sales</p>
      <h1>Raise a bill</h1>
      <p class="lead">Choose the client, add catalogue pieces, then set making, discount and tax. The invoice total updates as you work.</p>
    </div>
    <%= link_to '← Bills', orders_path, class: 'atelier-back' %>
  </header>

  <div class="steps" aria-hidden="true">
    <span class="step"><b>1</b> Client</span>
    <span class="step"><b>2</b> Pieces</span>
    <span class="step"><b>3</b> Charges &amp; tax</span>
  </div>

  <%= form_tag orders_path, method: :post, id: 'order-form', novalidate: true do %>
    <div class="atelier-grid">
      <div>
        <% if @order.errors.any? %>
          <div class="errors" id="form-error"><%= @order.errors.full_messages.to_sentence %></div>
        <% else %>
          <div class="errors" id="form-error" hidden></div>
        <% end %>

        <section class="atelier-form">
          <div class="section">
            <h2>Client</h2>
            <p class="hint">Bill an existing name on the book, or register a buyer here. Phone must be 10 digits for a new client.</p>

            <div class="mode-toggle" role="radiogroup" aria-label="Client source">
              <label class="mode <%= @customer_mode != 'new' ? 'is-on' : '' %>">
                <input type="radio" name="customer_mode" value="existing" <%= 'checked' if @customer_mode != 'new' %>>
                On the book
              </label>
              <label class="mode <%= @customer_mode == 'new' ? 'is-on' : '' %>">
                <input type="radio" name="customer_mode" value="new" <%= 'checked' if @customer_mode == 'new' %>>
                Register a client
              </label>
            </div>

            <div id="existing-client" class="client-pane" <%= 'hidden' if @customer_mode == 'new' %>>
              <%= hidden_field_tag :existing_customer_id, @selected_customer_id, id: 'existing_customer_id' %>
              <label for="client-search">Search name or phone</label>
              <input type="search" id="client-search" class="form-control" placeholder="Type a name or phone" autocomplete="off" value="<%= selected ? "#{selected.full_name} · #{selected.phone}" : '' %>">
              <ul id="client-results" class="combo-list" hidden></ul>
              <div id="client-chip" class="client-chip" <%= 'hidden' unless selected %>>
                <span class="avatar" id="chip-initials"><%= selected&.initials %></span>
                <div>
                  <strong id="chip-name"><%= selected&.full_name %></strong>
                  <span id="chip-meta"><%= [selected&.phone, selected&.gst_number.present? ? "GST #{selected.gst_number}" : nil].compact.join(' · ') %></span>
                </div>
                <button type="button" class="atelier-back" id="client-clear">Change</button>
              </div>
            </div>

            <div id="new-client" class="client-pane" <%= 'hidden' if @customer_mode != 'new' %>>
              <div class="row">
                <div class="field">
                  <label for="customer_first_name">First name <span class="req">*</span></label>
                  <%= text_field_tag 'customer[first_name]', @draft_customer.first_name, class: 'form-control', id: 'customer_first_name', placeholder: 'Given name' %>
                </div>
                <div class="field">
                  <label for="customer_last_name">Last name</label>
                  <%= text_field_tag 'customer[last_name]', @draft_customer.last_name, class: 'form-control', id: 'customer_last_name', placeholder: 'Family name' %>
                </div>
              </div>
              <div class="row" style="margin-top:12px">
                <div class="field">
                  <label for="customer_phone">Phone <span class="req">*</span></label>
                  <%= telephone_field_tag 'customer[phone]', @draft_customer.phone, class: 'form-control', id: 'customer_phone', maxlength: 10, inputmode: 'numeric', placeholder: '10 digits' %>
                </div>
                <div class="field">
                  <label for="customer_email">Email</label>
                  <%= email_field_tag 'customer[email]', @draft_customer.email, class: 'form-control', id: 'customer_email', placeholder: 'name@example.com' %>
                </div>
              </div>
              <div class="row" style="margin-top:12px">
                <div class="field">
                  <label for="customer_aadhaar">Aadhaar / PAN</label>
                  <%= text_field_tag 'customer[aadhaar_or_pan]', @draft_customer.aadhaar_or_pan, class: 'form-control', id: 'customer_aadhaar' %>
                </div>
                <div class="field">
                  <label for="customer_gst">GSTIN</label>
                  <%= text_field_tag 'customer[gst_number]', @draft_customer.gst_number, class: 'form-control', id: 'customer_gst' %>
                </div>
              </div>
              <div class="row" style="margin-top:12px">
                <div class="field">
                  <label for="customer_address">Address</label>
                  <%= text_area_tag 'customer[address]', @draft_customer.address, class: 'form-control', id: 'customer_address', rows: 3 %>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="atelier-form" style="margin-top:16px">
          <div class="section">
            <h2>Catalogue pieces</h2>
            <p class="hint">Each row is one piece. Qty, net weight and ₹/g on the last line must be entered before you can add another. If qty is more than remaining stock, a message will appear. Gross cannot be lighter than net.</p>
            <div id="piece-rows"></div>
            <% if @items.any? %>
              <button type="button" class="atelier-back" id="add-piece">+ Add another piece</button>
            <% else %>
              <p class="hint" style="margin:0">No catalogue pieces with remaining quantity. <%= link_to 'Register a piece', new_jewelry_item_path, class: 'atelier-back', style: 'margin-left:8px' %></p>
            <% end %>
          </div>
        </section>

        <section class="atelier-form" style="margin-top:16px">
          <div class="section">
            <h2>Charges &amp; tax</h2>
            <p class="hint">Discount is taken before tax. Default CGST follows the house rates of <%= Order::DEFAULT_CGST_RATE %>% each.</p>
            <div class="row">
              <div class="field">
                <label for="discount">Discount (₹)</label>
                <%= number_field_tag :discount, ('%.2f' % @order.discount.to_f), step: 0.01, min: 0, class: 'form-control', id: 'discount' %>
              </div>
              <div class="field">
                <label for="charges">Extra charges (₹)</label>
                <%= number_field_tag :charges, ('%.2f' % @order.charges.to_f), step: 0.01, min: 0, class: 'form-control', id: 'charges' %>
              </div>
            </div>
            <div class="row" style="margin-top:12px">
              <div class="field">
                <label for="cgst_rate">CGST (%)</label>
                <%= number_field_tag :cgst_rate, ('%.2f' % (@order.cgst_rate.presence || Order::DEFAULT_CGST_RATE)), step: 0.01, min: 0, class: 'form-control', id: 'cgst_rate' %>
              </div>
              <div class="field">
                <label for="igst_rate">CGST (%)</label>
                <%= number_field_tag :igst_rate, ('%.2f' % (@order.igst_rate.presence || Order::DEFAULT_IGST_RATE)), step: 0.01, min: 0, class: 'form-control', id: 'igst_rate' %>
              </div>
            </div>
          </div>
          <div class="actions">
            <%= submit_tag 'Raise bill', class: 'btn-gold', id: 'raise-bill', disabled: true %>
            <%= link_to 'Cancel', orders_path, class: 'atelier-back' %>
          </div>
        </section>
      </div>

      <aside class="preview" aria-live="polite">
        <p class="preview-kicker">Invoice preview</p>
        <div class="gem avatar-lg" id="preview-initials" aria-hidden="true">—</div>
        <h2 id="preview-client">Select a client</h2>
        <span class="sku-chip" id="preview-phone">No phone yet</span>
        <div class="preview-lines" id="preview-lines"></div>
        <div class="preview-sum">
          <div><span>Subtotal</span><strong id="sum-subtotal">₹0.00</strong></div>
          <div><span>Discount</span><strong id="sum-discount">₹0.00</strong></div>
          <div><span>Charges</span><strong id="sum-charges">₹0.00</strong></div>
          <div><span>Taxable</span><strong id="sum-taxable">₹0.00</strong></div>
          <div><span>CGST</span><strong id="sum-cgst">₹0.00</strong></div>
          <div><span>CGST</span><strong id="sum-igst">₹0.00</strong></div>
        </div>
        <div class="preview-price" id="sum-total">₹0.00</div>
        <div class="preview-desc">Amount payable</div>
        <p class="preview-note" id="preview-note">The bill stays pending until payment is recorded.</p>
      </aside>
    </div>
  <% end %>

  <div id="qty-popup" class="qty-popup" hidden>
    <div class="qty-popup-card" role="alertdialog" aria-modal="true" aria-labelledby="qty-popup-msg">
      <p class="eyebrow">Stock</p>
      <p id="qty-popup-msg"></p>
      <button type="button" class="btn-gold" id="qty-popup-ok">OK</button>
    </div>
  </div>
</div>

<style>
  .sale-desk .atelier-grid { grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.85fr); }
  .sale-desk input[type=number]::-webkit-outer-spin-button,
  .sale-desk input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .sale-desk input[type=number] { -moz-appearance: textfield; }
  .sale-desk .mode-toggle {
    display: inline-flex; padding: 3px; border-radius: 999px; margin-bottom: 14px;
    border: 1px solid rgba(201,162,39,0.4); background: #fffaf3;
  }
  .sale-desk .mode {
    display: inline-flex; align-items: center; gap: 0; cursor: pointer;
    padding: 7px 14px; border-radius: 999px; font-size: 13px; font-weight: 700;
    color: #6b6258; letter-spacing: 0.04em;
  }
  .sale-desk .mode input { position: absolute; opacity: 0; pointer-events: none; }
  .sale-desk .mode.is-on { background: linear-gradient(90deg, #e8d5a3, #c9a227); color: #0b1220; }
  .sale-desk .client-pane { position: relative; }
  .sale-desk .combo-list {
    list-style: none; margin: 6px 0 0; padding: 6px; max-height: 240px; overflow: auto;
    background: #fff; border: 1px solid rgba(201,162,39,0.35); border-radius: 12px;
    box-shadow: 0 12px 28px rgba(20,17,15,0.08); position: absolute; left: 0; right: 0; z-index: 5;
  }
  .sale-desk .combo-list li {
    padding: 8px 10px; border-radius: 8px; cursor: pointer; display: flex; justify-content: space-between; gap: 8px;
  }
  .sale-desk .combo-list li:hover, .sale-desk .combo-list li.is-active { background: rgba(232,213,163,0.35); }
  .sale-desk .combo-list .muted { color: #6b6258; font-size: 12px; }
  .sale-desk .client-chip {
    margin-top: 12px; display: flex; align-items: center; gap: 12px;
    background: #f7f1e8; border: 1px solid rgba(201,162,39,0.28); border-radius: 14px; padding: 10px 12px;
  }
  .sale-desk .avatar, .sale-desk .avatar-lg {
    display: inline-flex; align-items: center; justify-content: center;
    background: #0b1220; color: #e8d5a3; font-weight: 700; letter-spacing: 0.06em;
  }
  .sale-desk .avatar { width: 40px; height: 40px; border-radius: 12px; font-size: 13px; }
  .sale-desk .avatar-lg { height: 120px; border-radius: 14px; font-size: 28px; }
  .sale-desk .client-chip strong { display: block; font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.15rem; }
  .sale-desk .client-chip span { color: #6b6258; font-size: 13px; }
  .sale-desk .client-chip .atelier-back { margin-left: auto; }
  .sale-desk .piece-card {
    border: 1px solid rgba(201,162,39,0.22); border-radius: 14px; padding: 14px;
    background: #fff; margin-bottom: 12px;
  }
  .sale-desk .piece-top { display: flex; gap: 10px; align-items: flex-start; }
  .sale-desk .piece-top .field { flex: 1; }
  .sale-desk .piece-meta { margin: 8px 0 0; color: #6b6258; font-size: 12px; }
  .sale-desk .piece-grid {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-top: 12px;
  }
  .sale-desk .piece-total {
    margin-top: 10px; text-align: right; color: #c9a227; font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .sale-desk .qty-popup {
    position: fixed; inset: 0; z-index: 80;
    display: flex; align-items: center; justify-content: center;
    background: rgba(11,18,32,0.45);
    padding: 20px;
  }
  .sale-desk .qty-popup[hidden] { display: none; }
  .sale-desk .qty-popup-card {
    width: min(420px, 100%);
    background: #fffaf3;
    border: 1px solid rgba(201,162,39,0.35);
    border-radius: 18px;
    padding: 22px 22px 18px;
    box-shadow: 0 24px 50px rgba(11,18,32,0.28);
  }
  .sale-desk .qty-popup-card .eyebrow { margin: 0 0 8px; }
  .sale-desk .qty-popup-card p#qty-popup-msg {
    margin: 0 0 16px; color: #14110f; font-size: 15px; line-height: 1.5;
  }
  .sale-desk .qty-popup-card .btn-gold { width: 100%; }
  .sale-desk .field-error { border-color: #9f1239 !important; box-shadow: 0 0 0 3px rgba(159,18,57,0.12) !important; }
  .sale-desk .preview-lines { margin: 14px 0 8px; }
  .sale-desk .preview-line-row {
    display: flex; justify-content: space-between; gap: 10px;
    font-size: 13px; color: #d6cbb8; padding: 6px 0;
    border-bottom: 1px solid rgba(232,213,163,0.12);
  }
  .sale-desk .preview-line-row strong { color: #e8d5a3; font-weight: 600; white-space: nowrap; }
  .sale-desk .preview-sum { margin-top: 10px; }
  .sale-desk .preview-sum div {
    display: flex; justify-content: space-between; font-size: 13px; color: #b7aa98; padding: 4px 0;
  }
  .sale-desk .preview-sum strong { color: #f7f1e8; font-variant-numeric: tabular-nums; }
  .sale-desk a.btn-gold, .sale-desk button.atelier-back { text-decoration: none; }
  .sale-desk #add-piece:disabled,
  .sale-desk #add-piece[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
    background: #f3eee6;
    color: #8a8072;
  }
  .sale-desk .actions .btn-gold,
  .sale-desk button.atelier-back,
  .sale-desk .client-chip .atelier-back { width: auto; }
  @media (max-width: 880px) {
    .sale-desk .piece-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  window.SALE = {
    items: <%= raw((@items || []).map(&:bill_payload).to_json) %>,
    customers: <%= raw((@customers || []).map(&:bill_payload).to_json) %>,
    draft: <%= raw((@draft_lines || []).to_json) %>,
    selectedId: <%= raw(@selected_customer_id.to_s.to_json) %>,
    mode: <%= raw((@customer_mode || 'existing').to_json) %>
  };

  (function(){
    var items = window.SALE.items || [];
    var customers = window.SALE.customers || [];
    var wrap = document.getElementById('piece-rows');
    var form = document.getElementById('order-form');
    var addBtn = document.getElementById('add-piece');
    var raiseBtn = document.getElementById('raise-bill');
    var errorBox = document.getElementById('form-error');
    var results = document.getElementById('client-results');
    var search = document.getElementById('client-search');
    var hiddenId = document.getElementById('existing_customer_id');

    function money(v){ return '\u20B9' + (isFinite(v) ? Number(v) : 0).toFixed(2); }
    function num(el){ return parseFloat((el && el.value) || 0) || 0; }
    function int(el){ return parseInt((el && el.value) || 0, 10) || 0; }
    function val(sel){ var el = document.querySelector(sel); return el ? el.value.trim() : ''; }
    function itemById(id){ return items.find(function(it){ return String(it.id) === String(id); }); }
    function customerById(id){ return customers.find(function(c){ return String(c.id) === String(id); }); }
    function mode(){ var on = document.querySelector('input[name="customer_mode"]:checked'); return on ? on.value : 'existing'; }
    function selectedIds(){
      var ids = [];
      wrap.querySelectorAll('.piece-id').forEach(function(s){ if(s.value) ids.push(String(s.value)); });
      return ids;
    }

    function setError(msg){
      if(!errorBox) return;
      if(!msg){ errorBox.hidden = true; errorBox.textContent = ''; return; }
      errorBox.hidden = false;
      errorBox.textContent = msg;
    }

    function mark(el, bad, show){ if(el && show) el.classList.toggle('field-error', !!bad); }

    function optionHtml(current){
      var taken = selectedIds();
      var html = '<option value="">Select a piece</option>';
      items.forEach(function(it){
        var used = taken.indexOf(String(it.id)) !== -1 && String(it.id) !== String(current);
        if(used) return;
        var label = [it.name, it.metal, it.purity, Number(it.weight_grams).toFixed(2) + ' g', it.quantity + ' pcs'].filter(Boolean).join(' · ');
        html += '<option value="'+it.id+'"'+(String(it.id)===String(current)?' selected':'')+'>'+label+'</option>';
      });
      return html;
    }

    function refreshSelects(){
      wrap.querySelectorAll('.piece-id').forEach(function(sel){
        var current = sel.value;
        sel.innerHTML = optionHtml(current);
        if(current) sel.value = current;
      });
      refreshAddButton();
    }

    function lastCard(){
      var cards = wrap.querySelectorAll('.piece-card');
      return cards.length ? cards[cards.length - 1] : null;
    }

    function lastRowReady(){
      var card = lastCard();
      if(!card) return false;
      var l = lineAmount(card);
      return !!(l.it && l.qty >= 1 && l.net > 0 && l.rate > 0);
    }

    function refreshAddButton(){
      if(!addBtn) return;
      var remaining = items.length > 0 && selectedIds().length < items.length;
      var ready = lastRowReady();
      addBtn.disabled = !(remaining && ready);
      addBtn.setAttribute('aria-disabled', addBtn.disabled ? 'true' : 'false');
      if(!remaining) addBtn.title = 'Every remaining catalogue piece is already on this bill.';
      else if(!ready) addBtn.title = 'Enter Qty, Net (g) and ₹/g on this piece first.';
      else addBtn.title = 'Add another piece';
    }

    function addRow(data){
      data = data || {};
      var id = data.jewelry_item_id || data.jewelryItemId || '';
      var card = document.createElement('div');
      card.className = 'piece-card';
      card.innerHTML =
        '<div class="piece-top">'+
          '<div class="field">'+
            '<label>Piece <span class="req">*</span></label>'+
            '<select name="line_items[][jewelry_item_id]" class="form-control piece-id"></select>'+
            '<p class="piece-meta">&nbsp;</p>'+
            '<input type="hidden" name="line_items[][hsn]" class="piece-hsn">'+
            '<input type="hidden" name="line_items[][huid]" class="piece-huid">'+
          '</div>'+
          '<button type="button" class="atelier-back piece-remove">Remove</button>'+
        '</div>'+
        '<div class="piece-grid">'+
          '<div class="field"><label>Qty <span class="req">*</span></label><input type="text" name="line_items[][quantity]" class="form-control piece-qty" inputmode="numeric" autocomplete="off" value="1"></div>'+
          '<div class="field"><label>Gross (g)</label><input type="number" name="line_items[][gross_weight]" class="form-control piece-gross" min="0" step="0.01"></div>'+
          '<div class="field"><label>Net (g) <span class="req">*</span></label><input type="number" name="line_items[][net_weight]" class="form-control piece-net" min="0" step="0.01"></div>'+
          '<div class="field"><label>\u20B9 / g <span class="req">*</span></label><input type="number" name="line_items[][rate_per_gram]" class="form-control piece-rate" min="0" step="0.01"></div>'+
          '<div class="field"><label>Making %</label><input type="number" name="line_items[][making_charge_percent]" class="form-control piece-making" min="0" step="0.01" value="0"></div>'+
          '<div class="field"><label>Add. \u20B9 / pc</label><input type="number" name="line_items[][additional_charge]" class="form-control piece-add" min="0" step="0.01" value="0"></div>'+
        '</div>'+
        '<div class="piece-total">Line total \u20B90.00</div>';
      wrap.appendChild(card);
      var sel = card.querySelector('.piece-id');
      sel.innerHTML = optionHtml('');
      if(id) sel.value = String(id);
      if(sel.value) applyItem(card, itemById(sel.value), data);
      else if(data && (data.net_weight || data.quantity)) applyDraft(card, data);
      bindRow(card);
      refreshSelects();
      recalc();
    }

    function applyDraft(card, data){
      card.querySelector('.piece-qty').value = data.quantity || 1;
      card.querySelector('.piece-gross').value = data.gross_weight || '';
      card.querySelector('.piece-net').value = data.net_weight || '';
      card.querySelector('.piece-rate').value = data.rate_per_gram || '';
      card.querySelector('.piece-making').value = data.making_charge_percent || 0;
      card.querySelector('.piece-add').value = data.additional_charge || 0;
    }

    function applyItem(card, it, data){
      data = data || {};
      var meta = card.querySelector('.piece-meta');
      if(!it){
        if(meta) meta.innerHTML = '&nbsp;';
        return;
      }
      var net = data.net_weight != null && data.net_weight !== '' ? data.net_weight : it.weight_grams;
      var gross = data.gross_weight != null && data.gross_weight !== '' ? data.gross_weight : net;
      card.querySelector('.piece-qty').value = data.quantity || 1;
      card.querySelector('.piece-net').value = Number(net).toFixed(2);
      card.querySelector('.piece-gross').value = Number(gross).toFixed(2);
      card.querySelector('.piece-rate').value = data.rate_per_gram != null && data.rate_per_gram !== '' ? data.rate_per_gram : (it.price_per_gram ? Number(it.price_per_gram).toFixed(2) : '');
      card.querySelector('.piece-making').value = data.making_charge_percent != null && data.making_charge_percent !== '' ? data.making_charge_percent : Number(it.making_percent || 0).toFixed(2);
      card.querySelector('.piece-add').value = data.additional_charge != null && data.additional_charge !== '' ? data.additional_charge : 0;
      card.querySelector('.piece-hsn').value = it.hsn || '';
      card.querySelector('.piece-huid').value = it.sku || '';
      if(meta){
        meta.textContent = [it.category, 'SKU ' + (it.sku || '—'), it.hsn ? ('HSN ' + it.hsn) : null, it.quantity + ' pcs remaining'].filter(Boolean).join(' · ');
      }
    }

    function lineAmount(card){
      var id = card.querySelector('.piece-id').value;
      var it = itemById(id);
      var qty = int(card.querySelector('.piece-qty'));
      var net = num(card.querySelector('.piece-net'));
      var rate = num(card.querySelector('.piece-rate'));
      var makingPct = num(card.querySelector('.piece-making'));
      var add = num(card.querySelector('.piece-add'));
      var metal = rate * net * qty;
      var making = metal * (makingPct / 100);
      return { it: it, qty: qty, net: net, gross: num(card.querySelector('.piece-gross')), rate: rate, makingPct: makingPct, add: add, metal: metal, making: making, total: metal + making + (add * qty) };
    }

    function qtyOverStock(card){
      var l = lineAmount(card);
      if(!l.it) return '';
      if(l.qty > l.it.quantity){
        return 'Only ' + l.it.quantity + ' pcs of ' + l.it.name + ' remain. Qty cannot be more than available stock.';
      }
      return '';
    }

    function showQtyPopup(msg){
      var pop = document.getElementById('qty-popup');
      var text = document.getElementById('qty-popup-msg');
      if(!pop || !text){ window.alert(msg); return; }
      text.textContent = msg;
      pop.hidden = false;
    }

    function hideQtyPopup(){
      var pop = document.getElementById('qty-popup');
      if(pop) pop.hidden = true;
    }

    function bindRow(card){
      card.querySelector('.piece-id').addEventListener('change', function(){
        applyItem(card, itemById(this.value), {});
        refreshSelects();
        recalc();
      });
      card.querySelector('.piece-remove').addEventListener('click', function(){
        var cards = wrap.querySelectorAll('.piece-card');
        if(cards.length <= 1){ setError('A bill needs at least one piece.'); return; }
        card.remove();
        refreshSelects();
        recalc();
      });
      card.querySelectorAll('input').forEach(function(el){
        el.addEventListener('input', function(){
          el.classList.remove('field-error');
          if(el.classList.contains('piece-qty')){
            var cleaned = (el.value || '').replace(/\D/g, '');
            if(el.value !== cleaned) el.value = cleaned;
          }
          recalc();
        });
      });
      card.querySelector('.piece-qty').addEventListener('blur', function(){
        var msg = qtyOverStock(card);
        if(msg) showQtyPopup(msg);
      });
    }

    function clientValid(){
      if(mode() === 'new'){
        var phone = val('#customer_phone').replace(/\D/g,'');
        return !!(val('#customer_first_name') && phone.length === 10);
      }
      return !!(hiddenId && hiddenId.value);
    }

    function linesValid(show){
      var cards = wrap.querySelectorAll('.piece-card');
      var used = [];
      cards.forEach(function(card){
        if(card.querySelector('.piece-id').value) used.push(card);
      });
      if(!used.length){ if(show) setError('Add at least one catalogue piece to the bill.'); return false; }
      var ok = true;
      var message = '';
      var seen = {};
      used.forEach(function(card, i){
        var l = lineAmount(card);
        var n = i + 1;
        var sel = card.querySelector('.piece-id');
        var qtyEl = card.querySelector('.piece-qty');
        var netEl = card.querySelector('.piece-net');
        var grossEl = card.querySelector('.piece-gross');
        var rateEl = card.querySelector('.piece-rate');
        mark(sel, !sel.value, show);
        mark(qtyEl, l.qty < 1 || (l.it && l.qty > l.it.quantity), show);
        mark(netEl, l.net <= 0, show);
        mark(grossEl, l.gross > 0 && l.gross < l.net, show);
        mark(rateEl, l.rate <= 0, show);
        if(!sel.value){ ok = false; message = message || 'Piece ' + n + ': choose a catalogue piece.'; }
        else if(seen[sel.value]){ ok = false; message = message || l.it.name + ' is already on this bill.'; }
        else seen[sel.value] = true;
        if(l.qty < 1){ ok = false; message = message || 'Piece ' + n + ': quantity must be at least 1.'; }
        else if(l.it && l.qty > l.it.quantity){
          if(show) ok = false;
        }
        if(l.net <= 0){ ok = false; message = message || 'Piece ' + n + ': net weight must be greater than 0 g.'; }
        if(l.gross > 0 && l.gross < l.net){ ok = false; message = message || 'Piece ' + n + ': gross weight cannot be less than net weight.'; }
        if(l.rate <= 0){ ok = false; message = message || 'Piece ' + n + ': set a \u20B9 per gram rate.'; }
        if(l.makingPct < 0 || l.add < 0){ ok = false; message = message || 'Piece ' + n + ': charges cannot be negative.'; }
      });
      var discount = num(document.getElementById('discount'));
      var charges = num(document.getElementById('charges'));
      var cgst = num(document.getElementById('cgst_rate'));
      var igst = num(document.getElementById('igst_rate'));
      mark(document.getElementById('discount'), discount < 0, show);
      mark(document.getElementById('charges'), charges < 0, show);
      mark(document.getElementById('cgst_rate'), cgst < 0, show);
      mark(document.getElementById('igst_rate'), igst < 0, show);
      if(discount < 0){ ok = false; message = message || 'Discount cannot be negative.'; }
      if(charges < 0){ ok = false; message = message || 'Extra charges cannot be negative.'; }
      if(cgst < 0 || igst < 0){ ok = false; message = message || 'Tax rates cannot be negative.'; }
      var subtotal = 0;
      cards.forEach(function(card){ subtotal += lineAmount(card).total; });
      if(discount > subtotal){ ok = false; message = message || 'Discount cannot exceed the bill subtotal.'; mark(document.getElementById('discount'), true, show); }
      if(show && !ok) setError(message);
      return ok;
    }

    function formValid(show){
      var cOk = clientValid();
      if(mode() === 'existing'){
        mark(search, !cOk, show);
      } else {
        mark(document.getElementById('customer_first_name'), !val('#customer_first_name'), show);
        mark(document.getElementById('customer_phone'), val('#customer_phone').replace(/\D/g,'').length !== 10, show);
      }
      if(!cOk){
        if(show) setError(mode() === 'new' ? 'Give the client a first name and a 10-digit phone.' : 'Choose a client on the book, or register a new one.');
        return false;
      }
      return linesValid(show);
    }

    function recalc(){
      var cards = wrap.querySelectorAll('.piece-card');
      var subtotal = 0;
      var html = '';
      cards.forEach(function(card){
        var l = lineAmount(card);
        card.querySelector('.piece-total').textContent = 'Line total ' + money(l.total);
        subtotal += l.total;
        if(l.it){
          html += '<div class="preview-line-row"><span>'+l.it.name+' · '+l.qty+' × '+l.net.toFixed(2)+' g</span><strong>'+money(l.total)+'</strong></div>';
        }
      });
      var discount = Math.max(0, num(document.getElementById('discount')));
      var charges = Math.max(0, num(document.getElementById('charges')));
      var taxable = subtotal - discount + charges;
      var cgst = taxable * (num(document.getElementById('cgst_rate')) / 100);
      var igst = taxable * (num(document.getElementById('igst_rate')) / 100);
      var total = taxable + cgst + igst;
      document.getElementById('sum-subtotal').textContent = money(subtotal);
      document.getElementById('sum-discount').textContent = money(discount);
      document.getElementById('sum-charges').textContent = money(charges);
      document.getElementById('sum-taxable').textContent = money(taxable);
      document.getElementById('sum-cgst').textContent = money(cgst);
      document.getElementById('sum-igst').textContent = money(igst);
      document.getElementById('sum-total').textContent = money(total);
      document.getElementById('preview-lines').innerHTML = html || '<div class="preview-line-row"><span>No pieces yet</span><strong>\u20B90.00</strong></div>';
      if(raiseBtn) raiseBtn.disabled = !formValid(false);
      refreshAddButton();
      document.getElementById('preview-note').textContent = formValid(false) ? 'Ready to raise. The bill stays pending until payment is recorded.' : 'Name the client and complete each piece to raise the bill.';
    }

    function setMode(next){
      document.querySelectorAll('.mode').forEach(function(lab){
        lab.classList.toggle('is-on', lab.querySelector('input').value === next);
      });
      document.getElementById('existing-client').hidden = next === 'new';
      document.getElementById('new-client').hidden = next !== 'new';
      if(next === 'new' && hiddenId) hiddenId.value = '';
      recalc();
      renderClient();
    }

    function pickCustomer(c){
      if(!hiddenId) return;
      hiddenId.value = c ? c.id : '';
      if(search) search.value = c ? (c.name + ' · ' + c.phone) : '';
      var chip = document.getElementById('client-chip');
      if(c){
        chip.hidden = false;
        document.getElementById('chip-initials').textContent = c.initials || '—';
        document.getElementById('chip-name').textContent = c.name;
        document.getElementById('chip-meta').textContent = [c.phone, c.gst ? ('GST ' + c.gst) : null].filter(Boolean).join(' · ');
      } else {
        chip.hidden = true;
      }
      if(results) results.hidden = true;
      renderClient();
      recalc();
    }

    function renderClient(){
      var name = 'Select a client';
      var phone = 'No phone yet';
      var initials = '—';
      if(mode() === 'new'){
        var first = val('#customer_first_name');
        var last = val('#customer_last_name');
        name = [first, last].filter(Boolean).join(' ') || 'New client';
        phone = val('#customer_phone') || 'Phone will appear here';
        initials = ((first[0] || '') + (last[0] || '') || first.slice(0,2) || '—').toUpperCase();
      } else {
        var c = customerById(hiddenId && hiddenId.value);
        if(c){
          name = c.name;
          phone = c.phone || 'No phone';
          initials = c.initials || '—';
        }
      }
      document.getElementById('preview-client').textContent = name;
      document.getElementById('preview-phone').textContent = phone;
      document.getElementById('preview-initials').textContent = initials || '—';
    }

    function filterCustomers(q){
      q = (q || '').toLowerCase();
      return customers.filter(function(c){
        return !q || (c.name + ' ' + c.phone + ' ' + (c.email || '') + ' ' + (c.gst || '')).toLowerCase().indexOf(q) !== -1;
      }).slice(0, 12);
    }

    function showResults(list){
      if(!results) return;
      if(!list.length){ results.hidden = true; results.innerHTML = ''; return; }
      results.innerHTML = list.map(function(c){
        return '<li data-id="'+c.id+'"><span>'+c.name+'</span><span class="muted">'+c.phone+'</span></li>';
      }).join('');
      results.hidden = false;
    }

    document.querySelectorAll('input[name="customer_mode"]').forEach(function(r){
      r.addEventListener('change', function(){ setMode(this.value); });
    });
    if(search){
      search.addEventListener('focus', function(){ showResults(filterCustomers(search.value)); });
      search.addEventListener('input', function(){
        if(hiddenId) hiddenId.value = '';
        document.getElementById('client-chip').hidden = true;
        showResults(filterCustomers(search.value));
        renderClient();
        recalc();
      });
    }
    if(results){
      results.addEventListener('mousedown', function(e){
        var li = e.target.closest('li');
        if(!li) return;
        pickCustomer(customerById(li.getAttribute('data-id')));
      });
    }
    document.addEventListener('click', function(e){
      if(results && !results.contains(e.target) && e.target !== search) results.hidden = true;
    });
    var clearBtn = document.getElementById('client-clear');
    if(clearBtn) clearBtn.addEventListener('click', function(){ pickCustomer(null); if(search) search.focus(); });

    ['customer_first_name','customer_last_name','customer_phone','customer_email','discount','charges','cgst_rate','igst_rate'].forEach(function(id){
      var el = document.getElementById(id);
      if(!el) return;
      el.addEventListener('input', function(){
        if(id === 'customer_phone'){
          var cleaned = (el.value || '').replace(/\D/g,'').slice(0,10);
          if(el.value !== cleaned) el.value = cleaned;
        }
        el.classList.remove('field-error');
        renderClient();
        recalc();
      });
    });

    if(addBtn) addBtn.addEventListener('click', function(e){
      e.preventDefault();
      if(addBtn.disabled || !lastRowReady()) return;
      if(selectedIds().length >= items.length) return;
      addRow({});
      var next = lastCard();
      if(next){
        var sel = next.querySelector('.piece-id');
        if(sel) sel.focus();
      }
    });
    if(form) form.addEventListener('keydown', function(e){
      if(e.key !== 'Enter') return;
      if(e.target && (e.target.tagName === 'TEXTAREA' || e.target.id === 'raise-bill')) return;
      e.preventDefault();
    });
    var popupOk = document.getElementById('qty-popup-ok');
    if(popupOk) popupOk.addEventListener('click', hideQtyPopup);
    var popup = document.getElementById('qty-popup');
    if(popup) popup.addEventListener('click', function(e){ if(e.target === popup) hideQtyPopup(); });
    if(form) form.addEventListener('submit', function(e){
      var stockMsg = '';
      wrap.querySelectorAll('.piece-card').forEach(function(card){
        if(!stockMsg) stockMsg = qtyOverStock(card);
      });
      if(stockMsg){
        e.preventDefault();
        showQtyPopup(stockMsg);
        return false;
      }
      if(!formValid(true)){ e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
    });

    var draft = window.SALE.draft || [];
    if(items.length === 0){
      recalc();
      renderClient();
    } else if(draft.length){
      draft.forEach(function(row){ addRow(row); });
    } else {
      addRow({});
    }
    if(window.SALE.selectedId) pickCustomer(customerById(window.SALE.selectedId));
    setMode(mode());
    if(errorBox && errorBox.textContent.trim()) errorBox.hidden = false;
  })();
</script>
