<%= render 'shared/atelier_styles' %>

<%
  house = @house_name.to_s
  now = @now || Time.zone.now
  greeting = if now.hour < 12 then 'Good morning'
             elsif now.hour < 17 then 'Good afternoon'
             else 'Good evening'
             end
  report = @report
  week = @week
  month = @month
  series = @series || []
  series_max = @series_max.to_f
  tray = report.tray
  vault = report.vault
  khata = report.khata
  board = (report.board || []).select { |row| row[:purities].any? }
  today_bills = report.bills
  latest = @latest.to_a
  due = report.due_clients
  light_pieces = tray[:light] || []
  vault_alerts = ((vault[:light] || []) + (vault[:empty] || [])).uniq.first(5)
  word = lambda do |count, one, many|
    "#{count} #{count == 1 ? one : many}"
  end
%>

<div class="atelier-page house-desk" id="house-desk">
  <header class="atelier-hero">
    <div>
      <p class="eyebrow">Desk</p>
      <h1><%= greeting %>, <%= house %></h1>
      <p class="lead">The house at a glance — today’s bills, the board, the tray and khata, and anything that needs a look before the counter opens fully.</p>
    </div>
    <div class="desk-hero-meta">
      <div class="desk-clock">
        <span>As of</span>
        <strong>
          <em id="dashboard-date"><%= now.strftime('%d %b %Y') %></em>
          <b id="dashboard-clock"><%= now.strftime('%H:%M') %></b>
          IST
        </strong>
      </div>
      <div class="stock-hero-actions">
        <%= link_to 'House report', reports_path, class: 'atelier-back' %>
        <%= link_to 'Open the counter', pos_path, class: 'btn-gold' %>
      </div>
    </div>
  </header>

  <nav class="desk-go" aria-label="Open a book">
    <%= link_to 'Raise a bill', new_order_path %>
    <%= link_to 'Set a rate', new_rate_path %>
    <%= link_to 'Register a piece', new_jewelry_item_path %>
    <%= link_to 'Clients', customers_path %>
    <%= link_to 'Vault', metal_stocks_path %>
    <%= link_to 'Ledgers', ledgers_path %>
  </nav>

  <div class="desk-kpis">
    <div>
      <span>Today billed</span>
      <strong class="gold"><%= format_rupees(report.bill_total) %></strong>
      <em><%= word.call(report.bill_count, 'bill', 'bills') %> · <%= '%.2f' % report.grams %> g</em>
    </div>
    <div>
      <span>House result today</span>
      <strong class="<%= report.house_result.negative? ? 'is-loss' : 'gold' %>"><%= format_rupees(report.house_result) %></strong>
      <em>Making after courtesy · <%= '%.0f' % report.margin_percent %>% of taxable</em>
    </div>
    <div>
      <span>This week</span>
      <strong><%= format_rupees(week.bill_total) %></strong>
      <em><%= word.call(week.bill_count, 'bill', 'bills') %> · <%= week.pieces %> pcs</em>
    </div>
    <div>
      <span>This month</span>
      <strong><%= format_rupees(month.bill_total) %></strong>
      <em><%= month.label %> · <%= format_rupees(month.house_result) %> kept</em>
    </div>
  </div>

  <div class="desk-stand">
    <div>
      <span>Tray</span>
      <strong><%= tray[:live_pcs] %> <i>pcs</i></strong>
      <em><%= format_rupees(tray[:value]) %> at the board · <%= '%.2f' % tray[:grams] %> g</em>
      <%= link_to 'Catalogue', jewelry_items_path %>
    </div>
    <div>
      <span>Vault</span>
      <strong><%= vault[:grams] %> <i>g</i></strong>
      <em><%= format_rupees(vault[:value]) %> · <%= word.call(vault[:cards], 'card', 'cards') %></em>
      <%= link_to 'Metal stock', metal_stocks_path %>
    </div>
    <div>
      <span>Receivable</span>
      <strong class="gold"><%= format_rupees(khata[:receivable]) %></strong>
      <em><%= word.call(khata[:due], 'khata due', 'khatas due') %> · <%= format_rupees(khata[:advances]) %> advance</em>
      <%= link_to 'Ledgers', ledgers_path %>
    </div>
    <div>
      <span>Taken today</span>
      <strong><%= format_rupees(report.receipts) %></strong>
      <em>GST on today’s bills <%= format_rupees(report.gst) %> · <%= report.open_bills %> still open</em>
      <%= link_to 'Sales log', sales_log_reports_path %>
    </div>
  </div>

  <div class="atelier-grid">
    <div>
      <section class="atelier-form">
        <div class="section">
          <h2>Today at the desk</h2>
          <p class="hint">
            <% if report.bill_count.zero? %>
              No invoice yet today. The list below is the latest work on the book.
            <% else %>
              <%= word.call(report.bill_count, 'bill', 'bills') %> raised today —
              metal <%= format_rupees(report.metal) %>, making <%= format_rupees(report.making) %>,
              GST <%= format_rupees(report.gst) %> held for government.
            <% end %>
          </p>
          <% rows = report.bill_count.positive? ? today_bills : latest.first(6) %>
          <% if rows.any? %>
            <div class="stock-table-wrap">
              <table class="stock-table">
                <thead>
                  <tr>
                    <th>Bill</th>
                    <th>Client</th>
                    <th class="num">Net</th>
                    <th class="num">Total</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% rows.each do |row| %>
                    <%
                      if row.is_a?(Hash)
                        order = row[:order]
                        invoice = row[:invoice]
                        when_at = row[:date]
                        client = row[:client]
                        grams = row[:grams]
                        total = row[:total]
                        status = row[:status]
                      else
                        order = row
                        bill = row.bill_breakdown
                        invoice = row.invoice_number.presence || "Bill ##{row.id}"
                        when_at = row.sale_date || row.created_at.to_date
                        client = row.customer
                        grams = row.line_items.to_a.sum { |li| li.net_weight.to_f * li.quantity.to_i }
                        total = bill[:total]
                        status = row.status
                      end
                    %>
                    <tr>
                      <td>
                        <%= link_to order_path(order), class: 'piece-link' do %>
                          <strong><%= invoice %></strong>
                          <span class="sku"><%= when_at.strftime('%d %b %Y') %> · <%= status == 'paid' ? 'Settled' : 'Open' %></span>
                        <% end %>
                      </td>
                      <td>
                        <% if client %>
                          <%= link_to client.full_name.presence || 'Client', customer_path(client), class: 'piece-link' %>
                        <% else %>
                          Walk-in
                        <% end %>
                      </td>
                      <td class="num"><%= '%.2f' % grams %> g</td>
                      <td class="num gold"><%= format_rupees(total) %></td>
                      <td><%= link_to 'Bill', order_path(order), class: 'atelier-back' %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="hint" style="margin:0">The book is quiet. <%= link_to 'Raise a bill', new_order_path %> or <%= link_to 'open the counter', pos_path %>.</p>
          <% end %>
        </div>
      </section>

      <% if series.any? %>
        <section class="atelier-form" style="margin-top:18px">
          <div class="section">
            <h2>Seven days of bills</h2>
            <p class="hint">Bill totals as written, GST included. Gold marks the busier days.</p>
            <div class="pl-spark" aria-hidden="true">
              <% series.each do |point| %>
                <% height = series_max.positive? ? [(point[:value] / series_max * 100).round, point[:value].positive? ? 8 : 3].max : 3 %>
                <div class="pl-spark-col" title="<%= point[:hint] %>: <%= format_rupees(point[:value]) %>">
                  <span style="height: <%= height %>%"></span>
                  <small><%= point[:label] %></small>
                </div>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="preview">
      <div class="card-head">
        <p class="preview-kicker">Today’s board</p>
        <span class="client-ref"><%= now.strftime('%d %b') %></span>
      </div>
      <% if board.any? %>
        <% board.first(3).each do |metal_row| %>
          <div class="desk-board-metal">
            <p class="preview-line" style="margin:10px 0 6px">
              <i class="swatch" style="background:<%= metal_row[:colour] %>"></i>
              <%= metal_row[:name] %>
              <% if metal_row[:locked] %><em>Inactive</em><% end %>
            </p>
            <ul class="desk-board-list">
              <% metal_row[:purities].first(4).each do |purity| %>
                <li>
                  <span><%= purity[:name] %></span>
                  <b><%= purity[:rate].positive? ? "#{format_rupees(purity[:rate])}/g" : '—' %></b>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% else %>
        <p class="preview-desc">No hallmark is on the board yet. Set ₹ per gram so the catalogue and the counter read the same figure.</p>
      <% end %>
      <p class="preview-note" style="margin-top:16px"><%= link_to 'Set today’s rate', new_rate_path, class: 'desk-preview-link' %></p>
    </aside>
  </div>

  <% metals_mix = report.by_metal %>
  <% if metals_mix.any? %>
    <h2 class="pl-block-title">Metal that moved today</h2>
    <p class="hint pl-block-hint">Grams on today’s bills. Making is the house share on that metal.</p>
    <div class="pl-metals">
      <% metals_mix.each do |row| %>
        <div class="pl-metal">
          <span class="swatch" style="background:<%= row[:colour] %>"></span>
          <div>
            <strong><%= row[:name] %></strong>
            <span><%= '%.2f' % row[:grams] %> g · <%= row[:pcs] %> <%= row[:pcs] == 1 ? 'pc' : 'pcs' %></span>
          </div>
          <b><%= format_rupees(row[:house]) %></b>
        </div>
      <% end %>
    </div>
  <% end %>

  <% attention = light_pieces.any? || vault_alerts.any? || tray[:stock_out].to_i.positive? || due.any? || tray[:locked].to_i.positive? %>
  <h2 class="pl-block-title">Needs a look</h2>
  <p class="hint pl-block-hint">Light trays, thin vaults, and khatas that still owe the house — before the next bill is raised.</p>
  <% if attention %>
    <div class="desk-alert">
      <div class="atelier-form">
        <div class="section">
          <h2>Stock</h2>
          <% if tray[:stock_out].to_i.positive? || tray[:locked].to_i.positive? %>
            <p class="hint"><%= tray[:stock_out].to_i %> designs are off the tray. <%= tray[:locked].to_i %> locked by an inactive metal or hallmark.</p>
          <% end %>
          <% if light_pieces.any? %>
            <ul class="report-list">
              <% light_pieces.each do |item| %>
                <li><%= link_to item.name, jewelry_item_path(item) %> · <%= item.quantity.to_i %> pcs · <%= item.sku %></li>
              <% end %>
            </ul>
          <% end %>
          <% if vault_alerts.any? %>
            <ul class="report-list">
              <% vault_alerts.each do |card| %>
                <li>
                  <%= link_to metal_stock_path(card) do %>
                    <%= card.metal&.name %> at <%= card.store&.name %>
                  <% end %>
                  · <%= card.available_grams.to_i %> g
                  <%= card.empty? ? '· empty' : '· light' %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <% if light_pieces.empty? && vault_alerts.empty? && tray[:stock_out].to_i.zero? %>
            <p class="hint" style="margin:0">Tray and vault look steady.</p>
          <% end %>
        </div>
      </div>
      <div class="atelier-form">
        <div class="section">
          <h2>Khatas still due</h2>
          <% if due.any? %>
            <ul class="report-facts">
              <% due.each do |client| %>
                <li>
                  <%= link_to client.full_name.presence || 'Client', ledger_path(client) %>
                  <b><%= format_rupees(client.outstanding) %></b>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="hint" style="margin:0">No client currently owes the house.</p>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="atelier-form">
      <p class="hint" style="margin:0">Tray, vault and khata are quiet. The house is in good order this morning.</p>
    </div>
  <% end %>
</div>

<style>
  .container:has(.house-desk) { max-width: 1240px; }
  .house-desk a.btn-gold { text-decoration: none; display: inline-flex; align-items: center; }
  .house-desk .desk-hero-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .house-desk .stock-hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .house-desk .desk-clock span {
    display: block; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #6b6258; font-weight: 700; text-align: right;
  }
  .house-desk .desk-clock strong {
    display: block; color: #0b1220; font-variant-numeric: tabular-nums; font-size: 15px;
  }
  .house-desk .desk-clock em { font-style: normal; }
  .house-desk .desk-clock b { font-weight: 700; color: #c9a227; margin-left: 8px; }
  .house-desk .desk-go {
    display: flex; flex-wrap: wrap; gap: 8px; margin: -6px 0 18px;
  }
  .house-desk .desk-go a {
    display: inline-flex; padding: 7px 14px; border-radius: 999px;
    border: 1px solid rgba(201,162,39,0.4); background: #fffaf3;
    color: #0b1220; text-decoration: none; font-size: 13px; font-weight: 700;
  }
  .house-desk .desk-go a:hover { background: #f7f1e8; }
  .house-desk .desk-kpis {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 12px;
  }
  .house-desk .desk-kpis > div,
  .house-desk .desk-stand > div {
    background: #fffaf3; border: 1px solid rgba(201,162,39,0.28); border-radius: 16px; padding: 14px 16px;
  }
  .house-desk .desk-kpis span, .house-desk .desk-stand span {
    display: block; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #6b6258; font-weight: 700;
  }
  .house-desk .desk-kpis strong {
    display: block; margin-top: 6px; font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.55rem; font-weight: 600; color: #0b1220; font-variant-numeric: tabular-nums;
  }
  .house-desk .desk-kpis strong.gold, .house-desk .gold { color: #c9a227; }
  .house-desk .desk-kpis strong.is-loss { color: #7f1d1d; }
  .house-desk .desk-kpis em, .house-desk .desk-stand em {
    display: block; margin-top: 4px; font-style: normal; font-size: 12px; color: #6b6258;
  }
  .house-desk .desk-stand {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 22px;
  }
  .house-desk .desk-stand strong {
    display: block; margin-top: 4px; font-size: 1.15rem; color: #0b1220; font-variant-numeric: tabular-nums;
  }
  .house-desk .desk-stand strong.gold { color: #c9a227; }
  .house-desk .desk-stand i { font-style: normal; font-size: 12px; color: #6b6258; font-weight: 600; }
  .house-desk .desk-stand a {
    display: inline-block; margin-top: 8px; font-size: 12px; font-weight: 700; color: #0b1220; text-decoration: none;
    border-bottom: 1px solid rgba(201,162,39,0.5);
  }
  .house-desk .stock-table-wrap {
    background: #fff; border: 1px solid rgba(201,162,39,0.22); border-radius: 14px; overflow: auto;
  }
  .house-desk .stock-table { width: 100%; border-collapse: collapse; }
  .house-desk .stock-table th {
    text-align: left; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #6b6258; padding: 10px 12px; border-bottom: 1px solid rgba(201,162,39,0.22); background: #f7f1e8;
  }
  .house-desk .stock-table td { padding: 10px 12px; border-bottom: 1px solid rgba(201,162,39,0.12); vertical-align: top; }
  .house-desk .stock-table tr:last-child td { border-bottom: 0; }
  .house-desk .num { text-align: right; font-variant-numeric: tabular-nums; }
  .house-desk .piece-link { color: inherit; text-decoration: none; display: block; }
  .house-desk .piece-link strong { display: block; color: #0b1220; }
  .house-desk .sku { display: block; color: #6b6258; font-size: 12px; margin-top: 2px; }
  .house-desk td .atelier-back { padding: 5px 10px; font-size: 12px; }
  .house-desk .pl-spark { display: flex; align-items: flex-end; gap: 6px; height: 110px; padding-bottom: 22px; }
  .house-desk .pl-spark-col { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; }
  .house-desk .pl-spark-col span {
    display: block; width: 100%; max-width: 28px; border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, #e8d5a3, #c9a227); min-height: 3px;
  }
  .house-desk .pl-spark-col small { margin-top: 6px; font-size: 10px; color: #6b6258; letter-spacing: 0.04em; }
  .house-desk .desk-board-metal .swatch {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle;
  }
  .house-desk .desk-board-list { list-style: none; margin: 0 0 8px; padding: 0; }
  .house-desk .desk-board-list li {
    display: flex; justify-content: space-between; gap: 10px; padding: 5px 0;
    border-bottom: 1px dashed rgba(232,213,163,0.2); font-size: 13px; color: #d6cbb8;
  }
  .house-desk .desk-board-list li:last-child { border-bottom: 0; }
  .house-desk .desk-board-list b { color: #e8d5a3; font-variant-numeric: tabular-nums; }
  .house-desk .desk-preview-link { color: #e8d5a3; font-weight: 700; text-decoration: none; }
  .house-desk .pl-block-title {
    font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.4rem; font-weight: 600;
    margin: 28px 0 0; color: #0b1220;
  }
  .house-desk .pl-block-hint { margin: 4px 0 14px; color: #6b6258; }
  .house-desk .pl-metals { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .house-desk .pl-metal {
    display: flex; align-items: center; gap: 12px; padding: 14px 16px;
    background: #fffaf3; border: 1px solid rgba(201,162,39,0.28); border-radius: 14px;
  }
  .house-desk .pl-metal .swatch { width: 12px; height: 36px; border-radius: 999px; flex-shrink: 0; }
  .house-desk .pl-metal strong { display: block; color: #0b1220; }
  .house-desk .pl-metal span { display: block; font-size: 12px; color: #6b6258; margin-top: 2px; }
  .house-desk .pl-metal b { margin-left: auto; color: #c9a227; font-variant-numeric: tabular-nums; }
  .house-desk .desk-alert { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .house-desk .report-list, .house-desk .report-facts { list-style: none; margin: 0; padding: 0; }
  .house-desk .report-list li, .house-desk .report-facts li {
    padding: 8px 0; border-bottom: 1px dashed rgba(201,162,39,0.22); font-size: 13px;
  }
  .house-desk .report-facts li { display: flex; justify-content: space-between; gap: 12px; }
  .house-desk .report-list a, .house-desk .report-facts a { color: #0b1220; font-weight: 600; text-decoration: none; }
  .house-desk .report-facts b { font-variant-numeric: tabular-nums; color: #c9a227; }
  @media (max-width: 960px) {
    .house-desk .desk-kpis, .house-desk .desk-stand, .house-desk .desk-alert { grid-template-columns: 1fr 1fr; }
    .house-desk .desk-hero-meta { align-items: flex-start; width: 100%; }
  }
  @media (max-width: 640px) {
    .house-desk .desk-kpis, .house-desk .desk-stand, .house-desk .desk-alert { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function(){
    var desk = document.getElementById('house-desk');
    if (!desk) return;
    var dEl = document.getElementById('dashboard-date');
    var tEl = document.getElementById('dashboard-clock');
    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    function pad(n){ return (n < 10 ? '0' : '') + n; }
    function tick(){
      var now = new Date();
      var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      var ist = new Date(utc + (5.5 * 60 * 60000));
      if (dEl) dEl.textContent = pad(ist.getDate()) + ' ' + months[ist.getMonth()] + ' ' + ist.getFullYear();
      if (tEl) tEl.textContent = pad(ist.getHours()) + ':' + pad(ist.getMinutes());
    }
    tick();
    if (window._houseDeskClock) clearInterval(window._houseDeskClock);
    window._houseDeskClock = setInterval(tick, 30000);
  })();
</script>
