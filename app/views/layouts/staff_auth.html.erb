<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Employee portal login</title>
    <%= csrf_meta_tags %>
    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: radial-gradient(800px 400px at 50% 0%, rgba(201,162,39,0.18), transparent 55%), #070d18;
        font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; color: #e5eef8;
      }
      .card { width: 420px; background: #0f1b2e; border: 1px solid rgba(255,255,255,0.07); border-radius: 18px; overflow: hidden; }
      header { padding: 28px; text-align: center; background: #0b1220; }
      h1 { margin: 8px 0 0; font-size: 1.4rem; }
      p { color: #94a3b8; font-size: 13px; }
      .body { padding: 24px 28px 28px; }
      label { display: block; font-size: 13px; margin-bottom: 6px; color: #cbd5e1; }
      input { width: 100%; padding: 11px 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); background: #0b1220; color: #fff; margin-bottom: 12px; }
      .btn { width: 100%; padding: 12px; border: 0; border-radius: 10px; font-weight: 700; cursor: pointer; background: linear-gradient(90deg,#f4e2a8,#c9a227); color: #111; }
      .error { background: rgba(220,38,38,0.15); color: #fecaca; padding: 10px; border-radius: 8px; margin-bottom: 12px; font-size: 13px; }
      .hint { text-align: center; color: #64748b; font-size: 12px; margin-top: 14px; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
