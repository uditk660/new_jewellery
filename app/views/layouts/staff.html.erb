<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Licence desk · Strucxil</title>
    <%= render 'layouts/favicon' %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <style>
      :root {
        --navy: #0b1220;
        --ink: #14110f;
        --gold: #c9a227;
        --gold-soft: #e8d5a3;
        --ivory: #f7f1e8;
        --cream: #fffaf3;
        --muted: #8a8072;
        --line: rgba(201,162,39,0.28);
        --serif: "Cormorant Garamond", Georgia, serif;
        --sans: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body.staff {
        font-family: var(--sans);
        background: #f3eee6;
        color: var(--ink);
        height: 100%;
        overflow: hidden;
      }
      a { color: inherit; }
      .ep-shell {
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
      }
      .ep-side {
        background: linear-gradient(180deg, #16120e, #0b1220);
        color: #f7f1e8;
        padding: 24px 18px;
        display: flex; flex-direction: column;
        border-right: 1px solid rgba(232,213,163,0.18);
        height: 100%;
        position: sticky;
        top: 0;
        overflow: auto;
        overscroll-behavior: contain;
      }
      .ep-brand { display: flex; gap: 12px; align-items: center; margin-bottom: 28px; text-decoration: none; color: inherit; }
      .ep-mark {
        width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
        display: grid; place-items: center;
        background: linear-gradient(135deg, #e8d5a3, #c9a227);
        color: #0b1220; font-weight: 800; font-size: 15px;
      }
      .ep-brand strong { display: block; font-family: var(--serif); font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; }
      .ep-brand span { display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #e8d5a3; }
      .ep-nav-label {
        font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
        color: #8a8072; font-weight: 700; margin: 18px 8px 6px;
      }
      .ep-nav a {
        display: flex; align-items: center; justify-content: space-between;
        padding: 9px 12px; border-radius: 10px; color: #d6cbb8;
        text-decoration: none; font-size: 13px; font-weight: 600; margin-bottom: 2px;
      }
      .ep-nav a:hover { background: rgba(255,255,255,0.04); color: #fff; }
      .ep-nav a.is-on { background: linear-gradient(90deg, rgba(232,213,163,0.2), rgba(201,162,39,0.12)); color: #e8d5a3; }
      .ep-nav em {
        font-style: normal; min-width: 1.4em; text-align: center;
        padding: 1px 7px; border-radius: 999px; background: rgba(201,162,39,0.18);
        color: #e8d5a3; font-size: 11px; font-variant-numeric: tabular-nums;
      }
      .ep-foot { margin-top: auto; padding-top: 18px; border-top: 1px solid rgba(232,213,163,0.12); }
      .ep-who strong { display: block; font-size: 14px; }
      .ep-who span { display: block; font-size: 12px; color: #8a8072; margin: 2px 0 10px; word-break: break-all; }
      .ep-main {
        padding: 28px 32px 56px;
        min-width: 0;
        height: 100%;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
      }
      .ep-flash { padding: 10px 14px; border-radius: 12px; margin-bottom: 16px; font-size: 13px; }
      .ep-flash.notice { background: #ecf8f0; color: #14532d; border: 1px solid #bbf7d0; }
      .ep-flash.alert { background: #fff1f2; color: #9f1239; border: 1px solid #fecaca; }
      .ep-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
      .ep-eyebrow { color: var(--gold); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 6px; }
      .ep-hero h1, .ep-card h2, .ep-empty h2 {
        font-family: var(--serif); font-weight: 600; letter-spacing: -0.02em; color: var(--navy); margin: 0;
      }
      .ep-hero h1 { font-size: 2rem; }
      .ep-lead, .ep-hint { margin: 8px 0 0; color: var(--muted); max-width: 52ch; line-height: 1.5; }
      .ep-hint { font-size: 13px; }
      .ep-actions { display: flex; gap: 8px; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 700; cursor: pointer;
        font-size: 13px; font-family: inherit; text-decoration: none;
      }
      .btn-gold { background: linear-gradient(90deg, #e8d5a3, #c9a227); color: #0b1220; }
      .btn-ghost { background: #fffaf3; border: 1px solid var(--line); color: var(--navy); }
      .btn-danger { background: #7f1d1d; color: #fde8e8; }
      .btn-warn { background: #7c2d12; color: #ffedd5; }
      .ep-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 22px; }
      .ep-metric {
        background: #fffaf3; border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px;
      }
      .ep-metric span { display: block; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
      .ep-metric strong { display: block; margin-top: 6px; font-family: var(--serif); font-size: 1.7rem; font-weight: 600; color: var(--navy); font-variant-numeric: tabular-nums; }
      .ep-metric em { display: block; margin-top: 4px; font-style: normal; font-size: 12px; color: var(--muted); }
      .ep-metric.is-gold strong { color: var(--gold); }
      .ep-cal {
        display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; margin-top: 14px;
      }
      .ep-cal-dow {
        text-align: center; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--muted); font-weight: 700; padding: 4px 0;
      }
      .ep-cal-cell {
        min-height: 72px; border: 1px solid var(--line); border-radius: 12px; background: #fff;
        padding: 8px; display: flex; flex-direction: column; justify-content: space-between;
      }
      .ep-cal-cell.is-pad { border-color: transparent; background: transparent; }
      .ep-cal-cell.is-today { border-color: var(--gold); box-shadow: 0 0 0 1px rgba(201,162,39,0.35); }
      .ep-cal-cell.is-earn { background: linear-gradient(180deg, #fffaf3, #fff); }
      .ep-cal-cell span { font-size: 12px; color: var(--muted); font-weight: 700; }
      .ep-cal-cell strong { font-family: var(--serif); color: var(--gold); font-size: 0.95rem; font-weight: 600; }
      .ep-bar {
        height: 8px; border-radius: 999px; background: #f3eee6; overflow: hidden; margin-top: 8px;
      }
      .ep-bar i { display: block; height: 100%; background: linear-gradient(90deg, #e8d5a3, #c9a227); border-radius: 999px; }
      .ep-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 16px; }
      .ep-card {
        background: #fffaf3; border: 1px solid var(--line); border-radius: 18px;
        padding: 20px 22px; margin-bottom: 16px; box-shadow: 0 12px 28px rgba(20,17,15,0.04);
      }
      .ep-card h2 { font-size: 1.25rem; margin-bottom: 4px; }
      .ep-table-wrap { overflow: auto; margin-top: 12px; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
      table.ep-table { width: 100%; border-collapse: collapse; font-size: 14px; }
      .ep-table th {
        text-align: left; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--muted); padding: 10px 14px; border-bottom: 1px solid var(--line); background: #f7f1e8; font-weight: 700;
      }
      .ep-table td { padding: 12px 14px; border-bottom: 1px solid rgba(201,162,39,0.12); vertical-align: top; }
      .ep-table .col-serial { width: 2.75rem; min-width: 2.75rem; text-align: center; color: var(--muted); font-variant-numeric: tabular-nums; font-size: 12px; font-weight: 600; }
      .ep-table th.col-serial { font-size: 11px; }
      .index-serial-badge {
        position: absolute; top: 10px; right: 10px;
        font-size: 11px; font-weight: 700; font-variant-numeric: tabular-nums;
        color: var(--muted); letter-spacing: 0.04em;
      }
      .ep-table tr:last-child td { border-bottom: 0; }
      .ep-table strong { display: block; color: var(--navy); }
      .ep-sub { display: block; margin-top: 2px; font-size: 12px; color: var(--muted); }
      .ep-link { color: var(--navy); font-weight: 700; text-decoration: none; border-bottom: 1px solid rgba(201,162,39,0.45); }
      .pill { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
      .st-pending { background: #f7f1e8; color: #8a5a12; border: 1px solid rgba(201,162,39,0.4); }
      .st-active { background: #ecf8f0; color: #14532d; border: 1px solid #bbf7d0; }
      .st-rejected, .st-cancelled { background: #fff1f2; color: #9f1239; border: 1px solid #fecaca; }
      .st-suspended { background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; }
      .st-expired { background: #f3eee6; color: var(--muted); border: 1px solid var(--line); }
      .ep-tabs { display: inline-flex; flex-wrap: wrap; gap: 4px; margin-bottom: 16px; padding: 3px; border-radius: 999px; border: 1px solid rgba(201,162,39,0.4); background: #fff; }
      .ep-tabs a { display: inline-flex; padding: 7px 14px; border-radius: 999px; color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 700; }
      .ep-tabs a.is-on { background: linear-gradient(90deg, #e8d5a3, #c9a227); color: #0b1220; }
      .ep-empty { text-align: left; padding: 8px 0; }
      .ep-empty h2 { font-size: 1.35rem; margin-bottom: 6px; }
      label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0 0 6px; }
      input[type=text], input[type=email], input[type=number], input[type=password], select, textarea {
        width: 100%; background: #fff; border: 1px solid #e6dcc8; color: var(--ink);
        border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; font-family: inherit; font-size: 14px;
      }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,162,39,0.18); }
      textarea { min-height: 96px; resize: vertical; }
      .ep-check { display: flex; gap: 8px; align-items: center; color: var(--navy); text-transform: none; letter-spacing: 0; font-size: 14px; font-weight: 600; margin-bottom: 12px; }
      .ep-check input { width: auto; margin: 0; }
      .ep-split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .ep-facts { list-style: none; margin: 0; padding: 0; }
      .ep-facts li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px dashed var(--line); font-size: 14px; }
      .ep-facts li:last-child { border-bottom: 0; }
      .ep-facts span { color: var(--muted); }
      .ep-facts b { color: var(--navy); text-align: right; font-weight: 600; }
      .ep-narrow { max-width: 560px; }
      .ep-plan-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
      .ep-plan {
        background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px;
      }
      .ep-plan.is-featured { border-color: var(--gold); background: linear-gradient(180deg, #fffaf3, #fff); }
      .ep-plan .price { font-family: var(--serif); font-size: 1.6rem; color: var(--gold); margin: 8px 0 4px; font-weight: 600; }
      .ep-plan ul { margin: 12px 0 0; padding: 0; list-style: none; }
      .ep-plan li { font-size: 13px; color: var(--muted); padding: 4px 0; }
      .ep-plan li::before { content: "✦ "; color: var(--gold); }
      @media (max-width: 980px) {
        html, body, body.staff { height: auto; overflow: auto; }
        .ep-shell { grid-template-columns: 1fr; height: auto; overflow: visible; }
        .ep-side { height: auto; position: relative; flex-direction: row; flex-wrap: wrap; gap: 12px; }
        .ep-nav { display: flex; flex-wrap: wrap; gap: 4px; }
        .ep-foot { margin-top: 0; border: 0; padding: 0; width: 100%; }
        .ep-main { height: auto; overflow: visible; }
        .ep-metrics, .ep-grid, .ep-split { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body class="staff">
    <div class="ep-shell">
      <aside class="ep-side">
        <%= link_to staff_root_path, class: 'ep-brand' do %>
          <span class="ep-mark">S</span>
          <span>
            <strong>Strucxil</strong>
            <span>Licence desk</span>
          </span>
        <% end %>
        <nav class="ep-nav">
          <p class="ep-nav-label">Desk</p>
          <%= link_to staff_root_path, class: (controller_name == 'dashboard' ? 'is-on' : nil) do %>Overview<% end %>
          <%= link_to staff_earnings_path, class: (controller_name == 'earnings' ? 'is-on' : nil) do %>Earnings<% end %>
          <%= link_to staff_subscription_requests_path, class: (controller_name == 'subscription_requests' ? 'is-on' : nil) do %>
            Waiting
            <% if defined?(@pending_count) && @pending_count.to_i.positive? %><em><%= @pending_count %></em><% end %>
          <% end %>
          <p class="ep-nav-label">Houses</p>
          <%= link_to 'New accounts', staff_signups_path, class: (controller_name == 'signups' ? 'is-on' : nil) %>
          <%= link_to 'Years on the book', staff_subscriptions_path, class: (controller_name == 'subscriptions' && action_name != 'new' ? 'is-on' : nil) %>
          <%= link_to 'Grant a year', new_staff_subscription_path, class: (controller_name == 'subscriptions' && action_name == 'new' ? 'is-on' : nil) %>
          <p class="ep-nav-label">Catalogue</p>
          <%= link_to 'Plans', staff_plans_path, class: (controller_name == 'plans' ? 'is-on' : nil) %>
          <%= link_to 'Activity', staff_logs_path, class: (controller_name == 'logs' ? 'is-on' : nil) %>
        </nav>
        <div class="ep-foot">
          <div class="ep-who">
            <strong><%= current_employee.name %></strong>
            <span><%= current_employee.email %></span>
            <span>India Standard Time</span>
          </div>
          <%= button_to 'Sign out', destroy_employee_session_path, method: :delete, class: 'btn btn-ghost', style: 'width:100%;background:transparent;color:#e8d5a3;border-color:rgba(232,213,163,0.25)' %>
        </div>
      </aside>
      <section class="ep-main">
        <%= yield %>
      </section>
    </div>
    <%= render 'shared/toasts' %>
  </body>
</html>
