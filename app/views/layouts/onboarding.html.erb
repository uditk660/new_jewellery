<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : 'Choose your plan' %></title>
    <%= csrf_meta_tags %>
    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body.onboard {
        min-height: 100vh;
        background:
          radial-gradient(900px 400px at 0% 0%, rgba(212,175,55,0.2), transparent 50%),
          radial-gradient(800px 500px at 100% 100%, rgba(59,130,246,0.12), transparent 45%),
          #090e18;
        color: #e8eef7;
        font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
      }
      .topbar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 18px 28px; color: #cbd5e1;
      }
      .topbar a { color: #f4e2a8; text-decoration: none; font-weight: 600; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 8px 20px 64px; }
      .hero { text-align: center; margin: 12px 0 36px; }
      .hero h1 { font-size: 2.2rem; margin: 0 0 10px; letter-spacing: -0.03em; }
      .hero p { color: #94a3b8; margin: 0 auto; max-width: 560px; line-height: 1.5; }
      .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .plan {
        background: #111827; border: 1px solid rgba(255,255,255,0.06);
        border-radius: 18px; padding: 24px; display: flex; flex-direction: column;
        min-height: 460px; position: relative;
      }
      .plan.featured {
        background: linear-gradient(180deg, #1a2438, #111827);
        border-color: #c9a227; transform: translateY(-8px);
        box-shadow: 0 20px 50px rgba(201,162,39,0.18);
      }
      .badge {
        position: absolute; top: 14px; right: 14px;
        background: linear-gradient(90deg,#f4e2a8,#c9a227); color: #111;
        font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 999px;
      }
      .plan h2 { margin: 0 0 6px; font-size: 1.35rem; }
      .tagline { color: #c9a227; font-size: 13px; margin: 0 0 16px; }
      .price { font-size: 2rem; font-weight: 800; margin: 0; }
      .price span { font-size: 14px; font-weight: 500; color: #94a3b8; }
      .features { list-style: none; padding: 0; margin: 18px 0 22px; flex: 1; }
      .features li { padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); color: #cbd5e1; font-size: 14px; }
      .features li::before { content: '✦ '; color: #c9a227; }
      .btn-gold {
        width: 100%; border: 0; cursor: pointer; font-weight: 700; font-size: 15px;
        padding: 12px; border-radius: 10px;
        background: linear-gradient(90deg,#f4e2a8,#c9a227); color: #111;
      }
      .btn-gold:hover { filter: brightness(1.06); }
      .note { text-align: center; color: #64748b; margin-top: 28px; font-size: 13px; }
      .flash, .error-box, .notice-box {
        max-width: 720px; margin: 0 auto 18px; padding: 12px 14px; border-radius: 10px; font-size: 14px;
      }
      .error-box { background: rgba(220,38,38,0.15); border: 1px solid rgba(220,38,38,0.35); color: #fecaca; }
      .notice-box { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #a7f3d0; }
      .status-card {
        max-width: 560px; margin: 40px auto; background: #111827;
        border: 1px solid rgba(255,255,255,0.07); border-radius: 20px; padding: 36px; text-align: center;
      }
      .status-icon { font-size: 42px; margin-bottom: 12px; }
      .status-card h1 { margin: 0 0 8px; font-size: 1.7rem; }
      .muted { color: #94a3b8; }
      .meta { margin-top: 22px; text-align: left; background: #0b1220; border-radius: 12px; padding: 14px 16px; }
      .meta row, .meta .row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
      .pill { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
      .pill-pending { background: #422006; color: #fbbf24; }
      .pill-suspended { background: #3f1d1d; color: #fca5a5; }
      .pill-rejected { background: #3f1d1d; color: #fecaca; }
      .pill-cancelled { background: #1e293b; color: #cbd5e1; }
      @media (max-width: 900px) {
        .plans { grid-template-columns: 1fr; }
        .plan.featured { transform: none; }
      }
    </style>
  </head>
  <body class="onboard">
    <div class="topbar">
      <strong>💎 Jewellery OS</strong>
      <div>
        <% if user_signed_in? %>
          <span style="margin-right:14px;color:#94a3b8"><%= current_user.email %></span>
          <%= button_to 'Sign out', destroy_user_session_path, method: :delete, form: { style: 'display:inline' }, style: 'background:none;border:0;color:#f4e2a8;font-weight:600;cursor:pointer' %>
        <% end %>
      </div>
    </div>
    <div class="wrap">
      <% if flash[:alert] %><div class="error-box"><%= flash[:alert] %></div><% end %>
      <% if flash[:notice] %><div class="notice-box"><%= flash[:notice] %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
